<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <EnableContainer>true</EnableContainer>
    <ContainerRepository>hexalith-chatbot-ui</ContainerRepository>
    <HexalithContainerServiceName>ui</HexalithContainerServiceName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Hexalith.ChatBot.UI.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Surface adapter: depends only on the typed Client facade, FrontComposer Shell and shared telemetry defaults. -->
    <ProjectReference Include="..\Hexalith.ChatBot.Client\Hexalith.ChatBot.Client.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseHexalithProjectReferences)' == 'true'">
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.ServiceDefaults\Hexalith.EventStore.ServiceDefaults.csproj" />
    <ProjectReference Include="$(HexalithFrontComposerRoot)\src\Hexalith.FrontComposer.Shell\Hexalith.FrontComposer.Shell.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
    <PackageReference Include="Fluxor.Blazor.Web" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
    <!-- FrontComposer Shell compiles its OIDC path against the centrally pinned IdentityModel surface.
         A consuming app otherwise receives only the older transitive suite carried by
         Microsoft.AspNetCore.Authentication.OpenIdConnect, which compiles successfully but fails on the
         first authenticated request when the CLR resolves the newer IdentityModel assemblies. Pinning the
         protocol package brings its mutually versioned token/JWT dependencies with it. -->
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseHexalithProjectReferences)' != 'true'">
    <PackageReference Include="Hexalith.EventStore.ServiceDefaults" />
    <PackageReference Include="Hexalith.FrontComposer.Shell" />
  </ItemGroup>
</Project>
