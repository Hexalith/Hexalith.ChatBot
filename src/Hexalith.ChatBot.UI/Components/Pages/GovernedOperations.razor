@page "/governed-operations"
@using Hexalith.ChatBot.Client
@using Hexalith.ChatBot.Client.Generated
@namespace Hexalith.ChatBot.UI.Components.Pages
@inherits FluxorComponent
@inject IState<GovernedOperationsState> State
@inject IDispatcher Dispatcher
@inject IChatBotClient ChatBotClient
@inject NavigationManager Navigation
@inject ChatBotUiTextLocalizer UiText

<ChatBotConversationShell ShellLabel="@UiText[ChatBotUiTextKey.GovernedOperationsTitle]"
                          MainLabel="@UiText[ChatBotUiTextKey.GovernedCommandPath]"
                          ComplementaryLabel="@UiText[ChatBotUiTextKey.GovernedOperationReviewContext]">
    <ProjectContext>
        <ChatBotProjectContextHeader ProjectName="@UiText[ChatBotUiTextKey.GovernedOperationsTitle]"
                                     ProjectId="m0-governed-command"
                                     ConversationLabel="@UiText[ChatBotUiTextKey.CurrentSurface]"
                                     ConversationState="@UiText[ChatBotUiTextKey.OperationalCommandSubmission]"
                                     StatusKind="@ChatBotFeedbackKind.Info"
                                     StatusText="@UiText[ChatBotUiTextKey.UiOriginVisible]"
                                     StatusStableId="governed-operations-context" />
    </ProjectContext>
    <MainContent>
        <FcPageLayout Mode="FcPageLayoutMode.FullWidth">
        <FluentStack Orientation="Orientation.Vertical" aria-labelledby="governed-operations-title" data-chatbot-responsive-fixture="governed-operations">
            <FcPageHeader PageTitle="@UiText[ChatBotUiTextKey.PageTitleGovernedOperations]"
                          Eyebrow="@UiText[ChatBotUiTextKey.GovernedCommand]"
                          Heading="@UiText[ChatBotUiTextKey.GovernedOperationsTitle]"
                          HeadingId="governed-operations-title"
                          Description="@GovernedOperationsDescription">
                <Actions>
                    <ChatBotGovernedAction Label="@UiText[ChatBotUiTextKey.RecordGovernedNote]"
                                            AccessibleLabel="@UiText[ChatBotUiTextKey.RecordGovernedNote]"
                                            StableId="record-governed-note"
                                            State="@(State.Value.IsSubmitting ? ChatBotGovernedActionState.DisabledWithReason : ChatBotGovernedActionState.Enabled)"
                                            DisabledReason="@UiText[ChatBotUiTextKey.DisabledReasonAlreadySubmitting]"
                                            OnActivate="@Submit" />
                </Actions>
            </FcPageHeader>

            @* Transient submission-status banners are not titled sections, so they stay OUTSIDE the accordion,
               next to the Record-note action that produces them. *@
            @if (State.Value.IsSubmitting)
            {
                <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Info"
                                     Message="@UiText[ChatBotUiTextKey.SubmissionSubmitting]"
                                     AccessibleLabel="@UiText[ChatBotUiTextKey.SubmissionSubmittingAccessible]"
                                     StableId="governed-note-submitting"
                                     StateFamily="@ChatBotFeedbackStateFamily.CurrentUserCommandAcceptedProjectionPending"
                                     AnnouncementKey="governed-note-submitting" />
            }

            @if (State.Value.Error is { } error)
            {
                <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Danger"
                                     Message="@UiText[ChatBotUiTextKey.SubmissionFailed]"
                                     MessageCatalogCode="@error"
                                     AccessibleLabel="@UiText[ChatBotUiTextKey.SubmissionFailedAccessible]"
                                     StableId="governed-note-failed"
                                     StateFamily="@ChatBotFeedbackStateFamily.RetryableFailure"
                                     AnnouncementActivation="@State.Value.SubmissionActivation" />
            }

            @* UX "Page sections" rule (Story 13.7): the sibling titled MainContent regions group in one
               FluentAccordion, one FluentAccordionItem per section, every item expanded by default. The
               <section> landmarks are kept (the accordion item Header is now the heading); the inner duplicate
               <h2 class="chatbot-section-title"> headings are removed and the accessible name moves to aria-label. *@
            <FluentAccordion ExpandMode="AccordionExpandMode.Multi" Block="true">
                <FluentAccordionItem Header="@UiText[ChatBotUiTextKey.GovernedOperationsOperationalQueueTitle]" HeadingLevel="2" Expanded="true">
                    <section class="chatbot-section"
                             aria-label="@UiText[ChatBotUiTextKey.GovernedOperationsOperationalQueueTitle]"
                             data-chatbot-operational-queue="true" aria-busy="@(QueueLoading ? "true" : "false")">
                        <FluentStack Orientation="Orientation.Horizontal" Wrap="true" VerticalAlignment="VerticalAlignment.Bottom">
                            <FluentTextInput Label="@UiText[ChatBotUiTextKey.ReviewQueueProject]" @bind-Value="_projectInput" />
                            <FluentButton OnClick="@SelectProject">@UiText[ChatBotUiTextKey.ReviewQueueOpenProject]</FluentButton>
                            @if (ProjectId is not null)
                            {
                                <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@ClearProject">@UiText[ChatBotUiTextKey.ReviewQueueTenantSummary]</FluentButton>
                            }
                        </FluentStack>
                        <FluentStack Orientation="Orientation.Horizontal" Wrap="true" role="group" aria-label="@UiText[ChatBotUiTextKey.GovernedOperationsQueueFamilyLabel]">
                            @foreach (OperationalQueueFamily family in OperationalQueueFamilies.All)
                            {
                                string familyToken = OperationalQueueFamilies.ToWireValue(family);
                                <FluentButton Appearance="@(family == _queueFamily ? ButtonAppearance.Primary : ButtonAppearance.Outline)"
                                              aria-pressed="@(family == _queueFamily ? "true" : "false")"
                                              aria-label="@($"{UiText[ChatBotUiTextKey.GovernedOperationsQueueFamilyLabel]}: {familyToken}")"
                                              OnClick="@(() => SelectFamilyAsync(family))">
                                    <code class="chatbot-code">@familyToken</code>
                                </FluentButton>
                            }
                        </FluentStack>

                        @if (QueueLoading || QueueFailed)
                        {
                            string statusKey = QueueFailed ? ChatBotUiTextKey.ReviewQueueLoadFailed : ChatBotUiTextKey.ReviewQueueLoading;
                            <ChatBotStatusBanner Kind="@(QueueFailed ? ChatBotFeedbackKind.Warning : ChatBotFeedbackKind.Info)"
                                                 StableId="operational-queue-status" Message="@UiText[statusKey]"
                                                 AccessibleLabel="@UiText[statusKey]" />
                            @if (QueueFailed)
                            {
                                <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@ReloadQueueAsync">@UiText[ChatBotUiTextKey.ReviewQueueRetry]</FluentButton>
                            }
                        }
                        else if (_tenantSummary is { } summary)
                        {
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem">
                                @ChatBotMetadataRendering.CodeRow(UiText[ChatBotUiTextKey.GovernedOperationsQueueFiltersLabel], OperationalQueueFamilies.ToWireValue(_queueFamily))
                                @ChatBotMetadataRendering.CodeRow(UiText[ChatBotUiTextKey.ReviewQueueDisclosure], summary.DisclosureState)
                                @ChatBotMetadataRendering.CodeRow(UiText[ChatBotUiTextKey.ReviewQueueCoverage], summary.Coverage.Reason)
                            </FluentStack>
                            <div role="list" aria-label="@UiText[ChatBotUiTextKey.ReviewQueueTenantSummary]">
                                @foreach (QueueSummaryBucket bucket in summary.Buckets)
                                {
                                    <FluentStack role="listitem" Wrap="true" Class="chatbot-labelled-row-list">
                                        @ChatBotMetadataRendering.CodeRow(UiText[ChatBotUiTextKey.LifecycleStateLabel], bucket.Status)
                                        @ChatBotMetadataRendering.CodeRow(UiText[ChatBotUiTextKey.OperationOwnerRoleLabel], bucket.OwnerClass)
                                        @ChatBotMetadataRendering.TextRow(UiText[ChatBotUiTextKey.GovernedOperationsQueueResultCountLabel], FormatCount(bucket.Count))
                                    </FluentStack>
                                }
                            </div>
                        }
                        else if ((IsProjectApprovalQueue ? _approvalQueue : _projectQueue) is { } projectQueue)
                        {
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem">
                                @ChatBotMetadataRendering.CodeRow(UiText[ChatBotUiTextKey.GovernedOperationsQueueFiltersLabel], OperationalQueueFamilies.ToWireValue(_queueFamily))
                                @ChatBotMetadataRendering.CodeRow(UiText[ChatBotUiTextKey.ReviewQueueProject], ProjectId!)
                                @ChatBotMetadataRendering.TextRow(UiText[ChatBotUiTextKey.GovernedOperationsQueueResultCountLabel], FormatCount(projectQueue.Rows.Count))
                                @ChatBotMetadataRendering.CodeRow(UiText[ChatBotUiTextKey.ReviewQueueCoverage], projectQueue.Coverage.Reason)
                            </FluentStack>
                            <div role="list" aria-label="@UiText[ChatBotUiTextKey.GovernedOperationsOperationalQueueTitle]">
                                @foreach (ReviewQueueRow row in projectQueue.Rows)
                                {
                                    <article class="chatbot-labelled-row-list" role="listitem"
                                             data-chatbot-queue-family="@OperationalQueueFamilies.ToWireValue(_queueFamily)"
                                             data-chatbot-queue-ref="@row.QueueRef" data-chatbot-item-ref="@row.ItemRef"
                                             data-chatbot-source-version="@row.SourceVersion">
                                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem">
                                            @ChatBotMetadataRendering.CodeRow(UiText[ChatBotUiTextKey.ReviewQueueItem], row.ItemRef)
                                            @ChatBotMetadataRendering.CodeRow(UiText[ChatBotUiTextKey.LifecycleStateLabel], row.State)
                                            @ChatBotMetadataRendering.CodeRow(UiText[ChatBotUiTextKey.GovernedOperationsQueueRiskLabel], row.Risk)
                                            @ChatBotMetadataRendering.CodeRow(UiText[ChatBotUiTextKey.OperationOwnerRoleLabel], row.OwnerRole)
                                            @ChatBotMetadataRendering.TextRow(UiText[ChatBotUiTextKey.RetryCountLabel], FormatCount(row.RetryCount))
                                            @ChatBotMetadataRendering.CodeRow(UiText[ChatBotUiTextKey.SafeNextActionsLabel], row.NextAction)
                                        </FluentStack>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                </FluentAccordionItem>

                <FluentAccordionItem Header="@UiText[ChatBotUiTextKey.ApprovalQueuePriorityTitle]" HeadingLevel="2" Expanded="true">
                    @if (ProjectId is null || _approvalLoading || _approvalFailed)
                    {
                        <ChatBotStatusBanner Kind="@(_approvalFailed ? ChatBotFeedbackKind.Warning : ChatBotFeedbackKind.Info)"
                                             StableId="approval-queue-status" Message="@UiText[ApprovalStatusKey]"
                                             AccessibleLabel="@UiText[ApprovalStatusKey]" />
                        @if (_approvalFailed && !IsProjectApprovalQueue)
                        {
                            <FluentButton Appearance="ButtonAppearance.Outline" OnClick="@(() => LoadApprovalsAsync(ProjectId))">@UiText[ChatBotUiTextKey.ReviewQueueRetry]</FluentButton>
                        }
                    }
                    else if (_approvalQueue is { } approvalQueue)
                    {
                        <ChatBotApprovalQueuePriorityView ShowHeading="false" Groups="@ApprovalGroups(approvalQueue.Rows)" Coverage="@approvalQueue.Coverage.Reason" />
                    }
                </FluentAccordionItem>

                @if (State.Value.Outcome is { } outcome)
                {
                    @* operation-outcome-title is preserved as the focus-landing target id (asserted by
                       ChatBotAccessibilityFocusContractTests); it now lives on the kept <section> element. *@
                    <FluentAccordionItem Header="@UiText[ChatBotUiTextKey.OutcomeTitle]" HeadingLevel="2" Expanded="true">
                        @* tabindex="-1": ChatBotAccessibilityFocusContractTests declares this the loaded-content
                           landing target, and .focus() on a bare <section> is a no-op in every major browser. *@
                        <section id="operation-outcome-title" class="chatbot-section" tabindex="-1" aria-label="@UiText[ChatBotUiTextKey.OutcomeTitle]">
                    <div class="chatbot-status-group" aria-label="@UiText[ChatBotUiTextKey.OperationStatusSummary]">
                        @if (IsProjectionPending(outcome))
                        {
                            <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Warning"
                                                 Message="@UiText[ChatBotUiTextKey.ProjectionPending]"
                                                 AccessibleLabel="@UiText[ChatBotUiTextKey.ProjectionPendingAccessible]"
                                                 StableId="projection-pending"
                                                 StateFamily="@ChatBotFeedbackStateFamily.CurrentUserCommandAcceptedProjectionPending"
                                                 AnnouncementKey="@outcome.OperationId">
                                @UiText[ChatBotUiTextKey.ProjectionPending] (<code class="chatbot-code">@outcome.CompletionStatus</code>).
                            </ChatBotStatusBanner>
                        }
                        else if (IsProjectionFailed(outcome))
                        {
                            @* A failed completion previously fell through to the success branch and rendered a
                               green "Projection complete" banner. *@
                            <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Danger"
                                                 Message="@UiText[ChatBotUiTextKey.SubmissionFailed]"
                                                 AccessibleLabel="@UiText[ChatBotUiTextKey.SubmissionFailedAccessible]"
                                                 StableId="projection-failed"
                                                 StateFamily="@ChatBotFeedbackStateFamily.RetryableFailure"
                                                 AnnouncementKey="@outcome.OperationId">
                                @UiText[ChatBotUiTextKey.SubmissionFailed] (<code class="chatbot-code">@outcome.CompletionStatus</code>).
                            </ChatBotStatusBanner>
                        }
                        else
                        {
                            <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Success"
                                                 Message="@UiText[ChatBotUiTextKey.ProjectionComplete]"
                                                 AccessibleLabel="@UiText[ChatBotUiTextKey.ProjectionCompleteAccessible]"
                                                 StableId="projection-complete"
                                                 StateFamily="@ChatBotFeedbackStateFamily.CurrentUserCommandAcceptedProjectionPending"
                                                 AnnouncementKey="@outcome.OperationId">
                                @UiText[ChatBotUiTextKey.ProjectionComplete] (<code class="chatbot-code">@outcome.CompletionStatus</code>).
                            </ChatBotStatusBanner>
                        }

                        @if (IsAuditCommitted(outcome))
                        {
                            <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Success"
                                                 Message="@UiText[ChatBotUiTextKey.AuditStatusCommitted]"
                                                 AccessibleLabel="@UiText[ChatBotUiTextKey.AuditStatusCommittedAccessible]"
                                                 StableId="audit-committed"
                                                 StateFamily="@ChatBotFeedbackStateFamily.CurrentUserCommandAcceptedProjectionPending"
                                                 AnnouncementKey="@($"{outcome.OperationId}-audit")">
                                @UiText[ChatBotUiTextKey.AuditStatusCommitted] (<code class="chatbot-code">@outcome.AuditStatus</code>).
                            </ChatBotStatusBanner>
                        }
                        else
                        {
                            @* Previously nothing rendered when the audit was not committed: no banner, no
                               explanation, no next action on a surface whose purpose is freshness-honest status. *@
                            <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Warning"
                                                 Message="@UiText[ChatBotUiTextKey.AuditStatusLabel]"
                                                 AccessibleLabel="@UiText[ChatBotUiTextKey.AuditStatusLabel]"
                                                 StableId="audit-not-committed"
                                                 StateFamily="@ChatBotFeedbackStateFamily.CurrentUserCommandAcceptedProjectionPending"
                                                 AnnouncementKey="@($"{outcome.OperationId}-audit-{outcome.AuditStatus}")">
                                @UiText[ChatBotUiTextKey.AuditStatusLabel] (<code class="chatbot-code">@outcome.AuditStatus</code>).
                            </ChatBotStatusBanner>
                        }

                        <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Info"
                                             Message="@UiText[ChatBotUiTextKey.AuditHistoryMetadataOnly]"
                                             AccessibleLabel="@UiText[ChatBotUiTextKey.AuditHistoryMetadataOnly]"
                                             StableId="audit-history-metadata-only"
                                             StateFamily="@ChatBotFeedbackStateFamily.ObservedForOthersRejectionOrQueueUpdate"
                                             AnnouncementKey="audit-history-metadata-only" />
                    </div>

                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem">
                        @ChatBotMetadataRendering.CodeRow(UiText[ChatBotUiTextKey.OperationLabel], outcome.OperationId)
                        @ChatBotMetadataRendering.CodeRow(UiText[ChatBotUiTextKey.OperationClassLabel], outcome.OperationClass)
                        @ChatBotMetadataRendering.CodeRow(UiText[ChatBotUiTextKey.CommandLabel], outcome.CommandId)
                        @ChatBotMetadataRendering.CodeRow(UiText[ChatBotUiTextKey.LifecycleStateLabel], outcome.LifecycleState)
                        @ChatBotMetadataRendering.CodeRow(UiText[ChatBotUiTextKey.CompletionStatusLabel], outcome.CompletionStatus)
                        @ChatBotMetadataRendering.CodeRow(UiText[ChatBotUiTextKey.AuditStatusLabel], outcome.AuditStatus)
                        @ChatBotMetadataRendering.CodeRowIf(UiText[ChatBotUiTextKey.SafeNextActionsLabel], outcome.SafeNextActions.Count == 0 ? null : string.Join(", ", outcome.SafeNextActions))
                        @ChatBotMetadataRendering.TextRow(UiText[ChatBotUiTextKey.RetryCountLabel], outcome.RetryCount.ToString(System.Globalization.CultureInfo.CurrentCulture))
                        @ChatBotMetadataRendering.CodeRowIf(UiText[ChatBotUiTextKey.OperationOwnerRoleLabel], outcome.OwnerRole)
                        @ChatBotMetadataRendering.TextRowIf(UiText[ChatBotUiTextKey.DuplicateSafetyNoteLabel], outcome.DuplicateSafetyNote)
                    </FluentStack>

                    @* h3, not h2: the enclosing FluentAccordionItem already produced the section's h2. *@
                    <h3 class="chatbot-section-title">@UiText[ChatBotUiTextKey.AuditHistoryTitle]</h3>
                    <ChatBotOperationAuditHistory History="@outcome.AuditHistory" />
                        </section>
                    </FluentAccordionItem>
                }
            </FluentAccordion>
        </FluentStack>
        </FcPageLayout>
    </MainContent>
    <ComplementaryPanel>
        <section class="chatbot-section" aria-labelledby="governed-review-context-title">
            <h2 id="governed-review-context-title" class="chatbot-section-title">@UiText[ChatBotUiTextKey.GovernedOperationReviewContext]</h2>
            <p class="chatbot-body">
                @UiText[ChatBotUiTextKey.ReviewContextDescription]
            </p>
        </section>
    </ComplementaryPanel>
</ChatBotConversationShell>

@code {
    /// <summary>Gets or sets the project selected for authorized queue detail.</summary>
    [SupplyParameterFromQuery]
    public string? ProjectId { get; set; }

    private OperationalQueueFamily _queueFamily = OperationalQueueFamily.AmbiguousAssociation;
    private TenantReviewQueueSummary? _tenantSummary;
    private ProjectReviewQueue? _projectQueue;
    private ProjectReviewQueue? _approvalQueue;
    private string? _projectInput;
    private string? _loadedProject;
    private bool _scopeLoaded;
    private bool _queueLoading;
    private bool _queueFailed;
    private bool _approvalLoading;
    private bool _approvalFailed;
    private long _queueRequest;
    private long _approvalRequest;

    private bool IsProjectApprovalQueue => ProjectId is not null && _queueFamily == OperationalQueueFamily.PendingApproval;

    private bool QueueLoading => IsProjectApprovalQueue ? _approvalLoading : _queueLoading;

    private bool QueueFailed => IsProjectApprovalQueue ? _approvalFailed : _queueFailed;

    private string ApprovalStatusKey => ProjectId is null ? ChatBotUiTextKey.ReviewQueueSelectProject
        : _approvalFailed ? ChatBotUiTextKey.ReviewQueueLoadFailed : ChatBotUiTextKey.ReviewQueueLoading;

    /// <inheritdoc />
    protected override Task OnParametersSetAsync()
    {
        string? project = string.IsNullOrWhiteSpace(ProjectId) ? null : ProjectId.Trim();
        ProjectId = project;
        if (_scopeLoaded && string.Equals(_loadedProject, project, StringComparison.Ordinal))
        {
            return Task.CompletedTask;
        }

        _scopeLoaded = true;
        _loadedProject = project;
        _projectInput = project;
        _queueRequest++;
        _tenantSummary = null;
        _projectQueue = null;
        return IsProjectApprovalQueue
            ? LoadApprovalsAsync(project)
            : Task.WhenAll(LoadQueueAsync(project, _queueFamily), LoadApprovalsAsync(project));
    }

    private void SelectProject()
    {
        if (!string.IsNullOrWhiteSpace(_projectInput))
        {
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("projectId", _projectInput.Trim()));
        }
    }

    private void ClearProject() => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("projectId", (string?)null));

    private Task SelectFamilyAsync(OperationalQueueFamily family)
    {
        _queueFamily = family;
        return IsProjectApprovalQueue ? Task.CompletedTask : LoadQueueAsync(ProjectId, family);
    }

    private Task ReloadQueueAsync() => IsProjectApprovalQueue
        ? LoadApprovalsAsync(ProjectId) : LoadQueueAsync(ProjectId, _queueFamily);

    private async Task LoadQueueAsync(string? projectId, OperationalQueueFamily family)
    {
        long request = ++_queueRequest;
        _tenantSummary = null;
        _projectQueue = null;
        _queueLoading = true;
        _queueFailed = false;
        ReviewQueueFamily wireFamily = Enum.Parse<ReviewQueueFamily>(family.ToString());
        try
        {
            if (projectId is null)
            {
                TenantReviewQueueSummary summary = await ChatBotClient.GetTenantReviewQueueSummaryAsync(wireFamily);
                if (request == _queueRequest)
                {
                    _tenantSummary = summary;
                }
            }
            else
            {
                ProjectReviewQueue queue = await ChatBotClient.GetProjectReviewQueueAsync(projectId, wireFamily);
                if (request == _queueRequest)
                {
                    _projectQueue = queue;
                }
            }
        }
        catch (Exception ex) when (IsQueueReadFailure(ex))
        {
            if (request == _queueRequest)
            {
                _queueFailed = true;
            }
        }
        finally
        {
            if (request == _queueRequest)
            {
                _queueLoading = false;
            }
        }
    }

    private async Task LoadApprovalsAsync(string? projectId)
    {
        long request = ++_approvalRequest;
        _approvalQueue = null;
        _approvalFailed = false;
        _approvalLoading = projectId is not null;
        if (projectId is null)
        {
            return;
        }

        try
        {
            ProjectReviewQueue queue = await ChatBotClient.GetProjectReviewQueueAsync(projectId, ReviewQueueFamily.PendingApproval);
            if (request == _approvalRequest)
            {
                _approvalQueue = queue;
            }
        }
        catch (Exception ex) when (IsQueueReadFailure(ex))
        {
            if (request == _approvalRequest)
            {
                _approvalFailed = true;
            }
        }
        finally
        {
            if (request == _approvalRequest)
            {
                _approvalLoading = false;
            }
        }
    }

    private static bool IsQueueReadFailure(Exception exception)
        => exception is HexalithChatBotApiException or HttpRequestException or OperationCanceledException or ArgumentException or NotSupportedException;

    private static string FormatCount(int count) => count.ToString(System.Globalization.CultureInfo.CurrentCulture);

    private static IReadOnlyList<ChatBotApprovalPriorityGroupRow> ApprovalGroups(IEnumerable<ReviewQueueRow> rows)
        => rows.GroupBy(static row => row.GroupKey ?? row.ItemRef, StringComparer.Ordinal)
            .Select(static group => (GroupKey: group.Key, Count: group.Count(),
                First: group.OrderByDescending(static row => row.PriorityScore).ThenBy(static row => row.ItemRef, StringComparer.Ordinal).First()))
            .OrderByDescending(static group => group.First.PriorityScore)
            .ThenBy(static group => group.GroupKey, StringComparer.Ordinal)
            .Select(static group => new ChatBotApprovalPriorityGroupRow(
                group.GroupKey, group.First.GroupRequesterRef ?? string.Empty, group.First.GroupCommandRef ?? string.Empty,
                group.First.GroupProjectRef ?? string.Empty, FormatPriority(group.First), group.First.PriorityExplanation,
                group.Count))
            .ToArray();

    private static string FormatPriority(ReviewQueueRow row)
        => row.PriorityScore.ToString("0.##", System.Globalization.CultureInfo.CurrentCulture);

    // The route description folds the intro + the surface-origin literal ("ui") + the suffix into a single plain
    // string for FcPageHeader.Description (a plain string rendered in one FluentText). The original interleaved
    // <code>ui</code> monospace styling is cosmetic and is intentionally dropped here per the Story 13.2 mapping.
    private string GovernedOperationsDescription
        => $"{UiText[ChatBotUiTextKey.GovernedOperationsIntro]} ui {UiText[ChatBotUiTextKey.GovernedOperationsIntroSuffix]}";

    private void Submit()
    {
        // Guard the dispatch site: the reducer sets IsSubmitting before the effect runs, so the effect itself
        // cannot tell a first submit from a duplicate.
        if (State.Value.IsSubmitting)
        {
            return;
        }

        Dispatcher.Dispatch(new SubmitGovernedNoteAction());
    }

    private static bool IsProjectionPending(OperationOutcome outcome)
        => outcome.CompletionStatus.Contains("Pending", StringComparison.OrdinalIgnoreCase);

    // Explicit failure classification. Without it every non-pending status — Failed included — fell through to
    // the success branch.
    private static bool IsProjectionFailed(OperationOutcome outcome)
        => outcome.CompletionStatus.Contains("Failed", StringComparison.OrdinalIgnoreCase) ||
            outcome.CompletionStatus.Contains("Faulted", StringComparison.OrdinalIgnoreCase) ||
            outcome.CompletionStatus.Contains("Rejected", StringComparison.OrdinalIgnoreCase);

    private static bool IsAuditCommitted(OperationOutcome outcome)
        => outcome.AuditStatus.Contains("Committed", StringComparison.OrdinalIgnoreCase) &&
            !outcome.AuditStatus.Contains("NotCommitted", StringComparison.OrdinalIgnoreCase);

}
