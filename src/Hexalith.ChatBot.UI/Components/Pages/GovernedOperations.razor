@page "/governed-operations"
@namespace Hexalith.ChatBot.UI.Components.Pages
@inherits FluxorComponent
@inject IState<GovernedOperationsState> State
@inject IDispatcher Dispatcher
@inject ChatBotUiTextLocalizer UiText

<ChatBotConversationShell ShellLabel="@UiText[ChatBotUiTextKey.GovernedOperationsTitle]"
                          MainLabel="@UiText[ChatBotUiTextKey.GovernedCommandPath]"
                          ComplementaryLabel="@UiText[ChatBotUiTextKey.GovernedOperationReviewContext]">
    <ProjectContext>
        <ChatBotProjectContextHeader ProjectName="@UiText[ChatBotUiTextKey.GovernedOperationsTitle]"
                                     ProjectId="m0-governed-command"
                                     ConversationLabel="@UiText[ChatBotUiTextKey.CurrentSurface]"
                                     ConversationState="@UiText[ChatBotUiTextKey.OperationalCommandSubmission]"
                                     StatusKind="@ChatBotFeedbackKind.Info"
                                     StatusText="@UiText[ChatBotUiTextKey.UiOriginVisible]"
                                     StatusStableId="governed-operations-context" />
    </ProjectContext>
    <MainContent>
        <FcPageLayout Mode="FcPageLayoutMode.FullWidth">
        <section class="chatbot-page" aria-labelledby="governed-operations-title" data-chatbot-responsive-fixture="governed-operations">
            <FcPageHeader PageTitle="@UiText[ChatBotUiTextKey.PageTitleGovernedOperations]"
                          Eyebrow="@UiText[ChatBotUiTextKey.GovernedCommand]"
                          Heading="@UiText[ChatBotUiTextKey.GovernedOperationsTitle]"
                          HeadingId="governed-operations-title"
                          Description="@GovernedOperationsDescription">
                <Actions>
                    <ChatBotGovernedAction Label="@UiText[ChatBotUiTextKey.RecordGovernedNote]"
                                            AccessibleLabel="@UiText[ChatBotUiTextKey.RecordGovernedNote]"
                                            StableId="record-governed-note"
                                            State="@(State.Value.IsSubmitting ? ChatBotGovernedActionState.DisabledWithReason : ChatBotGovernedActionState.Enabled)"
                                            DisabledReason="@UiText[ChatBotUiTextKey.DisabledReasonAlreadySubmitting]"
                                            OnActivate="@Submit" />
                </Actions>
            </FcPageHeader>

            @* Transient submission-status banners are not titled sections, so they stay OUTSIDE the accordion,
               next to the Record-note action that produces them. *@
            @if (State.Value.IsSubmitting)
            {
                <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Info"
                                     Message="@UiText[ChatBotUiTextKey.SubmissionSubmitting]"
                                     AccessibleLabel="@UiText[ChatBotUiTextKey.SubmissionSubmittingAccessible]"
                                     StableId="governed-note-submitting"
                                     StateFamily="@ChatBotFeedbackStateFamily.CurrentUserCommandAcceptedProjectionPending"
                                     AnnouncementKey="governed-note-submitting" />
            }

            @if (State.Value.Error is { } error)
            {
                <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Danger"
                                     Message="@UiText[ChatBotUiTextKey.SubmissionFailed]"
                                     AccessibleLabel="@UiText[ChatBotUiTextKey.SubmissionFailedAccessible]"
                                     StableId="governed-note-failed"
                                     StateFamily="@ChatBotFeedbackStateFamily.RetryableFailure"
                                     AnnouncementKey="@($"governed-note-failed-{error}")">
                    @UiText.Get(ChatBotUiTextKey.SubmissionFailedBodyTemplate, error)
                </ChatBotStatusBanner>
            }

            @* UX "Page sections" rule (Story 13.7): the sibling titled MainContent regions group in one
               FluentAccordion, one FluentAccordionItem per section, every item expanded by default. The
               <section> landmarks are kept (the accordion item Header is now the heading); the inner duplicate
               <h2 class="chatbot-section-title"> headings are removed and the accessible name moves to aria-label. *@
            <FluentAccordion ExpandMode="AccordionExpandMode.Multi" Block="true">
                <FluentAccordionItem Header="@UiText[ChatBotUiTextKey.GovernedOperationsOperationalQueueTitle]" HeadingLevel="2" Expanded="true">
                    <section class="chatbot-section"
                             aria-label="@UiText[ChatBotUiTextKey.GovernedOperationsOperationalQueueTitle]"
                             data-chatbot-operational-queue="true"
                             data-chatbot-loading-mode="@QueueLoadingMode">

                <FluentStack Orientation="Orientation.Horizontal" Wrap="true" role="group" aria-label="@UiText[ChatBotUiTextKey.GovernedOperationsQueueFamilyLabel]">
                    @foreach (OperationalQueueFamily family in QueueFamilies)
                    {
                        string familyToken = OperationalQueueFamilies.ToWireValue(family);
                        <FluentButton Appearance="@(family == SelectedQueueFamily ? ButtonAppearance.Primary : ButtonAppearance.Outline)"
                                      aria-pressed="@(family == SelectedQueueFamily)"
                                      OnClick="@(() => SelectedQueueFamily = family)">
                            @familyToken
                        </FluentButton>
                    }
                </FluentStack>

                <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem" aria-label="@UiText[ChatBotUiTextKey.GovernedOperationsQueueFiltersLabel]">
                    @CodeRow(UiText[ChatBotUiTextKey.GovernedOperationsQueueFiltersLabel], "age>0 risk:any confidence:any mailbox:any state:non-terminal next-action:claim")
                    @CodeRow(UiText[ChatBotUiTextKey.GovernedOperationsQueueSortLabel], "priority desc, item-ref asc, source-version asc")
                    @TextRow(UiText[ChatBotUiTextKey.GovernedOperationsQueueResultCountLabel], VisibleQueueRows.Length.ToString(System.Globalization.CultureInfo.InvariantCulture))
                    @CodeRow(UiText[ChatBotUiTextKey.GovernedOperationsQueuePaginationLabel], "page-size:100")
                </FluentStack>

                <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Info"
                                     Message="@UiText[ChatBotUiTextKey.GovernedOperationsQueuePhoneSummary]"
                                     AccessibleLabel="@UiText[ChatBotUiTextKey.GovernedOperationsQueuePhoneSummary]"
                                     StableId="operational-queue-phone-summary"
                                     StateFamily="@ChatBotFeedbackStateFamily.ObservedForOthersRejectionOrQueueUpdate"
                                     AnnouncementKey="operational-queue-phone-summary" />

                <div class="chatbot-table" role="table" aria-label="@UiText[ChatBotUiTextKey.GovernedOperationsOperationalQueueTitle]">
                    @foreach (OperationalQueueFixtureRow row in VisibleQueueRows)
                    {
                        <article class="chatbot-labelled-row-list"
                                 role="row"
                                 tabindex="0"
                                 data-chatbot-queue-family="@row.FamilyToken"
                                 data-chatbot-queue-ref="@row.QueueRef"
                                 data-chatbot-item-ref="@row.ItemRef"
                                 data-chatbot-source-version="@row.SourceVersion">
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem">
                                @CodeRow(UiText[ChatBotUiTextKey.GovernedOperationsQueueFamilyLabel], row.FamilyToken)
                                @CodeRow(UiText[ChatBotUiTextKey.LifecycleStateLabel], row.State)
                                @CodeRow(UiText[ChatBotUiTextKey.GovernedOperationsQueueRiskLabel], row.Risk)
                                @TextRow(UiText[ChatBotUiTextKey.ConfidenceLabel], row.Confidence)
                                @CodeRow(UiText[ChatBotUiTextKey.OperationOwnerRoleLabel], row.OwnerRole)
                                @TextRow(UiText[ChatBotUiTextKey.RetryCountLabel], row.RetryCount.ToString(System.Globalization.CultureInfo.InvariantCulture))
                                @CodeRow(UiText[ChatBotUiTextKey.SafeNextActionsLabel], row.NextAction)
                            </FluentStack>

                            <FluentStack Orientation="Orientation.Horizontal" Wrap="true">
                                <ChatBotGovernedAction Label="@UiText[ChatBotUiTextKey.GovernedOperationsQueuePrimaryAction]"
                                                        AccessibleLabel="@UiText.Get(ChatBotUiTextKey.GovernedOperationsQueuePrimaryActionAccessible, row.ItemRef)"
                                                        StableId="@($"claim-{row.ItemRef}")"
                                                        State="@ChatBotGovernedActionState.Enabled"
                                                        CriticalAction="true" />
                                <ChatBotGovernedAction Label="@UiText[ChatBotUiTextKey.GovernedOperationsQueueSecondaryActions]"
                                                        AccessibleLabel="@UiText.Get(ChatBotUiTextKey.GovernedOperationsQueueSecondaryActionsAccessible, row.ItemRef)"
                                                        StableId="@($"secondary-{row.ItemRef}")"
                                                        State="@ChatBotGovernedActionState.Enabled"
                                                        Appearance="@ButtonAppearance.Outline"
                                                        CriticalAction="true" />
                                <ChatBotGovernedAction Label="@UiText[ChatBotUiTextKey.GovernedOperationsQueueOpenDetail]"
                                                        AccessibleLabel="@UiText.Get(ChatBotUiTextKey.GovernedOperationsQueueOpenDetailAccessible, row.ItemRef)"
                                                        StableId="@($"detail-{row.ItemRef}")"
                                                        State="@ChatBotGovernedActionState.DisabledWithReason"
                                                        DisabledReason="@UiText[ChatBotUiTextKey.GovernedOperationsQueueDetailUnavailable]"
                                                        Appearance="@ButtonAppearance.Outline"
                                                        CriticalAction="false" />
                            </FluentStack>

                            <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Info"
                                                 Message="@UiText[ChatBotUiTextKey.GovernedOperationsQueueRetrySafety]"
                                                 AccessibleLabel="@UiText[ChatBotUiTextKey.GovernedOperationsQueueRetrySafety]"
                                                 StableId="@($"retry-safety-{row.ItemRef}")"
                                                 StateFamily="@ChatBotFeedbackStateFamily.ObservedForOthersRejectionOrQueueUpdate"
                                                 AnnouncementKey="@($"retry-safety-{row.ItemRef}")" />
                        </article>
                    }
                </div>
                    </section>
                </FluentAccordionItem>

                <FluentAccordionItem Header="@UiText[ChatBotUiTextKey.ApprovalQueuePriorityTitle]" HeadingLevel="2" Expanded="true">
                    <ChatBotApprovalQueuePriorityView ShowHeading="false" />
                </FluentAccordionItem>

                @if (State.Value.Outcome is { } outcome)
                {
                    @* operation-outcome-title is preserved as the focus-landing target id (asserted by
                       ChatBotAccessibilityFocusContractTests); it now lives on the kept <section> element. *@
                    <FluentAccordionItem Header="@UiText[ChatBotUiTextKey.OutcomeTitle]" HeadingLevel="2" Expanded="true">
                        <section id="operation-outcome-title" class="chatbot-section" aria-label="@UiText[ChatBotUiTextKey.OutcomeTitle]">
                    <div class="chatbot-status-group" aria-label="@UiText[ChatBotUiTextKey.OperationStatusSummary]">
                        @if (IsProjectionPending(outcome))
                        {
                            <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Warning"
                                                 Message="@UiText[ChatBotUiTextKey.ProjectionPending]"
                                                 AccessibleLabel="@UiText[ChatBotUiTextKey.ProjectionPendingAccessible]"
                                                 StableId="projection-pending"
                                                 StateFamily="@ChatBotFeedbackStateFamily.CurrentUserCommandAcceptedProjectionPending"
                                                 AnnouncementKey="@outcome.OperationId">
                                @UiText[ChatBotUiTextKey.ProjectionPending] (<code class="chatbot-code">@outcome.CompletionStatus</code>).
                            </ChatBotStatusBanner>
                        }
                        else
                        {
                            <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Success"
                                                 Message="@UiText[ChatBotUiTextKey.ProjectionComplete]"
                                                 AccessibleLabel="@UiText[ChatBotUiTextKey.ProjectionCompleteAccessible]"
                                                 StableId="projection-complete"
                                                 StateFamily="@ChatBotFeedbackStateFamily.CurrentUserCommandAcceptedProjectionPending"
                                                 AnnouncementKey="@outcome.OperationId">
                                @UiText[ChatBotUiTextKey.ProjectionComplete] (<code class="chatbot-code">@outcome.CompletionStatus</code>).
                            </ChatBotStatusBanner>
                        }

                        @if (IsAuditCommitted(outcome))
                        {
                            <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Success"
                                                 Message="@UiText[ChatBotUiTextKey.AuditStatusCommitted]"
                                                 AccessibleLabel="@UiText[ChatBotUiTextKey.AuditStatusCommittedAccessible]"
                                                 StableId="audit-committed"
                                                 StateFamily="@ChatBotFeedbackStateFamily.CurrentUserCommandAcceptedProjectionPending"
                                                 AnnouncementKey="@($"{outcome.OperationId}-audit")">
                                @UiText[ChatBotUiTextKey.AuditStatusCommitted] (<code class="chatbot-code">@outcome.AuditStatus</code>).
                            </ChatBotStatusBanner>
                        }

                        <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Info"
                                             Message="@UiText[ChatBotUiTextKey.AuditHistoryMetadataOnly]"
                                             AccessibleLabel="@UiText[ChatBotUiTextKey.AuditHistoryMetadataOnly]"
                                             StableId="audit-history-metadata-only"
                                             StateFamily="@ChatBotFeedbackStateFamily.ObservedForOthersRejectionOrQueueUpdate"
                                             AnnouncementKey="audit-history-metadata-only" />
                    </div>

                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem">
                        @CodeRow(UiText[ChatBotUiTextKey.OperationLabel], outcome.OperationId)
                        @CodeRow(UiText[ChatBotUiTextKey.OperationClassLabel], outcome.OperationClass)
                        @CodeRow(UiText[ChatBotUiTextKey.CommandLabel], outcome.CommandId)
                        @CodeRow(UiText[ChatBotUiTextKey.LifecycleStateLabel], outcome.LifecycleState)
                        @CodeRow(UiText[ChatBotUiTextKey.CompletionStatusLabel], outcome.CompletionStatus)
                        @CodeRow(UiText[ChatBotUiTextKey.AuditStatusLabel], outcome.AuditStatus)
                        @CodeRow(UiText[ChatBotUiTextKey.SafeNextActionsLabel], string.Join(", ", outcome.SafeNextActions))
                        @TextRow(UiText[ChatBotUiTextKey.RetryCountLabel], outcome.RetryCount.ToString(System.Globalization.CultureInfo.InvariantCulture))
                        @CodeRowIf(UiText[ChatBotUiTextKey.OperationOwnerRoleLabel], outcome.OwnerRole)
                        @TextRowIf(UiText[ChatBotUiTextKey.DuplicateSafetyNoteLabel], outcome.DuplicateSafetyNote)
                    </FluentStack>

                    <h2 class="chatbot-section-title">@UiText[ChatBotUiTextKey.AuditHistoryTitle]</h2>
                    <ul class="chatbot-audit-list">
                        @foreach (string entry in outcome.AuditHistory)
                        {
                            <li><code class="chatbot-code">@entry</code></li>
                        }
                    </ul>
                        </section>
                    </FluentAccordionItem>
                }
            </FluentAccordion>
        </section>
        </FcPageLayout>
    </MainContent>
    <ComplementaryPanel>
        <section class="chatbot-section" aria-labelledby="governed-review-context-title">
            <h2 id="governed-review-context-title" class="chatbot-section-title">@UiText[ChatBotUiTextKey.GovernedOperationReviewContext]</h2>
            <p class="chatbot-body">
                @UiText[ChatBotUiTextKey.ReviewContextDescription]
            </p>
        </section>
    </ComplementaryPanel>
</ChatBotConversationShell>

@code {
    private static readonly OperationalQueueFamily[] QueueFamilies =
    [
        OperationalQueueFamily.AmbiguousAssociation,
        OperationalQueueFamily.UnresolvedParticipant,
        OperationalQueueFamily.PendingApproval,
        OperationalQueueFamily.FailedIngestion,
        OperationalQueueFamily.FailedAttachment,
        OperationalQueueFamily.RetryableOperation,
    ];

    private static readonly OperationalQueueFixtureRow[] QueueRows =
    [
        Row(OperationalQueueFamily.AmbiguousAssociation, "queue:ambiguous", "item:ambiguous-001", "waiting", "high", "0.62", "operations-admin", 1, "claim", 12),
        Row(OperationalQueueFamily.UnresolvedParticipant, "queue:participant", "item:participant-001", "blocked", "medium", "0.44", "operations-admin", 0, "assign", 9),
        Row(OperationalQueueFamily.PendingApproval, "queue:approval", "item:approval-001", "escalation-needed", "critical", "0.91", "operations-admin", 0, "prioritize", 21),
        Row(OperationalQueueFamily.FailedIngestion, "queue:ingestion", "item:ingestion-001", "failed", "high", "0.70", "operations-admin", 3, "retry", 33),
        Row(OperationalQueueFamily.FailedAttachment, "queue:attachment", "item:attachment-001", "retryable", "medium", "0.68", "operations-admin", 2, "retry", 18),
        Row(OperationalQueueFamily.RetryableOperation, "queue:retry", "item:retry-001", "retryable", "low", "0.80", "operations-admin", 1, "requeue", 7),
    ];

    private OperationalQueueFamily SelectedQueueFamily { get; set; } = OperationalQueueFamily.AmbiguousAssociation;

    private string QueueLoadingMode => ChatBotQueueLoadingMode.Pagination.ToString();

    private OperationalQueueFixtureRow[] VisibleQueueRows
        => QueueRows.Where(row => row.Family == SelectedQueueFamily).ToArray();

    // The route description folds the intro + the surface-origin literal ("ui") + the suffix into a single plain
    // string for FcPageHeader.Description (a plain string rendered in one FluentText). The original interleaved
    // <code>ui</code> monospace styling is cosmetic and is intentionally dropped here per the Story 13.2 mapping.
    private string GovernedOperationsDescription
        => $"{UiText[ChatBotUiTextKey.GovernedOperationsIntro]} ui {UiText[ChatBotUiTextKey.GovernedOperationsIntroSuffix]}";

    private void Submit() => Dispatcher.Dispatch(new SubmitGovernedNoteAction());

    private static bool IsProjectionPending(OperationOutcome outcome)
        => outcome.CompletionStatus.Contains("Pending", StringComparison.OrdinalIgnoreCase);

    private static bool IsAuditCommitted(OperationOutcome outcome)
        => outcome.AuditStatus.Contains("Committed", StringComparison.OrdinalIgnoreCase);

    private static OperationalQueueFixtureRow Row(
        OperationalQueueFamily family,
        string queueRef,
        string itemRef,
        string state,
        string risk,
        string confidence,
        string ownerRole,
        int retryCount,
        string nextAction,
        long sourceVersion)
        => new(
            family,
            OperationalQueueFamilies.ToWireValue(family),
            queueRef,
            itemRef,
            state,
            risk,
            confidence,
            ownerRole,
            retryCount,
            nextAction,
            sourceVersion);

    // Story 13.4: the former <dl> queue-filter / per-row / outcome dumps render
    // as structured Fluent key-value blocks. Opaque query expressions, ids, command/operation classes,
    // lifecycle/completion/audit/risk/owner-role/next-action tokens keep <code class="chatbot-code">; numeric
    // metrics (result count, confidence, retry count) and the duplicate-safety note render as plain
    // FluentText (AC3). Blank-guarded rows render nothing.
    private static RenderFragment CodeRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <code class="chatbot-code">@value</code>
    </FluentStack>;

    private static RenderFragment TextRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <FluentText>@value</FluentText>
    </FluentStack>;

    private static RenderFragment? CodeRowIf(string label, string? value)
        => string.IsNullOrWhiteSpace(value) ? null : CodeRow(label, value);

    private static RenderFragment? TextRowIf(string label, string? value)
        => string.IsNullOrWhiteSpace(value) ? null : TextRow(label, value);

    private sealed record OperationalQueueFixtureRow(
        OperationalQueueFamily Family,
        string FamilyToken,
        string QueueRef,
        string ItemRef,
        string State,
        string Risk,
        string Confidence,
        string OwnerRole,
        int RetryCount,
        string NextAction,
        long SourceVersion);
}
