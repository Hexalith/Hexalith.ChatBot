@page "/"
@namespace Hexalith.ChatBot.UI.Components.Pages
@inherits FluxorComponent
@inject IState<GovernedOperationsState> State
@inject IDispatcher Dispatcher

<PageTitle>Governed operations</PageTitle>

<ChatBotConversationShell ShellLabel="Governed operations"
                          MainLabel="Governed command path"
                          ComplementaryLabel="Governed operation review context">
    <ProjectContext>
        <ChatBotProjectContextHeader ProjectName="Governed operations"
                                     ProjectId="m0-governed-command"
                                     ConversationLabel="Current surface"
                                     ConversationState="Operational command submission"
                                     StatusKind="@ChatBotFeedbackKind.Info"
                                     StatusText="UI origin remains visible"
                                     StatusStableId="governed-operations-context" />
    </ProjectContext>
    <MainContent>
        <section class="chatbot-page" aria-labelledby="governed-operations-title" data-chatbot-responsive-fixture="governed-operations">
            <header class="chatbot-page-header">
                <span class="chatbot-metadata">Governed command</span>
                <h1 id="governed-operations-title" class="chatbot-page-title">Governed operations</h1>
                <p class="chatbot-body">
                    Submit the trivial governed command end-to-end through the command spine. The surface origin
                    <code class="chatbot-code">ui</code> is declared at the boundary and travels into the audit trail.
                </p>
            </header>

            <div class="chatbot-command-bar">
                <ChatBotGovernedAction Label="Record governed note"
                                        AccessibleLabel="Record governed note"
                                        StableId="record-governed-note"
                                        State="@(State.Value.IsSubmitting ? ChatBotGovernedActionState.DisabledWithReason : ChatBotGovernedActionState.Enabled)"
                                        DisabledReason="A governed note is already being submitted."
                                        OnActivate="@Submit" />
            </div>

            @if (State.Value.IsSubmitting)
            {
                <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Info"
                                     Message="Submitting the governed note."
                                     AccessibleLabel="Submission status: submitting"
                                     StableId="governed-note-submitting"
                                     StateFamily="@ChatBotFeedbackStateFamily.CurrentUserCommandAcceptedProjectionPending"
                                     AnnouncementKey="governed-note-submitting" />
            }

            @if (State.Value.Error is { } error)
            {
                <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Danger"
                                     Message="Submission did not complete. You can try again."
                                     AccessibleLabel="Submission status: failed"
                                     StableId="governed-note-failed"
                                     StateFamily="@ChatBotFeedbackStateFamily.RetryableFailure"
                                     AnnouncementKey="@($"governed-note-failed-{error}")">
                    Submission did not complete (code: <code class="chatbot-code">@error</code>). You can try again.
                </ChatBotStatusBanner>
            }

            @if (State.Value.Outcome is { } outcome)
            {
                <section class="chatbot-section" aria-labelledby="operation-outcome-title">
                    <h2 id="operation-outcome-title" class="chatbot-section-title">Outcome</h2>
                    <div class="chatbot-status-group" aria-label="Operation status summary">
                        @if (IsProjectionPending(outcome))
                        {
                            <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Warning"
                                                 Message="Projection is not complete."
                                                 AccessibleLabel="Projection status: pending"
                                                 StableId="projection-pending"
                                                 StateFamily="@ChatBotFeedbackStateFamily.CurrentUserCommandAcceptedProjectionPending"
                                                 AnnouncementKey="@outcome.OperationId">
                                Projection is not complete (<code class="chatbot-code">@outcome.CompletionStatus</code>).
                            </ChatBotStatusBanner>
                        }
                        else
                        {
                            <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Success"
                                                 Message="Projection is complete."
                                                 AccessibleLabel="Projection status: complete"
                                                 StableId="projection-complete"
                                                 StateFamily="@ChatBotFeedbackStateFamily.CurrentUserCommandAcceptedProjectionPending"
                                                 AnnouncementKey="@outcome.OperationId">
                                Projection is complete (<code class="chatbot-code">@outcome.CompletionStatus</code>).
                            </ChatBotStatusBanner>
                        }

                        @if (IsAuditCommitted(outcome))
                        {
                            <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Success"
                                                 Message="Audit metadata is committed."
                                                 AccessibleLabel="Audit status: committed"
                                                 StableId="audit-committed"
                                                 StateFamily="@ChatBotFeedbackStateFamily.CurrentUserCommandAcceptedProjectionPending"
                                                 AnnouncementKey="@($"{outcome.OperationId}-audit")">
                                Audit metadata is committed (<code class="chatbot-code">@outcome.AuditStatus</code>).
                            </ChatBotStatusBanner>
                        }

                        <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Info"
                                             Message="Audit history below is metadata-only."
                                             AccessibleLabel="Audit history: metadata only"
                                             StableId="audit-history-metadata-only"
                                             StateFamily="@ChatBotFeedbackStateFamily.ObservedForOthersRejectionOrQueueUpdate"
                                             AnnouncementKey="audit-history-metadata-only" />
                    </div>

                    <dl class="chatbot-definition-list chatbot-labelled-row-list">
                        <dt class="chatbot-labelled-row">Operation</dt>
                        <dd><code class="chatbot-code">@outcome.OperationId</code></dd>
                        <dt class="chatbot-labelled-row">Command</dt>
                        <dd><code class="chatbot-code">@outcome.CommandId</code></dd>
                        <dt class="chatbot-labelled-row">Lifecycle state</dt>
                        <dd><code class="chatbot-code">@outcome.LifecycleState</code></dd>
                        <dt class="chatbot-labelled-row">Completion status</dt>
                        <dd><code class="chatbot-code">@outcome.CompletionStatus</code></dd>
                        <dt class="chatbot-labelled-row">Audit status</dt>
                        <dd><code class="chatbot-code">@outcome.AuditStatus</code></dd>
                        <dt class="chatbot-labelled-row">Safe next actions</dt>
                        <dd><code class="chatbot-code">@string.Join(", ", outcome.SafeNextActions)</code></dd>
                    </dl>

                    <h2 class="chatbot-section-title">Audit history (metadata-only)</h2>
                    <ul class="chatbot-audit-list">
                        @foreach (string entry in outcome.AuditHistory)
                        {
                            <li><code class="chatbot-code">@entry</code></li>
                        }
                    </ul>
                </section>
            }
        </section>
    </MainContent>
    <ComplementaryPanel>
        <section class="chatbot-section" aria-labelledby="governed-review-context-title">
            <h2 id="governed-review-context-title" class="chatbot-section-title">Review context</h2>
            <p class="chatbot-body">
                Current operation context remains available beside the command path without becoming a modal layer.
            </p>
        </section>
    </ComplementaryPanel>
</ChatBotConversationShell>

@code {
    private void Submit() => Dispatcher.Dispatch(new SubmitGovernedNoteAction());

    private static bool IsProjectionPending(OperationOutcome outcome)
        => outcome.CompletionStatus.Contains("Pending", StringComparison.OrdinalIgnoreCase);

    private static bool IsAuditCommitted(OperationOutcome outcome)
        => outcome.AuditStatus.Contains("Committed", StringComparison.OrdinalIgnoreCase);
}
