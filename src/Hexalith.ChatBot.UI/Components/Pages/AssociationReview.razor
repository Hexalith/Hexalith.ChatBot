@page "/association-review/{AssociationId}"
@namespace Hexalith.ChatBot.UI.Components.Pages
@inherits FluxorComponent
@inject IState<AssociationReviewState> State
@inject IDispatcher Dispatcher
@inject ChatBotUiTextLocalizer UiText
@inject ChatBotCultureFormatter Formatter

<ChatBotConversationShell ShellLabel="@UiText[ChatBotUiTextKey.AssociationReviewTitle]"
                          MainLabel="@UiText[ChatBotUiTextKey.AssociationReviewCandidates]"
                          ComplementaryLabel="@UiText[ChatBotUiTextKey.AssociationReviewComparison]">
    <ProjectContext>
        <ChatBotProjectContextHeader ProjectName="@UiText[ChatBotUiTextKey.AssociationReviewTitle]"
                                     ProjectId="@AssociationId"
                                     ConversationLabel="@UiText[ChatBotUiTextKey.CurrentSurface]"
                                     ConversationState="@ReviewStateLabel"
                                     StatusKind="@StatusKind"
                                     StatusText="@UiText[ChatBotUiTextKey.StatusTextContextVisible]"
                                     StatusStableId="association-review-context" />
    </ProjectContext>
    <MainContent>
        <FcPageLayout Mode="FcPageLayoutMode.FullWidth">
        <section class="chatbot-page chatbot-association-review"
                 aria-labelledby="association-review-title"
                 data-chatbot-responsive-fixture="association-review">
            <FcPageHeader PageTitle="@UiText[ChatBotUiTextKey.PageTitleAssociationReview]"
                          Eyebrow="S2"
                          Heading="@UiText[ChatBotUiTextKey.AssociationReviewTitle]"
                          HeadingId="association-review-title"
                          Description="@UiText[ChatBotUiTextKey.AssociationReviewSafeNextAction]" />

            @if (State.Value.IsLoading)
            {
                <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Info"
                                     Message="@UiText[ChatBotUiTextKey.AssociationReviewLoading]"
                                     AccessibleLabel="@UiText[ChatBotUiTextKey.AssociationReviewLoading]"
                                     StableId="association-review-loading"
                                     StateFamily="@ChatBotFeedbackStateFamily.LoadingColdLoad" />
            }

            @if (State.Value.ErrorCode is { } error)
            {
                <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Danger"
                                     Message="@UiText[ChatBotUiTextKey.SubmissionFailed]"
                                     AccessibleLabel="@UiText[ChatBotUiTextKey.SubmissionFailedAccessible]"
                                     StableId="association-review-failed"
                                     StateFamily="@ChatBotFeedbackStateFamily.RetryableFailure"
                                     AnnouncementKey="@($"association-review-failed-{error}")">
                    @UiText.Get(ChatBotUiTextKey.SubmissionFailedBodyTemplate, error)
                </ChatBotStatusBanner>
            }

            @if (Review is { } review)
            {
                <ChatBotStatusBanner Kind="@StatusKind"
                                     Message="@ReviewStateLabel"
                                     AccessibleLabel="@ReviewStateLabel"
                                     StableId="association-review-status"
                                     StateFamily="@FeedbackState"
                                     LiveRegionPoliteness="@ChatBotLiveRegionPoliteness.None" />

                @if (!review.HasAuthorizedCandidates)
                {
                    <ChatBotBlockedState Reason="@ChatBotBlockedReason.UnresolvedAssociation"
                                         ReasonText="@UiText[ChatBotUiTextKey.AssociationReviewEmpty]"
                                         SafeNextAction="@UiText[ChatBotUiTextKey.AssociationReviewSafeNextAction]"
                                         StableId="association-review-empty" />
                }
                else
                {
                    <section class="chatbot-section" aria-labelledby="association-candidates-title">
                        <h2 id="association-candidates-title" class="chatbot-section-title">
                            <FluentText As="TextTag.Span">@UiText[ChatBotUiTextKey.AssociationReviewCandidates]</FluentText>
                        </h2>
                        <FluentStack Orientation="Orientation.Vertical"
                                     VerticalGap="0.75rem"
                                     Class="chatbot-association-candidate-list"
                                     role="radiogroup"
                                     aria-label="@UiText[ChatBotUiTextKey.AssociationReviewCandidates]">
                            @foreach (AssociationCandidateModel candidate in review.Candidates)
                            {
                                <ChatBotAssociationCandidateRow Candidate="@candidate"
                                                                IsSelected="@IsSelected(candidate)"
                                                                OnSelected="@SelectCandidate" />
                            }
                        </FluentStack>
                    </section>
                }

                <ChatBotAssociationReviewActions HasSelectedCandidate="@(State.Value.SelectedCandidate is not null)"
                                                 IsTerminal="@review.IsTerminal"
                                                 CanCorrect="@CanCorrect(review)"
                                                 DisabledReasons="@review.DisabledActionReasonCodes"
                                                 DecisionNote="@State.Value.DecisionNote"
                                                 CorrectionRationale="@State.Value.CorrectionRationale"
                                                 CorrectedProjectId="@review.CorrectedProjectId"
                                                 PriorProjectId="@review.PriorProjectId"
                                                 DownstreamImpactStatus="@review.DownstreamImpactStatus"
                                                 PropagationStatus="@review.PropagationStatus"
                                                 PropagationProgressNumerator="@review.PropagationProgressNumerator"
                                                 PropagationProgressDenominator="@review.PropagationProgressDenominator"
                                                 PropagationEstimatedCompletionAtUtc="@review.PropagationEstimatedCompletionAtUtc"
                                                 IsCorrectedContextStale="@review.IsCorrectedContextStale"
                                                 ResponsibleOwnerRole="@review.ResponsibleOwnerRole"
                                                 SafeNextAction="@review.SafeNextAction"
                                                 ValidationErrorCode="@State.Value.ValidationErrorCode"
                                                 OnDecisionNoteChanged="@UpdateDecisionNote"
                                                 OnCorrectionRationaleChanged="@UpdateCorrectionRationale"
                                                 OnPreview="@PreviewDecision"
                                                 OnSubmitCorrection="@SubmitCorrection" />
            }
        </section>
        </FcPageLayout>
    </MainContent>
    <ComplementaryPanel>
        @if (Review is { } review)
        {
            <ChatBotAssociationEvidenceComparison Candidate="@State.Value.SelectedCandidate" />
            <section class="chatbot-section" aria-labelledby="association-source-title">
                <FluentCard>
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.75rem">
                        <h2 id="association-source-title" class="chatbot-section-title">
                            <FluentText As="TextTag.Span">@UiText[ChatBotUiTextKey.AssociationReviewSourceMetadata]</FluentText>
                        </h2>
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem">
                            @CodeRow(UiText[ChatBotUiTextKey.OperationLabel], review.AssociationId)
                            @CodeRow(UiText[ChatBotUiTextKey.ConversationContext], review.SourceConversationId)
                            @CodeRow(UiText[ChatBotUiTextKey.LifecycleStateLabel], review.LifecycleState)
                            @CodeRow(UiText[ChatBotUiTextKey.ReasonCodesLabel], string.Join(", ", review.ReasonCodes))
                            @CodeRow(UiText[ChatBotUiTextKey.SafeNextActionsLabel], string.Join(", ", review.NextActionReasonCodes))
                            @CodeRow(UiText[ChatBotUiTextKey.AssociationReviewMetadata], $"{review.SourceProvenance} · {review.SchemaVersion}")
                        </FluentStack>
                    </FluentStack>
                </FluentCard>
            </section>
        }
    </ComplementaryPanel>
</ChatBotConversationShell>

@code {
    [Parameter]
    public string AssociationId { get; set; } = string.Empty;

    private AssociationReviewModel? Review => State.Value.Review;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!string.IsNullOrWhiteSpace(AssociationId) && Review?.AssociationId != AssociationId)
        {
            Dispatcher.Dispatch(new LoadAssociationReviewAction(AssociationId));
        }
    }

    private string ReviewStateLabel
        => Review is null
            ? UiText[ChatBotUiTextKey.AssociationReviewLoading]
            : $"{Review.LifecycleState} · {Review.Outcome} · {Formatter.FormatConfidence(Review.ConfidenceScore)}";

    private ChatBotFeedbackKind StatusKind
        => Review switch
        {
            null => ChatBotFeedbackKind.Info,
            { IsTerminal: true } => ChatBotFeedbackKind.Warning,
            { HasAuthorizedCandidates: false } => ChatBotFeedbackKind.Warning,
            { IsStaleOrDegraded: true } => ChatBotFeedbackKind.Warning,
            _ => ChatBotFeedbackKind.Info,
        };

    private ChatBotFeedbackStateFamily FeedbackState
        => Review switch
        {
            { IsTerminal: true } => ChatBotFeedbackStateFamily.TerminalPolicyFailure,
            { HasAuthorizedCandidates: false } => ChatBotFeedbackStateFamily.BlockedAction,
            { IsStaleOrDegraded: true } => ChatBotFeedbackStateFamily.DependencyDegraded,
            _ => ChatBotFeedbackStateFamily.CurrentUserAiProposalReady,
        };

    private bool IsSelected(AssociationCandidateModel candidate)
        => string.Equals(State.Value.SelectedCandidateId, candidate.ProjectId, StringComparison.Ordinal);

    private void SelectCandidate(string candidateId)
        => Dispatcher.Dispatch(new SelectAssociationCandidateAction(candidateId));

    private void UpdateDecisionNote(string decisionNote)
        => Dispatcher.Dispatch(new UpdateAssociationDecisionNoteAction(decisionNote));

    private void UpdateCorrectionRationale(string correctionRationale)
        => Dispatcher.Dispatch(new UpdateAssociationCorrectionRationaleAction(correctionRationale));

    private void PreviewDecision(string decisionCode)
        => Dispatcher.Dispatch(new PreviewAssociationDecisionAction(decisionCode));

    private void SubmitCorrection()
        => Dispatcher.Dispatch(new SubmitAssociationCorrectionAction());

    private static bool CanCorrect(AssociationReviewModel review)
        => review.LifecycleState is "Associated" or "Corrected" or "Correcting" or "Correction-delayed";

    // Story 13.4: the former source-metadata <dl> renders as a structured
    // Fluent key-value block. Every value (association/conversation ids, lifecycle/reason/next-action tokens,
    // provenance · schema-version) is an opaque token and keeps <code class="chatbot-code"> (AC3).
    private static RenderFragment CodeRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <code class="chatbot-code">@value</code>
    </FluentStack>;
}
