@page "/compliance-audit-investigation"
@namespace Hexalith.ChatBot.UI.Components.Pages
@using System.Globalization
@inject ComplianceAuditService AuditService
@inject ChatBotUiTextLocalizer UiText

@* Story 9.3 (S9): read/escalate-only compliance audit investigation surface. It renders a metadata-only audit
   timeline over the tenant WORM chain, exposes the FR56 query dimensions, offers a safe escalation/investigation
   affordance with an opaque resource reference, and renders any operate-style control inert (read/escalate only —
   never workflow mutation). Every visible string and accessible label is localized; every row token is a bounded
   safe token. *@

<PageTitle>@UiText[ChatBotUiTextKey.ComplianceAuditPageTitleTab]</PageTitle>

<ChatBotConversationShell ShellLabel="@UiText[ChatBotUiTextKey.ComplianceAuditPageTitle]"
                          MainLabel="@UiText[ChatBotUiTextKey.ComplianceAuditInvestigationTitle]"
                          ComplementaryLabel="@UiText[ChatBotUiTextKey.ComplianceAuditPhoneSummary]">
    <ProjectContext>
        <ChatBotProjectContextHeader ProjectName="@UiText[ChatBotUiTextKey.ComplianceAuditPageTitle]"
                                     ProjectId="s9-compliance-audit"
                                     ConversationLabel="@UiText[ChatBotUiTextKey.CurrentSurface]"
                                     ConversationState="@UiText[ChatBotUiTextKey.ComplianceAuditInvestigationTitle]"
                                     StatusKind="@ChatBotFeedbackKind.Info"
                                     StatusText="@UiText[ChatBotUiTextKey.UiOriginVisible]"
                                     StatusStableId="compliance-audit-context" />
    </ProjectContext>
    <MainContent>
        <section class="chatbot-page compliance-audit-investigation"
                 aria-labelledby="compliance-audit-title"
                 data-chatbot-responsive-fixture="audit-investigation-s9">
            <header class="chatbot-page-header">
                <span class="chatbot-metadata">@UiText[ChatBotUiTextKey.ComplianceAuditMetadata]</span>
                <h1 id="compliance-audit-title" class="chatbot-page-title">@UiText[ChatBotUiTextKey.ComplianceAuditPageTitle]</h1>
            </header>

            <section class="chatbot-section"
                     data-chatbot-surface="audit-investigation-s9"
                     aria-labelledby="compliance-timeline-title">
                <h2 id="compliance-timeline-title" class="chatbot-section-title">@UiText[ChatBotUiTextKey.ComplianceAuditInvestigationTitle]</h2>

                <p id="compliance-escalation-reason" class="chatbot-body">@UiText[ChatBotUiTextKey.ComplianceAuditEscalationReason]</p>
                <p id="compliance-operate-denied" class="chatbot-body">@UiText[ChatBotUiTextKey.ComplianceAuditOperateDenied]</p>

                <section class="chatbot-section compliance-audit-filters"
                         data-compliance-dense-audit="true"
                         aria-labelledby="compliance-filters-title">
                    <h3 id="compliance-filters-title" class="chatbot-section-title">@UiText[ChatBotUiTextKey.ComplianceAuditFiltersTitle]</h3>
                    <div class="chatbot-form-grid">
                        <FluentLabel Class="chatbot-labelled-row" for="compliance-filter-tenant">@UiText[ChatBotUiTextKey.ComplianceAuditFilterTenant]</FluentLabel>
                        <FluentTextInput Id="compliance-filter-tenant"
                                         Class="chatbot-input"
                                         Value="@_filters.Tenant"
                                         ValueChanged="@((string? value) => _filters.Tenant = value)"
                                         aria-label="@UiText[ChatBotUiTextKey.ComplianceAuditFilterTenant]" />
                        <FluentLabel Class="chatbot-labelled-row" for="compliance-filter-actor">@UiText[ChatBotUiTextKey.ComplianceAuditFilterActor]</FluentLabel>
                        <FluentTextInput Id="compliance-filter-actor"
                                         Class="chatbot-input"
                                         Value="@_filters.Actor"
                                         ValueChanged="@((string? value) => _filters.Actor = value)"
                                         aria-label="@UiText[ChatBotUiTextKey.ComplianceAuditFilterActor]" />
                        <FluentLabel Class="chatbot-labelled-row" for="compliance-filter-command">@UiText[ChatBotUiTextKey.ComplianceAuditFilterCommand]</FluentLabel>
                        <FluentTextInput Id="compliance-filter-command"
                                         Class="chatbot-input"
                                         Value="@_filters.Command"
                                         ValueChanged="@((string? value) => _filters.Command = value)"
                                         aria-label="@UiText[ChatBotUiTextKey.ComplianceAuditFilterCommand]" />
                        <FluentLabel Class="chatbot-labelled-row" for="compliance-filter-resource">@UiText[ChatBotUiTextKey.ComplianceAuditFilterResource]</FluentLabel>
                        <FluentTextInput Id="compliance-filter-resource"
                                         Class="chatbot-input"
                                         Value="@_filters.Resource"
                                         ValueChanged="@((string? value) => _filters.Resource = value)"
                                         aria-label="@UiText[ChatBotUiTextKey.ComplianceAuditFilterResource]" />
                        <FluentLabel Class="chatbot-labelled-row" for="compliance-filter-decision">@UiText[ChatBotUiTextKey.ComplianceAuditFilterDecision]</FluentLabel>
                        <FluentTextInput Id="compliance-filter-decision"
                                         Class="chatbot-input"
                                         Value="@_filters.Decision"
                                         ValueChanged="@((string? value) => _filters.Decision = value)"
                                         aria-label="@UiText[ChatBotUiTextKey.ComplianceAuditFilterDecision]" />
                        <FluentLabel Class="chatbot-labelled-row" for="compliance-filter-reason">@UiText[ChatBotUiTextKey.ComplianceAuditFilterReason]</FluentLabel>
                        <FluentTextInput Id="compliance-filter-reason"
                                         Class="chatbot-input"
                                         Value="@_filters.Reason"
                                         ValueChanged="@((string? value) => _filters.Reason = value)"
                                         aria-label="@UiText[ChatBotUiTextKey.ComplianceAuditFilterReason]" />
                        <FluentLabel Class="chatbot-labelled-row" for="compliance-filter-correlation">@UiText[ChatBotUiTextKey.ComplianceAuditFilterCorrelation]</FluentLabel>
                        <FluentTextInput Id="compliance-filter-correlation"
                                         Class="chatbot-input"
                                         Value="@_filters.Correlation"
                                         ValueChanged="@((string? value) => _filters.Correlation = value)"
                                         aria-label="@UiText[ChatBotUiTextKey.ComplianceAuditFilterCorrelation]" />
                        <FluentLabel Class="chatbot-labelled-row" for="compliance-filter-message-id">@UiText[ChatBotUiTextKey.ComplianceAuditFilterMessageId]</FluentLabel>
                        <FluentTextInput Id="compliance-filter-message-id"
                                         Class="chatbot-input"
                                         Value="@_filters.MessageId"
                                         ValueChanged="@((string? value) => _filters.MessageId = value)"
                                         aria-label="@UiText[ChatBotUiTextKey.ComplianceAuditFilterMessageId]" />
                        <FluentLabel Class="chatbot-labelled-row" for="compliance-filter-surface">@UiText[ChatBotUiTextKey.ComplianceAuditFilterSurface]</FluentLabel>
                        <FluentTextInput Id="compliance-filter-surface"
                                         Class="chatbot-input"
                                         Value="@_filters.Surface"
                                         ValueChanged="@((string? value) => _filters.Surface = value)"
                                         aria-label="@UiText[ChatBotUiTextKey.ComplianceAuditFilterSurface]" />
                        <FluentLabel Class="chatbot-labelled-row" for="compliance-filter-from">@UiText[ChatBotUiTextKey.ComplianceAuditFilterFrom]</FluentLabel>
                        <FluentTextInput Id="compliance-filter-from"
                                         Class="chatbot-input"
                                         Value="@_filters.FromUtcText"
                                         ValueChanged="_filters.SetFromUtcText"
                                         aria-label="@UiText[ChatBotUiTextKey.ComplianceAuditFilterFrom]" />
                        <FluentLabel Class="chatbot-labelled-row" for="compliance-filter-to">@UiText[ChatBotUiTextKey.ComplianceAuditFilterTo]</FluentLabel>
                        <FluentTextInput Id="compliance-filter-to"
                                         Class="chatbot-input"
                                         Value="@_filters.ToUtcText"
                                         ValueChanged="_filters.SetToUtcText"
                                         aria-label="@UiText[ChatBotUiTextKey.ComplianceAuditFilterTo]" />
                        <FluentLabel Class="chatbot-labelled-row" for="compliance-filter-limit">@UiText[ChatBotUiTextKey.ComplianceAuditFilterLimit]</FluentLabel>
                        <FluentNumberInput TValue="int"
                                           Id="compliance-filter-limit"
                                           Class="chatbot-input"
                                           Value="@_filters.Limit"
                                           ValueChanged="@((int value) => _filters.Limit = value)"
                                           aria-label="@UiText[ChatBotUiTextKey.ComplianceAuditFilterLimit]" />
                    </div>
                    <div class="compliance-action-row">
                        <FluentButton Type="ButtonType.Button"
                                      data-chatbot-stable-id="compliance-search"
                                      OnClick="SearchAsync">@UiText[ChatBotUiTextKey.ComplianceAuditSearchButton]</FluentButton>
                        <FluentButton Type="ButtonType.Button"
                                      data-chatbot-stable-id="compliance-trigger-investigation"
                                      OnClick="TriggerInvestigationAsync">@UiText[ChatBotUiTextKey.ComplianceAuditInvestigationButton]</FluentButton>
                    </div>
                </section>

                @if (_loading)
                {
                    <p class="chatbot-status" role="status" aria-busy="true" aria-live="polite">@UiText[ChatBotUiTextKey.ComplianceAuditLoading]</p>
                }
                else if (_projectionPending)
                {
                    <p class="chatbot-status" role="status" aria-live="polite" data-compliance-projection-pending="true">@UiText[ChatBotUiTextKey.ComplianceAuditProjectionPending]</p>
                }

                @if (!_loading && (_timeline is null || _timeline.Rows.Count == 0))
                {
                    <p class="chatbot-body" data-compliance-empty="true">@UiText[ChatBotUiTextKey.ComplianceAuditEmpty]</p>
                }
                else if (_timeline is { } timeline)
                {
                    <ol class="chatbot-audit-timeline"
                        data-compliance-dense-audit="true"
                        aria-label="@UiText[ChatBotUiTextKey.ComplianceAuditTimelineLabel]">
                        @foreach (ComplianceAuditRowModel row in timeline.Rows)
                        {
                            <li>
                                <article aria-label="@RowAccessibleLabel(row)"
                                         data-redaction-state="@row.Redaction"
                                         data-escalation-state="@row.Escalation">
                                    <h3>@row.Command</h3>
                                    <dl class="chatbot-definition-list" aria-label="@UiText[ChatBotUiTextKey.ComplianceAuditSafeMetadataLabel]">
                                        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.ComplianceAuditActorLabel]</dt>
                                        <dd><code class="chatbot-code">actor:@row.Actor</code></dd>
                                        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.ComplianceAuditCommandLabel]</dt>
                                        <dd><code class="chatbot-code">command:@row.Command</code></dd>
                                        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.ComplianceAuditDecisionLabel]</dt>
                                        <dd><code class="chatbot-code">decision:@row.Decision</code></dd>
                                        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.ComplianceAuditReasonLabel]</dt>
                                        <dd><code class="chatbot-code">reason:@row.Reason</code></dd>
                                        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.ComplianceAuditCorrelationLabel]</dt>
                                        <dd><code class="chatbot-code">correlation:@row.Correlation</code></dd>
                                        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.ComplianceAuditPolicySnapshotLabel]</dt>
                                        <dd><code class="chatbot-code">policy-snapshot:@row.PolicySnapshot</code></dd>
                                        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.ComplianceAuditRedactionLabel]</dt>
                                        <dd><code class="chatbot-code">redaction:@row.Redaction</code></dd>
                                        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.ComplianceAuditEscalationLabel]</dt>
                                        <dd><code class="chatbot-code">escalation:@row.Escalation</code></dd>
                                        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.ComplianceAuditSafeNextActionLabel]</dt>
                                        <dd><code class="chatbot-code">safe-next-action:@row.SafeNextAction</code></dd>
                                    </dl>
                                    <div class="compliance-action-row">
                                        <FluentButton Type="ButtonType.Button"
                                                      aria-describedby="compliance-escalation-reason"
                                                      data-chatbot-stable-id="compliance-request-access"
                                                      OnClick="@(() => RequestEscalationAsync(row.AuditRecordRef))">@UiText[ChatBotUiTextKey.ComplianceAuditEscalationButton]</FluentButton>
                                        <FluentButton Type="ButtonType.Button"
                                                      aria-disabled="true"
                                                      aria-describedby="compliance-operate-denied"
                                                      data-chatbot-stable-id="compliance-operate-disabled"
                                                      data-compliance-operate-denied="true">@UiText[ChatBotUiTextKey.ComplianceAuditRetryButton]</FluentButton>
                                    </div>
                                </article>
                            </li>
                        }
                    </ol>
                }
            </section>
        </section>
    </MainContent>
    <ComplementaryPanel>
        <section class="chatbot-section compliance-phone-fallback"
                 aria-label="@UiText[ChatBotUiTextKey.ComplianceAuditPhoneSummary]">
            <p>@UiText[ChatBotUiTextKey.ComplianceAuditPhoneSummary]</p>
            @if (_timeline is { Rows.Count: > 0 } phone)
            {
                <p>audit-record:@phone.Rows[0].AuditRecordRef</p>
                <p>redaction:@phone.Rows[0].Redaction</p>
                <p>safe-next-action:@phone.Rows[0].SafeNextAction</p>
            }
            <p>@UiText[ChatBotUiTextKey.ComplianceAuditPhoneGuidance]</p>
            <FluentButton Type="ButtonType.Button"
                          aria-describedby="compliance-escalation-reason"
                          data-chatbot-stable-id="compliance-request-access"
                          OnClick="RequestPhoneEscalationAsync">@UiText[ChatBotUiTextKey.ComplianceAuditEscalationButton]</FluentButton>
        </section>
    </ComplementaryPanel>
</ChatBotConversationShell>

@code {
    private const string OpaqueEscalationTarget = "project-opaque-ref";
    private const string InvestigationId = "investigation-s9";

    private readonly FilterForm _filters = FilterForm.Default;
    private ComplianceAuditTimelineModel? _timeline;
    private bool _loading;
    private bool _projectionPending;

    protected override async Task OnInitializedAsync()
        => await SearchAsync();

    private async Task SearchAsync()
    {
        _loading = true;
        try
        {
            _timeline = await AuditService.SearchAsync(_filters.ToQueryModel());
            _projectionPending = false;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task RequestEscalationAsync(string auditRecordRef)
        => AuditService.RequestEscalationAsync(auditRecordRef, InvestigationId, OpaqueEscalationTarget);

    private Task RequestPhoneEscalationAsync()
        => AuditService.RequestEscalationAsync(_timeline?.Rows.FirstOrDefault()?.AuditRecordRef ?? "redacted-ref", InvestigationId, OpaqueEscalationTarget);

    private Task TriggerInvestigationAsync()
        => AuditService.TriggerInvestigationAsync(InvestigationId, _timeline?.QueryRef ?? "audit-query-s9", ["audit-filter-time"]);

    private string RowAccessibleLabel(ComplianceAuditRowModel row)
        => $"{UiText[ChatBotUiTextKey.ComplianceAuditRecordLabel]}, {row.Command}, {row.Redaction}, {row.TimestampZ}";

    private sealed class FilterForm
    {
        public string? Tenant { get; set; }
        public string? Actor { get; set; }
        public string? Command { get; set; }
        public string? Resource { get; set; }
        public string? Decision { get; set; }
        public string? Reason { get; set; }
        public string? Correlation { get; set; }
        public string? MessageId { get; set; }
        public string? Surface { get; set; }
        public DateTimeOffset FromUtc { get; private set; }
        public DateTimeOffset ToUtc { get; private set; }
        public string FromUtcText { get; private set; } = string.Empty;
        public string ToUtcText { get; private set; } = string.Empty;
        public int Limit { get; set; }

        public static FilterForm Default
        {
            get
            {
                FilterForm form = new() { Limit = 100 };
                form.SetFromUtc(new DateTimeOffset(2020, 1, 1, 0, 0, 0, TimeSpan.Zero));
                form.SetToUtc(new DateTimeOffset(2100, 1, 1, 0, 0, 0, TimeSpan.Zero));
                return form;
            }
        }

        public ComplianceAuditQueryModel ToQueryModel()
            => new(Tenant, Actor, Command, Resource, Decision, Reason, Correlation, MessageId, Surface, FromUtc, ToUtc, Limit);

        public void SetFromUtcText(string? value)
        {
            FromUtcText = value ?? string.Empty;
            if (TryParseUtc(FromUtcText, out DateTimeOffset parsed))
            {
                FromUtc = parsed;
            }
        }

        public void SetToUtcText(string? value)
        {
            ToUtcText = value ?? string.Empty;
            if (TryParseUtc(ToUtcText, out DateTimeOffset parsed))
            {
                ToUtc = parsed;
            }
        }

        private static bool TryParseUtc(string value, out DateTimeOffset parsed)
            => DateTimeOffset.TryParse(
                value,
                CultureInfo.InvariantCulture,
                DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal,
                out parsed);

        private void SetFromUtc(DateTimeOffset value)
        {
            FromUtc = value;
            FromUtcText = value.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture);
        }

        private void SetToUtc(DateTimeOffset value)
        {
            ToUtc = value;
            ToUtcText = value.ToUniversalTime().ToString("O", CultureInfo.InvariantCulture);
        }
    }
}
