@page "/projects/{ProjectId}/conversation"
@namespace Hexalith.ChatBot.UI.Components.Pages
@inject ChatBotUiTextLocalizer UiText

<ChatBotProjectConversationWorkspace ProjectId="@ProjectId"
                                     HeadingText="@UiText[ChatBotUiTextKey.ProjectConversationTitle]"
                                     HeadingId="project-conversation-title"
                                     ResponsiveFixture="project-conversation"
                                     PageTitle="@UiText[ChatBotUiTextKey.PageTitleProjectConversation]"
                                     ComplementaryLabel="@UiText[ChatBotUiTextKey.ProjectConversationMetadata]" />

@code {
    [Parameter]
    public string ProjectId { get; set; } = string.Empty;
}
