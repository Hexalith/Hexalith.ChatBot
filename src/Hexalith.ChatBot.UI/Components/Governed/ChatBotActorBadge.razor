@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotUiTextLocalizer UiText

<FluentStack Orientation="Orientation.Horizontal"
             VerticalAlignment="VerticalAlignment.Center"
             HorizontalGap="0.375rem"
             Class="chatbot-actor-badge"
             data-chatbot-actor-category="@Category"
             aria-label="@AccessibleName">
    <FluentBadge Appearance="BadgeAppearance.Tint"
                 Color="BadgeColor.Subtle"
                 class="chatbot-actor-badge__icon"
                 aria-hidden="true">
        @ChatBotGovernedUiText.GetActorCategoryIconText(Category)
    </FluentBadge>
    <FluentText As="TextTag.Span" Class="chatbot-actor-badge__category">@UiText.ActorCategoryLabel(Category)</FluentText>
    <FluentText As="TextTag.Span" Class="chatbot-actor-badge__label">@ResolvedDisplayLabel</FluentText>
    @if (!IsResolved && !string.IsNullOrWhiteSpace(UnresolvedActionLabel))
    {
        <FluentButton Appearance="ButtonAppearance.Subtle"
                      Type="ButtonType.Button"
                      Class="chatbot-touch-target-dense-secondary"
                      aria-label="@UnresolvedActionAccessibleLabel"
                      OnClick="OnUnresolvedAction">
            @UnresolvedActionLabel
        </FluentButton>
    }
</FluentStack>

@code {
    [Parameter]
    public ChatBotActorCategory Category { get; set; }

    [Parameter]
    public string? DisplayLabel { get; set; }

    [Parameter]
    public bool IsResolved { get; set; } = true;

    [Parameter]
    public string? UnresolvedActionLabel { get; set; }

    [Parameter]
    public EventCallback OnUnresolvedAction { get; set; }

    private string ResolvedDisplayLabel
        => !string.IsNullOrWhiteSpace(DisplayLabel)
            ? DisplayLabel
            : UiText[ChatBotUiTextKey.UnresolvedActor];

    private string AccessibleName => UiText.ActorBadgeAccessibleLabel(Category, ResolvedDisplayLabel);

    private string UnresolvedActionAccessibleLabel => UiText.ActorBadgeResolveAccessibleLabel(Category, ResolvedDisplayLabel);
}
