@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotUiTextLocalizer UiText

<header class="chatbot-project-context-header" aria-label="@UiText[ChatBotUiTextKey.ProjectContext]">
    <FluentCard Class="chatbot-project-context-header__surface">
    <div class="chatbot-project-context-header__identity">
        <span class="chatbot-metadata">@UiText[ChatBotUiTextKey.ProjectLabel]</span>
        @* Not a heading: this block renders BEFORE the FcPageHeader page heading in DOM order, so an <h2> here made
           the first heading a screen-reader user meets outrank the page title. The project name keeps its visual
           prominence via the title class and stays reachable through the header landmark's accessible name. *@
        <p class="chatbot-project-context-header__title">@ProjectName</p>
        <span class="chatbot-metadata"><code class="chatbot-code">@ProjectId</code></span>
    </div>
    @if (!string.IsNullOrWhiteSpace(TenantContext))
    {
        <div class="chatbot-project-context-header__meta" aria-label="@UiText[ChatBotUiTextKey.TenantContext]">
            <span class="chatbot-metadata">@UiText[ChatBotUiTextKey.TenantLabel]</span>
            <span>@TenantContext</span>
        </div>
    }
    <div class="chatbot-project-context-header__meta" aria-label="@UiText[ChatBotUiTextKey.ConversationContext]">
        <span class="chatbot-metadata">@ResolvedConversationLabel</span>
        <span>@ResolvedConversationState</span>
    </div>
    <ChatBotStatusBanner Kind="@StatusKind"
                         Message="@ResolvedStatusText"
                         AccessibleLabel="@UiText.Get(ChatBotUiTextKey.ProjectStatusAccessibleTemplate, ResolvedStatusText)"
                         StableId="@StatusStableId" />
    </FluentCard>
</header>

@code {
    [Parameter]
    public string ProjectName { get; set; } = "Authorized project";

    [Parameter]
    public string ProjectId { get; set; } = "project-context";

    [Parameter]
    public string? TenantContext { get; set; }

    [Parameter]
    public string ConversationLabel { get; set; } = string.Empty;

    [Parameter]
    public string ConversationState { get; set; } = string.Empty;

    [Parameter]
    public ChatBotFeedbackKind StatusKind { get; set; } = ChatBotFeedbackKind.Info;

    [Parameter]
    public string StatusText { get; set; } = string.Empty;

    [Parameter]
    public string StatusStableId { get; set; } = "project-context-status";

    private string ResolvedConversationLabel
        => string.IsNullOrWhiteSpace(ConversationLabel)
            ? UiText[ChatBotUiTextKey.ConversationLabelDefault]
            : ConversationLabel;

    private string ResolvedConversationState
        => string.IsNullOrWhiteSpace(ConversationState)
            ? UiText[ChatBotUiTextKey.ConversationStateDefault]
            : ConversationState;

    private string ResolvedStatusText
        => string.IsNullOrWhiteSpace(StatusText)
            ? UiText[ChatBotUiTextKey.StatusTextContextVisible]
            : StatusText;
}
