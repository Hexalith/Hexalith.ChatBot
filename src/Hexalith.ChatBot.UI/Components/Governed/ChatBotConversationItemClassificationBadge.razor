@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotCultureFormatter Formatter
@inject ChatBotUiTextLocalizer UiText

@if (Classification is not null)
{
    <section class="chatbot-conversation-classification"
             aria-label="@UiText.Get(ChatBotUiTextKey.ClassificationAccessible, ItemId)"
             data-chatbot-classification="@Classification.Kind">
        <FluentCard Class="chatbot-conversation-classification__surface">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.5rem">
                <FluentStack Orientation="Orientation.Horizontal"
                             VerticalAlignment="VerticalAlignment.Center"
                             HorizontalGap="0.5rem"
                             Class="chatbot-conversation-classification__badge">
                    <FluentBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Subtle" aria-hidden="true">@BadgeIcon</FluentBadge>
                    <FluentText As="TextTag.Span">@UiText.ClassificationKindLabel(Classification.Kind)</FluentText>
                    <code class="chatbot-code">@Classification.Kind</code>
                </FluentStack>
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem" Class="chatbot-conversation-classification__metadata">
                    @CodeRow(UiText[ChatBotUiTextKey.ClassificationKernelVersionLabel], Classification.KernelVersion)
                    @TextRow(UiText[ChatBotUiTextKey.ConfidenceLabel], Formatter.FormatConfidence(Classification.ConfidenceScore))
                    @CodeRow(UiText[ChatBotUiTextKey.ClassificationMessageCodeLabel], Classification.MessageCode)
                    @if (Classification.SourceEvidenceIds.Count > 0)
                    {
                        @CodeRow(UiText[ChatBotUiTextKey.ClassificationEvidenceLabel], string.Join(", ", Classification.SourceEvidenceIds))
                    }
                    @LabelTextCodeRow(UiText[ChatBotUiTextKey.RedactionStateLabel], UiText.RedactionStateLabel(Classification.RedactionState), Classification.RedactionState)
                </FluentStack>
                @if (DetectedIntent is not null)
                {
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem" Class="chatbot-conversation-classification__intent">
                        @TextRow(UiText[ChatBotUiTextKey.DetectedIntentSummaryLabel], DetectedIntent.Summary)
                        @LabelTextCodeRow(UiText[ChatBotUiTextKey.DetectedIntentActionKindLabel], UiText.DetectedActionKindLabel(DetectedIntent.ActionKind), DetectedIntent.ActionKind)
                        @if (DetectedIntent.SourceEvidenceIds.Count > 0)
                        {
                            @CodeRow(UiText[ChatBotUiTextKey.ClassificationEvidenceLabel], string.Join(", ", DetectedIntent.SourceEvidenceIds))
                        }
                        @CodeRow(UiText[ChatBotUiTextKey.ClassificationMessageCodeLabel], DetectedIntent.MessageCode)
                        @CodeRow(UiText[ChatBotUiTextKey.SafeNextActionsLabel], DetectedIntent.SafeNextAction)
                        @LabelTextCodeRow(UiText[ChatBotUiTextKey.RedactionStateLabel], UiText.RedactionStateLabel(DetectedIntent.RedactionState), DetectedIntent.RedactionState)
                    </FluentStack>
                }
                @if (ShouldExplainUnavailable)
                {
                    <p class="chatbot-conversation-classification__reason" tabindex="0">
                        <strong>@UiText[ChatBotUiTextKey.WhyUnavailable]</strong> @UiText[ChatBotUiTextKey.DecisionUnavailableReason]
                    </p>
                }
            </FluentStack>
        </FluentCard>
    </section>
}

@code {
    [Parameter]
    public string ItemId { get; set; } = string.Empty;

    [Parameter]
    public ProjectConversationItemClassificationModel? Classification { get; set; }

    [Parameter]
    public ProjectConversationDetectedIntentModel? DetectedIntent { get; set; }

    private string BadgeIcon
        => string.Equals(Classification?.Kind, "actionable", StringComparison.OrdinalIgnoreCase) ? "!" : "i";

    private bool ShouldExplainUnavailable
        => IsUnavailableState(Classification?.RedactionState) || IsUnavailableState(DetectedIntent?.RedactionState);

    private static bool IsUnavailableState(string? state)
        => string.Equals(state, "redacted", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(state, "unavailable", StringComparison.OrdinalIgnoreCase);

    // Story 13.4: the former <dl> classification + intent dumps render as
    // structured Fluent key-value blocks. Opaque tokens (kernel version, message code, evidence ids, safe
    // next-action token) keep <code class="chatbot-code">; the localized kind/action-kind/redaction labels
    // pair a plain FluentText label with the raw <code> token, the formatted confidence and the intent
    // summary render as plain FluentText (AC3).
    private static RenderFragment CodeRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <code class="chatbot-code">@value</code>
    </FluentStack>;

    private static RenderFragment TextRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <FluentText>@value</FluentText>
    </FluentStack>;

    private static RenderFragment LabelTextCodeRow(string label, string? text, string? token) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <FluentText>@text</FluentText>
        <code class="chatbot-code">@token</code>
    </FluentStack>;
}
