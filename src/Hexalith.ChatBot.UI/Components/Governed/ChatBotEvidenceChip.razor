@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotUiTextLocalizer UiText

@if (CanOpenEvidence)
{
    <FluentButton Appearance="ButtonAppearance.Subtle"
                  Type="ButtonType.Button"
                  Class="chatbot-chip chatbot-chip--evidence"
                  data-chatbot-evidence-state="@State"
                  data-chatbot-off-surface-kind="@OffSurfaceKind"
                  aria-label="@AccessibleLabel"
                  aria-disabled="@AriaDisabled"
                  aria-describedby="@ReasonElementId"
                  OnClick="ActivateAsync">
        <FluentBadge Appearance="BadgeAppearance.Tint"
                     Color="BadgeColor.Informative"
                     class="chatbot-chip__cue"
                     aria-hidden="true">
            EV
        </FluentBadge>
        <FluentText As="TextTag.Span" Class="chatbot-chip__label">@ResolvedText</FluentText>
        <FluentText As="TextTag.Span" Class="chatbot-chip__status">@UiText.EvidenceStateLabel(State)</FluentText>
    </FluentButton>
}
else
{
    <FluentStack Orientation="Orientation.Horizontal"
                 VerticalAlignment="VerticalAlignment.Center"
                 HorizontalGap="0.25rem"
                 Class="chatbot-chip chatbot-chip--evidence"
                 data-chatbot-evidence-state="@State"
                 data-chatbot-off-surface-kind="@OffSurfaceKind"
                 aria-label="@AccessibleLabel"
                 aria-describedby="@ReasonElementId">
        <FluentBadge Appearance="BadgeAppearance.Tint"
                     Color="BadgeColor.Informative"
                     class="chatbot-chip__cue"
                     aria-hidden="true">
            EV
        </FluentBadge>
        <FluentText As="TextTag.Span" Class="chatbot-chip__label">@ResolvedText</FluentText>
        <FluentText As="TextTag.Span" Class="chatbot-chip__status">@UiText.EvidenceStateLabel(State)</FluentText>
    </FluentStack>
}

@if (IsUnavailable && !string.IsNullOrWhiteSpace(UnavailableReason))
{
    <span id="@UnavailableReasonId" class="chatbot-chip__reason">@UnavailableReason</span>
}

@code {
    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public ChatBotEvidenceState State { get; set; }

    [Parameter]
    public bool CanOpenEvidence { get; set; }

    [Parameter]
    public string? UnavailableReason { get; set; }

    [Parameter]
    public string StableId { get; set; } = "evidence";

    [Parameter]
    public ChatBotOffSurfaceAffordanceContract? OffSurfaceAffordance { get; set; }

    [Parameter]
    public EventCallback OnActivate { get; set; }

    private bool IsUnavailable => State is ChatBotEvidenceState.Unavailable or ChatBotEvidenceState.Redacted or ChatBotEvidenceState.Unauthorized;

    private string AriaDisabled => IsUnavailable ? "true" : "false";

    private string UnavailableReasonId => $"chatbot-evidence-{StableId}-reason";

    private string? ReasonElementId => IsUnavailable && !string.IsNullOrWhiteSpace(UnavailableReason) ? UnavailableReasonId : null;

    private ChatBotOffSurfaceAffordanceContract? SafeOffSurfaceAffordance
        => OffSurfaceAffordance is { IsSafeForOffSurfaceUse: true } affordance
            && IsOffSurfaceStateCompatible(affordance.RedactionState)
                ? affordance
                : null;

    private string? OffSurfaceKind => SafeOffSurfaceAffordance?.Kind.ToString();

    private string ResolvedText
        => string.IsNullOrWhiteSpace(Text)
            ? UiText[ChatBotUiTextKey.EvidenceDefaultLabel]
            : Text;

    private string AccessibleLabel => UiText.EvidenceAccessibleLabel(State, ResolvedText, UnavailableReason);

    private bool IsOffSurfaceStateCompatible(ChatBotOffSurfaceRedactionState state)
        => (State, state) switch
        {
            (ChatBotEvidenceState.Available, ChatBotOffSurfaceRedactionState.Available) => true,
            (ChatBotEvidenceState.Redacted, ChatBotOffSurfaceRedactionState.Redacted) => true,
            (ChatBotEvidenceState.Unauthorized, ChatBotOffSurfaceRedactionState.Unauthorized) => true,
            (ChatBotEvidenceState.Unavailable, ChatBotOffSurfaceRedactionState.Redacted) => true,
            _ => false,
        };

    private async Task ActivateAsync()
    {
        if (IsUnavailable || !CanOpenEvidence)
        {
            return;
        }

        await OnActivate.InvokeAsync().ConfigureAwait(false);
    }
}
