@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotCultureFormatter Formatter
@inject ChatBotUiTextLocalizer UiText

<article class="chatbot-email-conversation-item"
         data-chatbot-conversation-item-kind="@Item.Kind"
         data-chatbot-conversation-item-id="@Item.ItemId"
         tabindex="0"
         aria-label="@AccessibleLabel">
    <header class="chatbot-email-conversation-item__header">
        <ChatBotActorBadge Category="@ActorCategory"
                           DisplayLabel="@Item.ActorLabel" />
        @if (IsSystemDecision)
        {
            <span class="chatbot-email-conversation-item__decision">@SystemDecisionLabel</span>
        }
        <time datetime="@Item.OccurredAt.ToUniversalTime().ToString("O", System.Globalization.CultureInfo.InvariantCulture)"
              class="chatbot-metadata">
            @Item.OccurredAt.ToUniversalTime().ToString("u", System.Globalization.CultureInfo.InvariantCulture)
        </time>
    </header>
    <ChatBotConversationItemStatusSummary ItemId="@Item.ItemId"
                                          Summary="@Item.StatusSummary" />
    <dl class="chatbot-definition-list chatbot-email-conversation-item__metadata">
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.SourceProvenanceLabel]</dt>
        <dd><code class="chatbot-code">@(Item.SourceProvenanceDisplayToken ?? Item.SourceProvenance)</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.SourceMailboxLabel]</dt>
        <dd><code class="chatbot-code">@Item.SourceMailboxId</code></dd>
        @if (!string.IsNullOrWhiteSpace(Item.SourceProviderMessageId))
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.SourceProviderMessageLabel]</dt>
            <dd><code class="chatbot-code">@Item.SourceProviderMessageId</code></dd>
        }
        @if (!string.IsNullOrWhiteSpace(Item.InternetMessageId))
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.InternetMessageLabel]</dt>
            <dd><code class="chatbot-code">@Item.InternetMessageId</code></dd>
        }
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.OperationLabel]</dt>
        <dd><code class="chatbot-code">@Item.AssociationId</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.ConversationContext]</dt>
        <dd><code class="chatbot-code">@Item.SourceConversationId</code></dd>
        @if (!string.IsNullOrWhiteSpace(Item.SourceThreadId))
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.SourceThreadLabel]</dt>
            <dd><code class="chatbot-code">@Item.SourceThreadId</code></dd>
        }
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.ProjectLabel]</dt>
        <dd><code class="chatbot-code">@Item.ProjectId</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.LifecycleStateLabel]</dt>
        <dd><code class="chatbot-code">@Item.LifecycleState</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.ConfidenceLabel]</dt>
        <dd><code class="chatbot-code">@ConfidenceLabel</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.ThresholdBandLabel]</dt>
        <dd><code class="chatbot-code">@Item.ThresholdBand</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.SafeNextActionsLabel]</dt>
        <dd><code class="chatbot-code">@ResolvedSafeNextAction</code></dd>
        @if (Item.SourceReceivedAtUtc is not null)
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.ReceivedAtLabel]</dt>
            <dd><time class="chatbot-code" datetime="@FormatUtc(Item.SourceReceivedAtUtc.Value)">@FormatDisplayUtc(Item.SourceReceivedAtUtc.Value)</time></dd>
        }
        @if (Item.SourceSentAtUtc is not null)
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.SentAtLabel]</dt>
            <dd><time class="chatbot-code" datetime="@FormatUtc(Item.SourceSentAtUtc.Value)">@FormatDisplayUtc(Item.SourceSentAtUtc.Value)</time></dd>
        }
        @if (Item.SourceCreatedAtUtc is not null)
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.CreatedAtLabel]</dt>
            <dd><time class="chatbot-code" datetime="@FormatUtc(Item.SourceCreatedAtUtc.Value)">@FormatDisplayUtc(Item.SourceCreatedAtUtc.Value)</time></dd>
        }
        @if (!string.IsNullOrWhiteSpace(Item.SourceTimezone))
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.SourceTimezoneLabel]</dt>
            <dd><code class="chatbot-code">@Item.SourceTimezone</code></dd>
        }
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.CorrelationIdLabel]</dt>
        <dd><code class="chatbot-code">@Item.CorrelationId</code></dd>
    </dl>
    <div class="chatbot-email-conversation-item__chips" aria-label="@UiText[ChatBotUiTextKey.ProjectConversationMetadata]">
        <ChatBotEvidenceChip State="ChatBotEvidenceState.Available"
                             Text="@Item.SourceProvenance" />
        <ChatBotEvidenceChip State="ChatBotEvidenceState.Redacted"
                             Text="@Item.RedactionState" />
        <ChatBotEvidenceChip State="ChatBotEvidenceState.Available"
                             Text="@ConfidenceLabel" />
        <ChatBotEvidenceChip State="ChatBotEvidenceState.Available"
                             Text="@UiText[ChatBotUiTextKey.WhyProjectOpenAction]"
                             StableId="@($"why-{Item.AssociationId}")"
                             CanOpenEvidence="true"
                             OnActivate="@OpenWhyThisProjectAsync" />
    </div>
</article>

@code {
    [Parameter]
    public ProjectConversationItemModel Item { get; set; } = default!;

    [Parameter]
    public EventCallback<ProjectConversationItemModel> OnWhyThisProjectRequested { get; set; }

    private bool IsSystemDecision => string.Equals(Item.ActorKind, "SystemDecision", StringComparison.Ordinal);

    private ChatBotActorCategory ActorCategory
        => IsSystemDecision
            ? ChatBotActorCategory.BackgroundWorker
            : ChatBotActorCategory.MailboxEvent;

    private string SystemDecisionLabel
        => string.IsNullOrWhiteSpace(Item.DecisionLabel)
            ? UiText[ChatBotUiTextKey.ProjectConversationSystemDecision]
            : UiText.Get(ChatBotUiTextKey.ProjectConversationSystemDecisionTemplate, Item.DecisionLabel);

    private string ResolvedSafeNextAction
        => string.IsNullOrWhiteSpace(Item.SafeNextAction) ? "none" : Item.SafeNextAction;

    private string ConfidenceLabel
        => Formatter.FormatConfidence(Item.ConfidenceScore);

    private string AccessibleLabel
        => IsSystemDecision
            ? UiText.Get(ChatBotUiTextKey.ProjectConversationSystemDecisionAccessible, Item.ActorLabel, Item.LifecycleState)
            : UiText.Get(ChatBotUiTextKey.ProjectConversationEmailItemAccessible, Item.ActorLabel, Item.LifecycleState);

    private static string FormatUtc(DateTimeOffset timestamp)
        => timestamp.ToUniversalTime().ToString("O", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatDisplayUtc(DateTimeOffset timestamp)
        => timestamp.ToUniversalTime().ToString("u", System.Globalization.CultureInfo.InvariantCulture);

    private async Task OpenWhyThisProjectAsync()
        => await OnWhyThisProjectRequested.InvokeAsync(Item).ConfigureAwait(true);
}
