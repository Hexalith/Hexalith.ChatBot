@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotCultureFormatter Formatter
@inject ChatBotUiTextLocalizer UiText

<article class="chatbot-email-conversation-item"
         data-chatbot-conversation-item-kind="@Item.Kind"
         data-chatbot-conversation-item-id="@Item.ItemId"
         tabindex="0"
         aria-label="@AccessibleLabel">
    <FluentCard Class="chatbot-email-conversation-item__surface">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.75rem">
            <FluentStack Orientation="Orientation.Horizontal"
                         VerticalAlignment="VerticalAlignment.Center"
                         HorizontalGap="0.75rem"
                         Class="chatbot-email-conversation-item__header">
                <ChatBotActorBadge Category="@ActorCategory"
                                   DisplayLabel="@Item.ActorLabel" />
                @if (IsSystemDecision)
                {
                    <FluentText As="TextTag.Span" Class="chatbot-email-conversation-item__decision">@SystemDecisionLabel</FluentText>
                }
                <time datetime="@Item.OccurredAt.ToUniversalTime().ToString("O", System.Globalization.CultureInfo.InvariantCulture)"
                      class="chatbot-metadata">
                    @Item.OccurredAt.ToUniversalTime().ToString("u", System.Globalization.CultureInfo.InvariantCulture)
                </time>
            </FluentStack>
    <ChatBotConversationItemStatusSummary ItemId="@Item.ItemId"
                                          Summary="@Item.StatusSummary" />
    <ChatBotConversationItemClassificationBadge ItemId="@Item.ItemId"
                                                Classification="@Item.Classification"
                                                DetectedIntent="@Item.DetectedIntent" />
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem" Class="chatbot-email-conversation-item__metadata">
        @CodeRow(UiText[ChatBotUiTextKey.SourceProvenanceLabel], Item.SourceProvenanceDisplayToken ?? Item.SourceProvenance)
        @CodeRow(UiText[ChatBotUiTextKey.SourceMailboxLabel], Item.SourceMailboxId)
        @CodeRowIf(UiText[ChatBotUiTextKey.SourceProviderMessageLabel], Item.SourceProviderMessageId)
        @CodeRowIf(UiText[ChatBotUiTextKey.InternetMessageLabel], Item.InternetMessageId)
        @CodeRow(UiText[ChatBotUiTextKey.OperationLabel], Item.AssociationId)
        @CodeRow(UiText[ChatBotUiTextKey.ConversationContext], Item.SourceConversationId)
        @CodeRowIf(UiText[ChatBotUiTextKey.SourceThreadLabel], Item.SourceThreadId)
        @CodeRow(UiText[ChatBotUiTextKey.ProjectLabel], Item.ProjectId)
        @CodeRow(UiText[ChatBotUiTextKey.LifecycleStateLabel], Item.LifecycleState)
        @TextRow(UiText[ChatBotUiTextKey.ConfidenceLabel], ConfidenceLabel)
        @CodeRow(UiText[ChatBotUiTextKey.ThresholdBandLabel], Item.ThresholdBand)
        @CodeRow(UiText[ChatBotUiTextKey.SafeNextActionsLabel], ResolvedSafeNextAction)
        @TimeRowIf(UiText[ChatBotUiTextKey.ReceivedAtLabel], Item.SourceReceivedAtUtc)
        @TimeRowIf(UiText[ChatBotUiTextKey.SentAtLabel], Item.SourceSentAtUtc)
        @TimeRowIf(UiText[ChatBotUiTextKey.CreatedAtLabel], Item.SourceCreatedAtUtc)
        @CodeRowIf(UiText[ChatBotUiTextKey.SourceTimezoneLabel], Item.SourceTimezone)
        @CodeRow(UiText[ChatBotUiTextKey.CorrelationIdLabel], Item.CorrelationId)
    </FluentStack>
    <div class="chatbot-email-conversation-item__chips" aria-label="@UiText[ChatBotUiTextKey.ProjectConversationMetadata]">
        <ChatBotEvidenceChip State="ChatBotEvidenceState.Available"
                             Text="@Item.SourceProvenance" />
        <ChatBotEvidenceChip State="ChatBotEvidenceState.Redacted"
                             Text="@Item.RedactionState" />
        <ChatBotEvidenceChip State="ChatBotEvidenceState.Available"
                             Text="@ConfidenceLabel" />
        <ChatBotEvidenceChip State="ChatBotEvidenceState.Available"
                             Text="@UiText[ChatBotUiTextKey.WhyProjectOpenAction]"
                             StableId="@($"why-{Item.AssociationId}")"
                             CanOpenEvidence="true"
                             OnActivate="@OpenWhyThisProjectAsync" />
    </div>
    <ChatBotConversationItemReviewHistory ItemId="@Item.ItemId"
                                          Entries="@Item.ReviewHistory" />
        </FluentStack>
    </FluentCard>
</article>

@code {
    [Parameter]
    public ProjectConversationItemModel Item { get; set; } = default!;

    [Parameter]
    public EventCallback<ProjectConversationItemModel> OnWhyThisProjectRequested { get; set; }

    private bool IsSystemDecision => string.Equals(Item.ActorKind, "SystemDecision", StringComparison.Ordinal);

    private ChatBotActorCategory ActorCategory
        => IsSystemDecision
            ? ChatBotActorCategory.BackgroundWorker
            : ChatBotActorCategory.MailboxEvent;

    private string SystemDecisionLabel
        => string.IsNullOrWhiteSpace(Item.DecisionLabel)
            ? UiText[ChatBotUiTextKey.ProjectConversationSystemDecision]
            : UiText.Get(ChatBotUiTextKey.ProjectConversationSystemDecisionTemplate, Item.DecisionLabel);

    private string ResolvedSafeNextAction
        => string.IsNullOrWhiteSpace(Item.SafeNextAction) ? "none" : Item.SafeNextAction;

    private string ConfidenceLabel
        => Formatter.FormatConfidence(Item.ConfidenceScore);

    private string AccessibleLabel
        => IsSystemDecision
            ? UiText.Get(ChatBotUiTextKey.ProjectConversationSystemDecisionAccessible, Item.ActorLabel, Item.LifecycleState)
            : UiText.Get(ChatBotUiTextKey.ProjectConversationEmailItemAccessible, Item.ActorLabel, Item.LifecycleState);

    private static string FormatUtc(DateTimeOffset timestamp)
        => timestamp.ToUniversalTime().ToString("O", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatDisplayUtc(DateTimeOffset timestamp)
        => timestamp.ToUniversalTime().ToString("u", System.Globalization.CultureInfo.InvariantCulture);

    private async Task OpenWhyThisProjectAsync()
        => await OnWhyThisProjectRequested.InvokeAsync(Item).ConfigureAwait(true);

    // Story 13.4: the former <dl> data dump renders as a structured Fluent
    // key-value block (one row = label FluentText + value). Opaque tokens (ids, refs, versions, enum tokens)
    // keep <code class="chatbot-code">; localized/prose values and timestamps drop the monospace (AC3).
    private static RenderFragment CodeRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <code class="chatbot-code">@value</code>
    </FluentStack>;

    private static RenderFragment TextRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <FluentText>@value</FluentText>
    </FluentStack>;

    private static RenderFragment TimeRow(string label, DateTimeOffset value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <time datetime="@FormatUtc(value)">@FormatDisplayUtc(value)</time>
    </FluentStack>;

    private static RenderFragment? CodeRowIf(string label, string? value)
        => string.IsNullOrWhiteSpace(value) ? null : CodeRow(label, value);

    private static RenderFragment? TimeRowIf(string label, DateTimeOffset? value)
        => value is null ? null : TimeRow(label, value.Value);
}
