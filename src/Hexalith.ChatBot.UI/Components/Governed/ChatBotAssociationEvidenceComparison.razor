@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotUiTextLocalizer UiText
@inject ChatBotCultureFormatter Formatter

<section class="chatbot-association-comparison"
         aria-labelledby="@(ShowHeading ? "association-comparison-title" : null)"
         aria-label="@(ShowHeading ? null : UiText[ChatBotUiTextKey.AssociationReviewComparison])"
         data-chatbot-association-comparison="true">
    @* Story 13.7: when grouped inside a FluentAccordionItem the accordion item Header is the heading, so the
       host suppresses this duplicate inner <h2> (ShowHeading="false") and the section keeps its accessible name
       via aria-label. ShowHeading defaults to true to preserve the standalone behavior. *@
    @if (ShowHeading)
    {
        <h2 id="association-comparison-title" class="chatbot-section-title">
            <FluentText As="TextTag.Span">@UiText[ChatBotUiTextKey.AssociationReviewComparison]</FluentText>
        </h2>
    }

    @if (Candidate is null)
    {
        <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Info"
                             Message="@UiText[ChatBotUiTextKey.AssociationReviewSafeNextAction]"
                             AccessibleLabel="@UiText[ChatBotUiTextKey.AssociationReviewSafeNextAction]"
                             StableId="association-comparison-empty"
                             LiveRegionPoliteness="@ChatBotLiveRegionPoliteness.None" />
    }
    else
    {
        <article class="chatbot-association-comparison__panel" aria-label="@Candidate.DisplayLabel">
            <FluentCard Class="chatbot-association-comparison__surface">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.75rem">
                    <h3 class="chatbot-card-title">
                        <FluentText As="TextTag.Span">@Candidate.DisplayLabel</FluentText>
                    </h3>
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem">
                        @CodeRow(UiText[ChatBotUiTextKey.ProjectLabel], Candidate.ProjectId)
                        @TextRow(UiText[ChatBotUiTextKey.ConfidenceBandWithin], Formatter.FormatConfidence(Candidate.ConfidenceScore))
                        @CodeRow(UiText[ChatBotUiTextKey.ReasonCodesLabel], string.Join(", ", Candidate.ReasonCodes))
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" Class="chatbot-association-evidence-grid">
                        @foreach (AssociationEvidenceModel evidence in Candidate.Evidence)
                        {
                            <ChatBotEvidenceChip Text="@EvidenceText(evidence)"
                                                 State="@evidence.State"
                                                 CanOpenEvidence="true"
                                                 UnavailableReason="@evidence.UnavailableReason"
                                                 StableId="@($"comparison-{Candidate.Rank}-{evidence.Reference}")" />
                        }
                    </FluentStack>
                </FluentStack>
            </FluentCard>
        </article>
    }
</section>

@code {
    [Parameter]
    public AssociationCandidateModel? Candidate { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether the component renders its own titled heading. Set to
    /// <c>false</c> when the component is placed inside a <c>FluentAccordionItem</c> whose Header already
    /// supplies the section title (Story 13.7). Defaults to <c>true</c> to preserve standalone behavior.
    /// </summary>
    [Parameter]
    public bool ShowHeading { get; set; } = true;

    private string EvidenceText(AssociationEvidenceModel evidence)
        => evidence.State is ChatBotEvidenceState.Available
            ? $"{evidence.Kind} {evidence.Reference}"
            : UiText[ChatBotUiTextKey.AssociationReviewEvidenceRestricted];

    // Story 13.4: the former <dl> candidate metadata renders as a structured
    // Fluent key-value block. Project id and reason codes are opaque tokens and keep <code class="chatbot-code">;
    // the formatted confidence band renders as plain FluentText (AC3).
    private static RenderFragment CodeRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <code class="chatbot-code">@value</code>
    </FluentStack>;

    private static RenderFragment TextRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <FluentText>@value</FluentText>
    </FluentStack>;
}
