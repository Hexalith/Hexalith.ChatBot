@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotAnnouncementDeduplicationState AnnouncementDeduplication
@inject ChatBotUiTextLocalizer UiText

@* An id (not only data-chatbot-stable-id) so callers can point aria-describedby / aria-labelledby at this banner.
   Without it every aria-describedby referencing a banner's stable id was a dangling reference. *@
<FluentMessageBar id="@StableId"
                  Class="chatbot-status"
                  Intent="@Intent"
                  AllowDismiss="false"
                  Title="@UiText.FeedbackKindLabel(Kind)"
                  data-chatbot-status="@StatusSlot"
                  data-chatbot-feedback-state="@FeedbackStateValue"
                  data-chatbot-live="@AriaLive"
                  data-chatbot-announcement-key="@ResolvedAnnouncementKey"
                  data-chatbot-repeat-rule="@RepeatRuleValue"
                  data-chatbot-live-announced="@LiveAnnouncedValue"
                  data-chatbot-stable-id="@StableId"
                  role="@AriaRole"
                  aria-live="@AriaLive"
                  aria-atomic="true"
                  aria-label="@ResolvedAccessibleLabel">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @Message
    }
</FluentMessageBar>

@code {
    [Parameter]
    public ChatBotFeedbackKind Kind { get; set; } = ChatBotFeedbackKind.Info;

    [Parameter]
    public string Message { get; set; } = string.Empty;

    [Parameter]
    public string? AccessibleLabel { get; set; }

    [Parameter]
    public string StableId { get; set; } = "status-feedback";

    [Parameter]
    public bool IsTerminalForCurrentUser { get; set; }

    [Parameter]
    public ChatBotFeedbackStateFamily? StateFamily { get; set; }

    [Parameter]
    public ChatBotLiveRegionPoliteness? LiveRegionPoliteness { get; set; }

    [Parameter]
    public string? AnnouncementKey { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private ChatBotStateFeedbackContract? _feedbackContract;

    private bool _shouldAnnounceLiveRegion = true;

    protected override void OnParametersSet()
    {
        _feedbackContract = StateFamily is { } stateFamily ? ChatBotStateFeedbackMatrix.For(stateFamily) : null;

        ChatBotAnnouncementDedupRule repeatRule = _feedbackContract?.DedupRule ?? ChatBotAnnouncementDedupRule.OncePerStableOperationKey;
        _shouldAnnounceLiveRegion = _feedbackContract is null
            || AnnouncementDeduplication.ShouldAnnounce(ResolvedAnnouncementKey, repeatRule);
    }

    private ChatBotLiveRegionPoliteness ResolvedPoliteness
        => LiveRegionPoliteness
            ?? _feedbackContract?.Politeness
            ?? TerminalFallbackPoliteness;

    private string TerminalFallbackAriaRole => IsTerminalForCurrentUser ? "alert" : "status";

    private ChatBotLiveRegionPoliteness TerminalFallbackPoliteness
        => TerminalFallbackAriaRole == "alert"
            ? ChatBotLiveRegionPoliteness.Assertive
            : ChatBotLiveRegionPoliteness.Polite;

    private string? AriaRole
        => EffectivePoliteness switch
        {
            ChatBotLiveRegionPoliteness.Polite => "status",
            ChatBotLiveRegionPoliteness.Assertive => "alert",
            ChatBotLiveRegionPoliteness.None => null,
            _ => throw new ArgumentOutOfRangeException(nameof(ResolvedPoliteness), ResolvedPoliteness, null),
        };

    private string AriaLive
        => EffectivePoliteness switch
        {
            ChatBotLiveRegionPoliteness.Polite => "polite",
            ChatBotLiveRegionPoliteness.Assertive => "assertive",
            ChatBotLiveRegionPoliteness.None => "off",
            _ => throw new ArgumentOutOfRangeException(nameof(ResolvedPoliteness), ResolvedPoliteness, null),
        };

    private ChatBotLiveRegionPoliteness EffectivePoliteness
        => _shouldAnnounceLiveRegion ? ResolvedPoliteness : ChatBotLiveRegionPoliteness.None;

    private string ResolvedAnnouncementKey
        => string.IsNullOrWhiteSpace(AnnouncementKey)
            ? StableId
            : AnnouncementKey;

    private string? FeedbackStateValue => StateFamily?.ToString();

    private string? RepeatRuleValue => _feedbackContract?.DedupRule.ToString();

    private string LiveAnnouncedValue => _shouldAnnounceLiveRegion ? "true" : "false";

    private string StatusSlot => ChatBotGovernedUiText.GetFeedbackKindSlot(Kind);

    private MessageBarIntent Intent
        => Kind switch
        {
            ChatBotFeedbackKind.Info => MessageBarIntent.Info,
            ChatBotFeedbackKind.Warning => MessageBarIntent.Warning,
            ChatBotFeedbackKind.Danger => MessageBarIntent.Error,
            ChatBotFeedbackKind.Success => MessageBarIntent.Success,
            _ => MessageBarIntent.Info,
        };

    private string ResolvedAccessibleLabel
        => string.IsNullOrWhiteSpace(AccessibleLabel)
            ? UiText.StatusAccessibleLabel(Kind, Message)
            : AccessibleLabel;
}
