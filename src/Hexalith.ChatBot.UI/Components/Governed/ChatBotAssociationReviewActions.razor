@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotUiTextLocalizer UiText

<section class="chatbot-association-actions" aria-labelledby="association-actions-title">
    <h2 id="association-actions-title" class="chatbot-section-title">@UiText[ChatBotUiTextKey.SafeNextActionsLabel]</h2>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem" Class="chatbot-field">
        <FluentLabel Class="chatbot-labelled-row" for="association-decision-note">
            @UiText[ChatBotUiTextKey.AssociationReviewDecisionNote]
        </FluentLabel>
        <FluentTextArea Id="association-decision-note"
                        Value="@DecisionNote"
                        ValueChanged="UpdateNote"
                        Immediate="true"
                        aria-label="@UiText[ChatBotUiTextKey.AssociationReviewDecisionNote]"
                        aria-describedby="association-review-validation"
                        aria-invalid="@DecisionNoteInvalidText" />
    </FluentStack>

    @if (!string.IsNullOrWhiteSpace(ValidationErrorCode))
    {
        <ChatBotStatusBanner Kind="@ChatBotFeedbackKind.Warning"
                             Message="@ValidationText"
                             AccessibleLabel="@ValidationText"
                             StableId="association-review-validation"
                             StateFamily="@ChatBotFeedbackStateFamily.ValidationError" />
    }

    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.75rem" Class="chatbot-association-actions__bar">
        @foreach (AssociationReviewActionModel action in Actions)
        {
            <span class="chatbot-association-action-wrap">
                <ChatBotGovernedAction Label="@action.Label"
                                        AccessibleLabel="@action.Label"
                                        StableId="@($"association-action-{action.Code}")"
                                        State="@action.State"
                                        DisabledReason="@action.DisabledReason"
                                        Appearance="ButtonAppearance.Outline"
                                        OnActivate="@(() => PreviewAsync(action.Code))" />
                <span class="chatbot-action-consequence">@action.Consequence</span>
            </span>
        }
    </FluentStack>

    @if (CanCorrect)
    {
        <section class="chatbot-section chatbot-association-correction" aria-labelledby="association-correction-title">
            <h3 id="association-correction-title" class="chatbot-section-title">@UiText[ChatBotUiTextKey.AssociationReviewCorrectionTitle]</h3>
            <ChatBotStatusBanner Kind="@CorrectionStatusKind"
                                 Message="@CorrectionStatusText"
                                 AccessibleLabel="@CorrectionStatusText"
                                 StableId="association-correction-status"
                                 StateFamily="@CorrectionFeedbackState"
                                 LiveRegionPoliteness="@ChatBotLiveRegionPoliteness.Polite" />
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem">
                @TextRow(UiText[ChatBotUiTextKey.AssociationReviewCorrectionAffectedContext], CorrectionAffectedContext)
                @CodeRow(UiText[ChatBotUiTextKey.AssociationReviewCorrectionDownstreamImpact], CorrectionDownstreamImpact)
                @if (PropagationProgressDenominator is > 0)
                {
                    @TextRow(UiText[ChatBotUiTextKey.AssociationReviewCorrectionPropagationProgress], PropagationProgressText)
                }
                @if (!string.IsNullOrWhiteSpace(ResponsibleOwnerRole))
                {
                    @TextRow(UiText[ChatBotUiTextKey.AssociationReviewCorrectionResponsibleOwner], ResponsibleOwnerRole)
                }
                @TextRow(UiText[ChatBotUiTextKey.NextActionLabel], CorrectionSafeNextActionText)
            </FluentStack>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem" Class="chatbot-field">
                <FluentLabel Class="chatbot-labelled-row" for="association-correction-rationale">
                    @UiText[ChatBotUiTextKey.AssociationReviewCorrectionRationale]
                </FluentLabel>
                <FluentTextArea Id="association-correction-rationale"
                                Value="@CorrectionRationale"
                                ValueChanged="UpdateCorrectionRationale"
                                Immediate="true"
                                aria-label="@UiText[ChatBotUiTextKey.AssociationReviewCorrectionRationale]"
                                aria-describedby="association-correction-status"
                                aria-invalid="@CorrectionRationaleInvalidText" />
            </FluentStack>
            <ChatBotGovernedAction Label="@UiText[ChatBotUiTextKey.AssociationReviewCorrectionSubmit]"
                                   AccessibleLabel="@UiText[ChatBotUiTextKey.AssociationReviewCorrectionSubmit]"
                                   StableId="association-correction-submit"
                                   State="@CorrectionActionState"
                                   DisabledReason="@CorrectionDisabledReason"
                                   Appearance="ButtonAppearance.Primary"
                                   OnActivate="@SubmitCorrectionAsync" />
        </section>
    }
</section>

@code {
    private static readonly string[] SpecificDisabledReasonPriority =
    [
        "evidence-expired",
        "not-authorized",
        "projection-pending",
        "already-decided",
        "corrected-context-stale",
        "correction-delayed",
    ];

    [Parameter]
    public bool HasSelectedCandidate { get; set; }

    [Parameter]
    public bool IsTerminal { get; set; }

    [Parameter]
    public bool CanCorrect { get; set; }

    [Parameter]
    public IReadOnlyList<string> DisabledReasons { get; set; } = [];

    [Parameter]
    public string DecisionNote { get; set; } = string.Empty;

    [Parameter]
    public string CorrectionRationale { get; set; } = string.Empty;

    [Parameter]
    public string? CorrectedProjectId { get; set; }

    [Parameter]
    public string? PriorProjectId { get; set; }

    [Parameter]
    public string? DownstreamImpactStatus { get; set; }

    [Parameter]
    public string? PropagationStatus { get; set; }

    [Parameter]
    public int? PropagationProgressNumerator { get; set; }

    [Parameter]
    public int? PropagationProgressDenominator { get; set; }

    [Parameter]
    public DateTimeOffset? PropagationEstimatedCompletionAtUtc { get; set; }

    [Parameter]
    public bool IsCorrectedContextStale { get; set; }

    [Parameter]
    public string? ResponsibleOwnerRole { get; set; }

    [Parameter]
    public string? SafeNextAction { get; set; }

    [Parameter]
    public string? ValidationErrorCode { get; set; }

    [Parameter]
    public EventCallback<string> OnDecisionNoteChanged { get; set; }

    [Parameter]
    public EventCallback<string> OnCorrectionRationaleChanged { get; set; }

    [Parameter]
    public EventCallback<string> OnPreview { get; set; }

    [Parameter]
    public EventCallback OnSubmitCorrection { get; set; }

    private string ValidationText
        => ValidationErrorCode switch
        {
            "candidate-required" => UiText[ChatBotUiTextKey.AssociationReviewValidationCandidateRequired],
            "correction-invalid-lifecycle" => UiText[ChatBotUiTextKey.AssociationReviewCorrectionValidationInvalidLifecycle],
            "correction-target-required" => UiText[ChatBotUiTextKey.AssociationReviewCorrectionValidationTargetRequired],
            "stale-evidence" => UiText[ChatBotUiTextKey.AssociationReviewCorrectionValidationStaleEvidence],
            "association-review-note-too-long" => UiText[ChatBotUiTextKey.AssociationReviewCorrectionValidationRationaleTooLong],
            _ => UiText[ChatBotUiTextKey.AssociationReviewValidationDecisionUnavailable],
        };

    private IReadOnlyList<AssociationReviewActionModel> Actions =>
    [
        Build("choose-candidate", ChatBotUiTextKey.AssociationReviewActionChooseCandidate, ChatBotUiTextKey.AssociationReviewActionChooseCandidateConsequence, requiresCandidate: true),
        Build("reject-all", ChatBotUiTextKey.AssociationReviewActionRejectAll, ChatBotUiTextKey.AssociationReviewActionRejectAllConsequence, requiresCandidate: false),
        Build("defer", ChatBotUiTextKey.AssociationReviewActionDefer, ChatBotUiTextKey.AssociationReviewActionDeferConsequence, requiresCandidate: false),
        Build("mark-needs-review", ChatBotUiTextKey.AssociationReviewActionMarkNeedsReview, ChatBotUiTextKey.AssociationReviewActionMarkNeedsReviewConsequence, requiresCandidate: false),
    ];

    private AssociationReviewActionModel Build(string code, string labelKey, string consequenceKey, bool requiresCandidate)
    {
        string disabledReasonCode = ResolveDisabledReasonCode(requiresCandidate);
        ChatBotGovernedActionState state = disabledReasonCode.Length == 0
            ? ChatBotGovernedActionState.Enabled
            : ChatBotGovernedActionState.DisabledWithReason;

        return new AssociationReviewActionModel(
            code,
            UiText[labelKey],
            UiText[consequenceKey],
            state,
            disabledReasonCode.Length == 0 ? string.Empty : DisabledReasonText(disabledReasonCode));
    }

    private ChatBotGovernedActionState CorrectionActionState
        => ResolveCorrectionDisabledReasonCode() is { Length: > 0 }
            ? ChatBotGovernedActionState.DisabledWithReason
            : ChatBotGovernedActionState.Enabled;

    private string CorrectionDisabledReason
    {
        get
        {
            string code = ResolveCorrectionDisabledReasonCode();
            return code.Length == 0 ? string.Empty : DisabledReasonText(code);
        }
    }

    private string CorrectionAffectedContext
        => string.IsNullOrWhiteSpace(CorrectedProjectId)
            ? UiText[ChatBotUiTextKey.AssociationReviewCorrectionPreviewPending]
            : UiText.Get(ChatBotUiTextKey.AssociationReviewCorrectionPreviewTemplate, CorrectedProjectId);

    private string CorrectionDownstreamImpact
        => string.IsNullOrWhiteSpace(DownstreamImpactStatus)
            ? UiText[ChatBotUiTextKey.AssociationReviewCorrectionProjectionPending]
            : DownstreamImpactStatus;

    private string PropagationProgressText
        => UiText.Get(
            ChatBotUiTextKey.AssociationReviewCorrectionPropagationProgressTemplate,
            (PropagationProgressNumerator ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture),
            (PropagationProgressDenominator ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture));

    private string CorrectionSafeNextActionText
        => SafeNextAction switch
        {
            "wait-for-propagation" => UiText[ChatBotUiTextKey.AssociationReviewCorrectionSafeNextActionWait],
            "escalate-to-operations" => UiText[ChatBotUiTextKey.AssociationReviewCorrectionSafeNextActionEscalate],
            _ => UiText[ChatBotUiTextKey.RecoverySafeNextActionCorrection],
        };

    private ChatBotFeedbackKind CorrectionStatusKind
        => CorrectionStatusTextKey switch
        {
            ChatBotUiTextKey.AssociationReviewCorrectionStatusSuccess => ChatBotFeedbackKind.Success,
            ChatBotUiTextKey.AssociationReviewCorrectionStatusPartial => ChatBotFeedbackKind.Warning,
            ChatBotUiTextKey.AssociationReviewCorrectionStatusBlocked => ChatBotFeedbackKind.Danger,
            ChatBotUiTextKey.AssociationReviewCorrectionStatusDelayed => ChatBotFeedbackKind.Warning,
            _ => ChatBotFeedbackKind.Info,
        };

    private ChatBotFeedbackStateFamily CorrectionFeedbackState
        => CorrectionStatusTextKey switch
        {
            ChatBotUiTextKey.AssociationReviewCorrectionStatusSuccess => ChatBotFeedbackStateFamily.CurrentUserCommandAcceptedProjectionPending,
            ChatBotUiTextKey.AssociationReviewCorrectionStatusBlocked => ChatBotFeedbackStateFamily.BlockedAction,
            ChatBotUiTextKey.AssociationReviewCorrectionStatusDelayed => ChatBotFeedbackStateFamily.DependencyDegraded,
            _ => ChatBotFeedbackStateFamily.DependencyDegraded,
        };

    private string CorrectionStatusText => UiText[CorrectionStatusTextKey];

    private bool IsCorrectionValidationError
        => ValidationErrorCode is "correction-invalid-lifecycle"
            or "correction-target-required"
            or "stale-evidence"
            or "association-review-note-too-long";

    // ARIA state attributes require an explicit "true"/"false" string. A .NET bool would make Blazor drop the
    // attribute entirely when false instead of rendering aria-invalid="false", matching the aria-checked convention.
    private string DecisionNoteInvalidText
        => string.IsNullOrWhiteSpace(ValidationErrorCode) ? "false" : "true";

    private string CorrectionRationaleInvalidText
        => IsCorrectionValidationError ? "true" : "false";

    private string CorrectionStatusTextKey
        => DisabledReasons.Contains("target-unauthorized", StringComparer.Ordinal)
            || DisabledReasons.Contains("policy-blocked", StringComparer.Ordinal)
                ? ChatBotUiTextKey.AssociationReviewCorrectionStatusBlocked
            : string.Equals(PropagationStatus, "delayed", StringComparison.Ordinal)
                || DisabledReasons.Contains("correction-delayed", StringComparer.Ordinal)
                    ? ChatBotUiTextKey.AssociationReviewCorrectionStatusDelayed
            : string.Equals(DownstreamImpactStatus, "pending", StringComparison.Ordinal)
                || string.Equals(DownstreamImpactStatus, "correcting", StringComparison.Ordinal)
                || IsCorrectedContextStale
                    ? ChatBotUiTextKey.AssociationReviewCorrectionStatusPending
            : string.Equals(DownstreamImpactStatus, "preview-only", StringComparison.Ordinal)
                ? ChatBotUiTextKey.AssociationReviewCorrectionStatusPartial
            : string.IsNullOrWhiteSpace(CorrectedProjectId)
                ? ChatBotUiTextKey.AssociationReviewCorrectionStatusProjectionPending
                : ChatBotUiTextKey.AssociationReviewCorrectionStatusSuccess;

    private string ResolveDisabledReasonCode(bool requiresCandidate)
    {
        if (IsTerminal || DisabledReasons.Contains("terminal-state", StringComparer.Ordinal))
        {
            return "terminal-state";
        }

        if (requiresCandidate && !HasSelectedCandidate)
        {
            return "candidate-required";
        }

        return SpecificDisabledReasonPriority.FirstOrDefault(reason => DisabledReasons.Contains(reason, StringComparer.Ordinal))
            ?? string.Empty;
    }

    private string DisabledReasonText(string code)
        => code switch
        {
            "candidate-required" => UiText[ChatBotUiTextKey.AssociationReviewDisabledReasonCandidateRequired],
            "evidence-expired" => UiText[ChatBotUiTextKey.AssociationReviewDisabledReasonEvidenceExpired],
            "not-authorized" => UiText[ChatBotUiTextKey.AssociationReviewDisabledReasonNotAuthorized],
            "projection-pending" => UiText[ChatBotUiTextKey.AssociationReviewDisabledReasonProjectionPending],
            "already-decided" => UiText[ChatBotUiTextKey.AssociationReviewDisabledReasonTerminalState],
            "already-corrected" => UiText[ChatBotUiTextKey.AssociationReviewCorrectionAlreadyCorrected],
            "audit-unavailable" => UiText[ChatBotUiTextKey.AssociationReviewCorrectionAuditUnavailable],
            "corrected-context-stale" => UiText[ChatBotUiTextKey.AssociationReviewCorrectionContextBlocked],
            "correction-delayed" => UiText[ChatBotUiTextKey.AssociationReviewCorrectionStatusDelayed],
            "correction-invalid-lifecycle" => UiText[ChatBotUiTextKey.AssociationReviewCorrectionValidationInvalidLifecycle],
            "correction-target-required" => UiText[ChatBotUiTextKey.AssociationReviewCorrectionValidationTargetRequired],
            "policy-blocked" => UiText[ChatBotUiTextKey.AssociationReviewCorrectionPolicyBlocked],
            "projection-invalidation-unavailable" => UiText[ChatBotUiTextKey.AssociationReviewCorrectionProjectionUnavailable],
            "stale-evidence" => UiText[ChatBotUiTextKey.AssociationReviewCorrectionValidationStaleEvidence],
            "target-unauthorized" => UiText[ChatBotUiTextKey.AssociationReviewCorrectionBlockedTarget],
            "terminal-state" => UiText[ChatBotUiTextKey.AssociationReviewDisabledReasonTerminalState],
            _ => UiText[ChatBotUiTextKey.AssociationReviewDisabledReasonDecisionCommandNotAvailable],
        };

    private string ResolveCorrectionDisabledReasonCode()
    {
        if (!CanCorrect)
        {
            return "correction-invalid-lifecycle";
        }

        if (!HasSelectedCandidate)
        {
            return "correction-target-required";
        }

        return SpecificDisabledReasonPriority
            .Concat(["target-unauthorized", "policy-blocked", "projection-invalidation-unavailable", "audit-unavailable", "stale-evidence", "already-corrected", "corrected-context-stale", "correction-delayed"])
            .FirstOrDefault(reason => DisabledReasons.Contains(reason, StringComparer.Ordinal))
            ?? string.Empty;
    }

    private async Task PreviewAsync(string code)
        => await OnPreview.InvokeAsync(code).ConfigureAwait(true);

    private async Task UpdateNote(string? value)
        => await OnDecisionNoteChanged.InvokeAsync(value ?? string.Empty).ConfigureAwait(true);

    private async Task UpdateCorrectionRationale(string? value)
        => await OnCorrectionRationaleChanged.InvokeAsync(value ?? string.Empty).ConfigureAwait(true);

    private async Task SubmitCorrectionAsync()
        => await OnSubmitCorrection.InvokeAsync().ConfigureAwait(true);

    // Story 13.4: the former correction-panel <dl> renders as a structured
    // Fluent key-value block. The downstream-impact status token keeps <code class="chatbot-code">; the
    // localized affected-context preview, propagation-progress, responsible-owner and safe-next-action
    // values render as plain FluentText (the latter three were already non-monospace) (AC3).
    private static RenderFragment CodeRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <code class="chatbot-code">@value</code>
    </FluentStack>;

    private static RenderFragment TextRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <FluentText>@value</FluentText>
    </FluentStack>;
}
