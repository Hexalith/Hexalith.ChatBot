@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotUiTextLocalizer UiText

<span class="chatbot-chip chatbot-chip--risk"
      data-chatbot-status="warning"
      data-chatbot-risk-class="@RiskClass"
      role="status"
      aria-label="@AccessibleLabel">
    <FluentBadge Appearance="BadgeAppearance.Tint"
                 Color="BadgeColor.Warning"
                 class="chatbot-chip__cue"
                 aria-hidden="true">
        RK
    </FluentBadge>
    <span class="chatbot-chip__label">@UiText.RiskActionClassLabel(RiskClass)</span>
    <span class="chatbot-chip__status">@ResolvedPolicyReason</span>
</span>

@code {
    [Parameter]
    public ChatBotRiskActionClass RiskClass { get; set; }

    [Parameter]
    public string PolicyReason { get; set; } = string.Empty;

    private string ResolvedPolicyReason
        => string.IsNullOrWhiteSpace(PolicyReason)
            ? UiText[ChatBotUiTextKey.RiskPolicyReasonDefault]
            : PolicyReason;

    private string AccessibleLabel => UiText.RiskAccessibleLabel(RiskClass, ResolvedPolicyReason);
}
