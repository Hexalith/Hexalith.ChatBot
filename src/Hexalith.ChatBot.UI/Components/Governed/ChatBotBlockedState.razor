@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotUiTextLocalizer UiText

<FluentMessageBar Class="chatbot-blocked-state"
                  Intent="MessageBarIntent.Error"
                  AllowDismiss="false"
                  data-chatbot-blocked-reason="@Reason"
                  data-chatbot-feedback-state="@FeedbackStateValue"
                  data-chatbot-live="@FeedbackContract.AriaLive"
                  data-chatbot-announcement-key="@AnnouncementKey"
                  data-chatbot-repeat-rule="@FeedbackContract.DedupRule"
                  data-chatbot-stable-id="@StableId"
                  role="@FeedbackContract.AriaRole"
                  aria-live="@FeedbackContract.AriaLive"
                  aria-atomic="true"
                  aria-label="@AccessibleLabel">
    <h2 class="chatbot-section-title">@UiText.BlockedReasonLabel(Reason)</h2>
    <p class="chatbot-body">@ResolvedReasonText</p>
    <p class="chatbot-body"><strong>@UiText[ChatBotUiTextKey.NextActionLabel]</strong> @ResolvedSafeNextAction</p>
</FluentMessageBar>

@code {
    [Parameter]
    public ChatBotBlockedReason Reason { get; set; }

    [Parameter]
    public string ReasonText { get; set; } = string.Empty;

    [Parameter]
    public string SafeNextAction { get; set; } = string.Empty;

    [Parameter]
    public string StableId { get; set; } = "blocked-state";

    [Parameter]
    public bool IsTerminalForCurrentUser { get; set; }

    private ChatBotFeedbackStateFamily FeedbackState
        => IsTerminalForCurrentUser
            ? ChatBotFeedbackStateFamily.TerminalPolicyFailure
            : ChatBotFeedbackStateFamily.BlockedAction;

    private ChatBotStateFeedbackContract FeedbackContract => ChatBotStateFeedbackMatrix.For(FeedbackState);

    private string FeedbackStateValue => FeedbackState.ToString();

    private string AnnouncementKey => $"{StableId}-{Reason}";

    private string ResolvedReasonText
        => string.IsNullOrWhiteSpace(ReasonText)
            ? UiText[ChatBotUiTextKey.BlockedReasonTextDefault]
            : ReasonText;

    private string ResolvedSafeNextAction
        => string.IsNullOrWhiteSpace(SafeNextAction)
            ? UiText[ChatBotUiTextKey.SafeNextActionDefault]
            : SafeNextAction;

    private string AccessibleLabel => UiText.BlockedStateAccessibleLabel(Reason, ResolvedReasonText, ResolvedSafeNextAction);
}
