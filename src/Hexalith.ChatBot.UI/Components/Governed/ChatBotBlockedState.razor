@namespace Hexalith.ChatBot.UI.Components.Governed
@using Hexalith.ChatBot.Contracts.Messages
@inject ChatBotUiTextLocalizer UiText
@inject ChatBotAnnouncementDeduplicationState AnnouncementDeduplication

<FluentMessageBar Class="chatbot-blocked-state"
                  Intent="MessageBarIntent.Error"
                  AllowDismiss="false"
                  data-chatbot-blocked-reason="@Reason"
                  data-chatbot-feedback-state="@FeedbackStateValue"
                  data-chatbot-live="@AriaLive"
                  data-chatbot-live-announced="@(_announce ? "true" : "false")"
                  data-chatbot-announcement-key="@AnnouncementKey"
                  data-chatbot-repeat-rule="@FeedbackContract.DedupRule"
                  data-chatbot-stable-id="@StableId"
                  role="@FeedbackContract.AriaRole"
                  aria-live="@AriaLive"
                  aria-atomic="true"
                  aria-label="@AccessibleLabel">
    <h2 class="chatbot-section-title">@UiText.BlockedReasonLabel(Reason)</h2>
    <p class="chatbot-body">@ResolvedReasonText</p>
    <p class="chatbot-body"><strong>@UiText[ChatBotUiTextKey.NextActionLabel]</strong> @ResolvedSafeNextAction</p>
    @if (CatalogEntry.NextAction is not ChatBotMessageNextActions.None)
    {
        <ChatBotGovernedAction Label="@ResolvedSafeNextAction"
                                 StableId="@($"{StableId}-safe-action")"
                                 CriticalAction="false"
                                 State="@(OnNextAction.HasDelegate ? ChatBotGovernedActionState.Enabled : ChatBotGovernedActionState.DisabledWithReason)"
                                 DisabledReason="@UiText.FailureBlockedReasonLabel(CatalogEntry.DisabledActionReason)"
                                 OnActivate="@OnNextAction" />
    }
</FluentMessageBar>

@code {
    [Parameter]
    public ChatBotBlockedReason Reason { get; set; }

    [Parameter]
    public string ReasonText { get; set; } = string.Empty;

    [Parameter]
    public string? MessageCatalogCode { get; set; }

    [Parameter]
    public string SafeNextAction { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnNextAction { get; set; }

    [Parameter]
    public string StableId { get; set; } = "blocked-state";

    [Parameter]
    public bool IsTerminalForCurrentUser { get; set; }

    private ChatBotFeedbackStateFamily FeedbackState
        => IsTerminalForCurrentUser ||
            (CatalogEntry.IsTerminal && (Reason is ChatBotBlockedReason.Denial || MessageCatalogCode is not null))
            ? ChatBotFeedbackStateFamily.TerminalPolicyFailure
            : ChatBotFeedbackStateFamily.BlockedAction;

    private ChatBotStateFeedbackContract FeedbackContract => ChatBotStateFeedbackMatrix.For(FeedbackState);

    private string FeedbackStateValue => FeedbackState.ToString();

    private string AnnouncementKey => $"{StableId}-{Reason}-{CatalogEntry.Code}";

    private ChatBotMessageCatalogEntry CatalogEntry => UiText.FailureCatalogEntry(
        MessageCatalogCode ?? (Reason switch
        {
            ChatBotBlockedReason.Denial => ChatBotMessageCodes.AuthorizationDenied,
            ChatBotBlockedReason.FailedDependency => ChatBotMessageCodes.DependencyDegraded,
            _ => ChatBotMessageCodes.GenericDenial,
        }));

    private bool _announce;

    protected override void OnParametersSet()
        => _announce = AnnouncementDeduplication.ShouldAnnounce(AnnouncementKey, FeedbackContract.DedupRule);

    private string AriaLive => _announce ? FeedbackContract.AriaLive : "off";

    private string ResolvedReasonText
        => UiText.FailureCatalogReason(CatalogEntry.Code);

    private string ResolvedSafeNextAction
        => UiText.FailureNextActionLabel(CatalogEntry.NextAction);

    private string AccessibleLabel => UiText.BlockedStateAccessibleLabel(Reason, ResolvedReasonText, ResolvedSafeNextAction);
}
