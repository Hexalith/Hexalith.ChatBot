@namespace Hexalith.ChatBot.UI.Components.Governed
@using Microsoft.JSInterop
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inject ChatBotUiTextLocalizer UiText

<div class="chatbot-streaming-stop"
     data-chatbot-streaming="@StreamingValue"
     data-chatbot-touch-target="primary"
     data-chatbot-stable-id="@StableId">
    @* AC4: the Stop/Cancel control occupies a stable, always-mounted focusable slot. It is rendered in the same
       position whether or not a response is streaming (disabled when idle) so keyboard focus never jumps as
       generation starts or stops. *@
    <FluentButton Appearance="ButtonAppearance.Outline"
                  OnClick="@StopAsync"
                  Disabled="@StopDisabled"
                  aria-label="@ResolvedAccessibleLabel"
                  data-chatbot-streaming-stop-active="@StreamingValue">
        @ResolvedLabel
    </FluentButton>
    @if (StopDisabled && !string.IsNullOrWhiteSpace(DisabledReason))
    {
        <span class="chatbot-streaming-stop__disabled-reason chatbot-metadata"
              data-chatbot-stable-id="@($"{StableId}-disabled-reason")">
            @DisabledReason
        </span>
    }
    <span id="@LiveRegionId"
          class="chatbot-visually-hidden"
          role="status"
          aria-live="polite"
          aria-atomic="true">
        @LiveRegionMessage
    </span>
</div>

@code {
    [Parameter]
    public bool IsStreaming { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? DisabledReason { get; set; }

    [Parameter]
    public bool StopVerified { get; set; }

    [Parameter]
    public string StableId { get; set; } = "chatbot-streaming-stop";

    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string AccessibleLabel { get; set; } = string.Empty;

    [Parameter]
    public string StopAnnouncement { get; set; } = string.Empty;

    [Parameter]
    public string? FocusReturnTargetId { get; set; }

    [Parameter]
    public EventCallback OnStop { get; set; }

    private string LiveRegionId => $"{StableId}-announcement";

    private string LiveRegionMessage { get; set; } = string.Empty;

    private bool _announcedVerifiedStop;

    // AC4: "Response stopped" announces only after the user's own server-verified stop. We only treat a verified
    // terminal stop as announceable once we have observed a non-verified (idle / streaming / cancelling) render in
    // this component's lifetime, so navigating to a conversation whose last AI response was historically stopped
    // does not announce on first render.
    private bool _observedActiveBeforeStop;

    private string StreamingValue => IsStreaming ? "true" : "false";

    // Disabled when there is no active generation to stop, or while a cancellation is already in flight.
    private bool StopDisabled => !IsStreaming || Disabled;

    private string ResolvedAccessibleLabel
        => string.IsNullOrWhiteSpace(AccessibleLabel)
            ? UiText[ChatBotUiTextKey.StopResponseAccessible]
            : AccessibleLabel;

    private string ResolvedLabel
        => string.IsNullOrWhiteSpace(Label)
            ? UiText[ChatBotUiTextKey.StopResponse]
            : Label;

    private string ResolvedStopAnnouncement
        => string.IsNullOrWhiteSpace(StopAnnouncement)
            ? UiText[ChatBotUiTextKey.StopResponseAnnouncement]
            : StopAnnouncement;

    private async Task StopAsync()
    {
        if (!IsStreaming || Disabled)
        {
            return;
        }

        LiveRegionMessage = string.Empty;
        await InvokeAsync(StateHasChanged).ConfigureAwait(true);

        await OnStop.InvokeAsync().ConfigureAwait(true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!StopVerified)
        {
            // Any non-verified render (idle, streaming, or cancellation-in-flight) records that a later verified
            // stop is a transition observed within this lifetime, and re-arms the announcement for the next stop.
            _observedActiveBeforeStop = true;
            _announcedVerifiedStop = false;
            return;
        }

        // StopVerified is true: announce only when this is the verified result of a stop we watched go active
        // (never a historically-stopped response surfaced on first navigation).
        if (_observedActiveBeforeStop && !_announcedVerifiedStop)
        {
            _announcedVerifiedStop = true;
            LiveRegionMessage = ResolvedStopAnnouncement;
            await InvokeAsync(StateHasChanged).ConfigureAwait(true);

            if (!string.IsNullOrWhiteSpace(FocusReturnTargetId))
            {
                await JSRuntime.InvokeVoidAsync("HexalithChatBot.focusElementById", FocusReturnTargetId).ConfigureAwait(true);
            }
        }
    }
}
