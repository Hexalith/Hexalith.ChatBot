@namespace Hexalith.ChatBot.UI.Components.Governed
@using Microsoft.JSInterop
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inject ChatBotAnnouncementDeduplicationState AnnouncementDeduplication
@inject ChatBotUiTextLocalizer UiText

<div class="chatbot-streaming-stop"
     data-chatbot-streaming="@StreamingValue"
     data-chatbot-touch-target="primary"
     data-chatbot-stable-id="@StableId">
    @* AC4: the Stop/Cancel control occupies a stable, always-mounted focusable slot. It is rendered in the same
       position whether or not a response is streaming so keyboard focus never jumps as generation starts or stops.
       It is never natively `disabled`: the accessibility floor ("Unavailable governed actions remain focusable,
       expose aria-disabled, link to a reachable reason, and fail closed when activated") requires the reason to be
       reachable by keyboard, and a native disabled button is removed from the tab order entirely. So the button stays
       focusable, advertises aria-disabled, points at its reason via aria-describedby, and fails closed in StopAsync. *@
    <FluentButton Appearance="ButtonAppearance.Outline"
                  Class="chatbot-touch-target-primary"
                  OnClick="@StopAsync"
                  aria-disabled="@(StopUnavailable ? "true" : "false")"
                  aria-describedby="@(StopUnavailable ? ReasonId : null)"
                  aria-label="@ResolvedAccessibleLabel"
                  data-chatbot-streaming-stop-active="@StreamingValue"
                  data-chatbot-streaming-stop-unavailable="@(StopUnavailable ? "true" : "false")">
        @ResolvedLabel
    </FluentButton>
    @if (StopUnavailable)
    {
        <span id="@ReasonId"
              class="chatbot-streaming-stop__disabled-reason chatbot-metadata"
              data-chatbot-stable-id="@($"{StableId}-disabled-reason")">
            @ResolvedUnavailableReason
        </span>
    }
    <span id="@LiveRegionId"
          class="chatbot-visually-hidden"
          role="status"
          aria-live="polite"
          aria-atomic="true">
        @LiveRegionMessage
    </span>
</div>

@code {
    [Parameter]
    public bool IsStreaming { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? DisabledReason { get; set; }

    [Parameter]
    public bool StopVerified { get; set; }

    /// <summary>
    /// Store-owned token identifying a server-verified stop that THIS session requested. Because it lives in the
    /// Fluxor store rather than in a component field, the announcement survives a remount of this control and is
    /// never raised for a historically stopped response or for another actor's stop. [AC4]
    /// </summary>
    [Parameter]
    public string? VerifiedStopAnnouncementGenerationId { get; set; }

    [Parameter]
    public string StableId { get; set; } = "chatbot-streaming-stop";

    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string AccessibleLabel { get; set; } = string.Empty;

    [Parameter]
    public string StopAnnouncement { get; set; } = string.Empty;

    [Parameter]
    public string? FocusReturnTargetId { get; set; }

    [Parameter]
    public EventCallback OnStop { get; set; }

    private string LiveRegionId => $"{StableId}-announcement";

    private string ReasonId => $"{StableId}-disabled-reason";

    private string LiveRegionMessage { get; set; } = string.Empty;

    private string StreamingValue => IsStreaming ? "true" : "false";

    // Unavailable when there is no active generation to stop, or while a cancellation is already in flight.
    private bool StopUnavailable => !IsStreaming || Disabled;

    private string ResolvedAccessibleLabel
        => string.IsNullOrWhiteSpace(AccessibleLabel)
            ? UiText[ChatBotUiTextKey.StopResponseAccessible]
            : AccessibleLabel;

    private string ResolvedLabel
        => string.IsNullOrWhiteSpace(Label)
            ? UiText[ChatBotUiTextKey.StopResponse]
            : Label;

    private string ResolvedStopAnnouncement
        => string.IsNullOrWhiteSpace(StopAnnouncement)
            ? UiText[ChatBotUiTextKey.StopResponseAnnouncement]
            : StopAnnouncement;

    // A reachable reason for every unavailable state, not only for a cancellation already in flight.
    private string ResolvedUnavailableReason
        => string.IsNullOrWhiteSpace(DisabledReason)
            ? UiText[ChatBotUiTextKey.ProjectConversationStreamingIdleReason]
            : DisabledReason;

    private async Task StopAsync()
    {
        // Fail closed on activation: the button stays in the tab order, so an activation while unavailable must be
        // rejected here rather than prevented by a native disabled attribute.
        if (StopUnavailable)
        {
            return;
        }

        LiveRegionMessage = string.Empty;
        await InvokeAsync(StateHasChanged).ConfigureAwait(true);

        await OnStop.InvokeAsync().ConfigureAwait(true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Announce exactly once per server-verified stop that this session requested, then return focus to the
        // composer. Keyed on the store-owned generation token, so a remount between the stop and the verified read
        // (an advisory re-query, a reconnect) can no longer swallow the announcement, and a re-render with the same
        // token can no longer repeat it.
        if (!StopVerified || string.IsNullOrWhiteSpace(VerifiedStopAnnouncementGenerationId))
        {
            return;
        }

        if (!AnnouncementDeduplication.ShouldAnnounce(
            $"ai-response-stop:{VerifiedStopAnnouncementGenerationId}",
            ChatBotAnnouncementDedupRule.OncePerStableOperationKey))
        {
            return;
        }

        LiveRegionMessage = ResolvedStopAnnouncement;
        await InvokeAsync(StateHasChanged).ConfigureAwait(true);

        if (!string.IsNullOrWhiteSpace(FocusReturnTargetId))
        {
            await JSRuntime.InvokeVoidAsync("HexalithChatBot.focusElementById", FocusReturnTargetId).ConfigureAwait(true);
        }
    }
}
