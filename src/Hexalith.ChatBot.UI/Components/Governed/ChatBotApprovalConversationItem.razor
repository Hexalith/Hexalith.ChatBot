@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotUiTextLocalizer UiText
@inject Hexalith.ChatBot.UI.Services.ProjectConversationService ConversationService

<article class="chatbot-approval-conversation-item"
         data-chatbot-conversation-item-kind="@Item.Kind"
         data-chatbot-conversation-item-id="@Item.ItemId"
         tabindex="0"
         aria-label="@AccessibleLabel">
    <FluentCard Class="chatbot-approval-conversation-item__surface">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.75rem">
            <FluentStack Orientation="Orientation.Horizontal"
                         VerticalAlignment="VerticalAlignment.Center"
                         HorizontalGap="0.75rem"
                         Class="chatbot-approval-conversation-item__header">
                <ChatBotEvidenceChip State="@EvidenceState"
                                     Text="@EvidenceSummary"
                                     StableId="@Item.ItemId" />
                <ChatBotRiskChip RiskClass="@RiskActionClass"
                                 PolicyReason="@RiskSummary" />
                @foreach (ApprovalEvidenceChip chip in ApprovalEvidenceChips)
                {
                    <FluentButton Appearance="ButtonAppearance.Subtle"
                                  Type="ButtonType.Button"
                                  Class="chatbot-chip chatbot-chip--evidence"
                                  data-chatbot-approval-evidence-freshness="@chip.Freshness"
                                  aria-disabled="@chip.AriaDisabled"
                                  aria-label="@chip.AccessibleLabel">
                        <FluentText As="TextTag.Span" Class="chatbot-chip__label">@chip.Reference</FluentText>
                        <FluentText As="TextTag.Span" Class="chatbot-chip__status">@UiText.ApprovalEvidenceFreshnessLabel(chip.Freshness)</FluentText>
                    </FluentButton>
                }
                <FluentText As="TextTag.Span" Class="chatbot-approval-conversation-item__status">@UiText.ApprovalStatusLabel(Item.ApprovalStatus)</FluentText>
                <ChatBotActorBadge Category="ChatBotActorCategory.BackgroundWorker"
                                   DisplayLabel="@Item.ActorLabel" />
                <time datetime="@FormatUtc(Item.OccurredAt)"
                      class="chatbot-metadata">
                    @FormatDisplayUtc(Item.OccurredAt)
                </time>
            </FluentStack>
    <ChatBotConversationItemStatusSummary ItemId="@Item.ItemId"
                                          Summary="@Item.StatusSummary" />
    <ChatBotConversationItemClassificationBadge ItemId="@Item.ItemId"
                                                Classification="@Item.Classification"
                                                DetectedIntent="@Item.DetectedIntent" />
    <ChatBotAiActionPreviewSections Item="@Item" />
    <dl class="chatbot-definition-list chatbot-approval-conversation-item__metadata">
        @MetadataLabelValueRow(ChatBotUiTextKey.ApprovalEventKindLabel, UiText.ApprovalEventKindLabel(Item.ApprovalEventKind), Item.ApprovalEventKind)
        @MetadataLabelValueRow(ChatBotUiTextKey.ApprovalStatusLabel, UiText.ApprovalStatusLabel(Item.ApprovalStatus), Item.ApprovalStatus)
        @MetadataLabelValueRow(ChatBotUiTextKey.ApprovalDecisionKindLabel, UiText.ApprovalDecisionKindLabel(Item.ApprovalDecisionKind), Item.ApprovalDecisionKind)
        @MetadataRow(ChatBotUiTextKey.ApprovalIdLabel, Item.ApprovalId)
        @MetadataRow(ChatBotUiTextKey.ApprovalProposalIdLabel, Item.ApprovalProposalId)
        @MetadataRow(ChatBotUiTextKey.ApprovalSourceMessageIdLabel, Item.ApprovalSourceMessageId)
        @MetadataRow(ChatBotUiTextKey.ApprovalSourceConversationItemIdLabel, Item.ApprovalSourceConversationItemId)
        @MetadataRow(ChatBotUiTextKey.ApprovalRequesterLabel, Item.ApprovalRequesterId)
        @MetadataRow(ChatBotUiTextKey.ApprovalRequesterActorTypeLabel, Item.ApprovalRequesterActorType)
        @TimestampRow(ChatBotUiTextKey.ApprovalRequestedAtLabel, Item.ApprovalRequestedAtUtc)
        @MetadataRow(ChatBotUiTextKey.ApprovalCommandNameLabel, Item.ApprovalCommandName)
        @MetadataRow(ChatBotUiTextKey.ApprovalCommandAllowlistVersionLabel, Item.ApprovalCommandAllowlistVersion)
        @MetadataRow(ChatBotUiTextKey.ApprovalRiskClassLabel, DisplayRiskClass)
        @MetadataListRow(ChatBotUiTextKey.ApprovalRiskActionsLabel, DisplayRiskActionClasses)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeRiskInputTupleLabel, Item.ApprovalAiRiskInputTuple)
        @MetadataRow(ChatBotUiTextKey.ApprovalPolicySnapshotLabel, DisplayPolicySnapshotId)
        @MetadataRow(ChatBotUiTextKey.ApprovalPolicyVisibilityLabel, Item.ApprovalPolicySnapshotVisibility)
        @MetadataListRow(ChatBotUiTextKey.ApprovalEvidenceReferencesLabel, Item.ApprovalEvidenceReferences)
        @MetadataListLabelValueRow(ChatBotUiTextKey.ApprovalEvidenceFreshnessLabel, Item.ApprovalEvidenceFreshnessStates.Select(UiText.ApprovalEvidenceFreshnessLabel).ToArray(), Item.ApprovalEvidenceFreshnessStates)
        @MetadataListRow(ChatBotUiTextKey.ApprovalAffectedResourcesLabel, Item.ApprovalAffectedResourceReferences)
        @MetadataListRow(ChatBotUiTextKey.ApprovalRecipientsLabel, Item.ApprovalRecipientReferences)
        @MetadataRow(ChatBotUiTextKey.ApprovalSenderAuthorityLabel, Item.ApprovalSenderAuthorityClass)
        @MetadataLabelValueRow(ChatBotUiTextKey.ApprovalExpectedPostStateLabel, UiText.RedactionStateLabel(Item.ApprovalExpectedPostStateRedactionState), Item.ApprovalExpectedPostStateRedactionState)
        @MetadataLabelValueRow(ChatBotUiTextKey.ApprovalActionSummaryStateLabel, UiText.RedactionStateLabel(Item.ApprovalActionSummaryRedactionState), Item.ApprovalActionSummaryRedactionState)
        @MetadataRow(ChatBotUiTextKey.ApprovalDecisionActorLabel, Item.ApprovalDecisionActorId)
        @MetadataRow(ChatBotUiTextKey.ApprovalDecisionActorTypeLabel, Item.ApprovalDecisionActorType)
        @TimestampRow(ChatBotUiTextKey.ApprovalDecidedAtLabel, Item.ApprovalDecidedAtUtc)
        @MetadataRow(ChatBotUiTextKey.ApprovalAuthorityResultLabel, Item.ApprovalAuthorityResult)
        @MetadataLabelValueRow(ChatBotUiTextKey.ApprovalDisabledReasonLabel, UiText.ApprovalDisabledReasonLabel(Item.ApprovalDisabledReason), Item.ApprovalDisabledReason)
        @MetadataLabelValueRow(ChatBotUiTextKey.ApprovalDecisionRationaleStateLabel, UiText.RedactionStateLabel(Item.ApprovalDecisionRationaleRedactionState), Item.ApprovalDecisionRationaleRedactionState)
        @MetadataRow(ChatBotUiTextKey.ApprovalAuditOperationLabel, DisplayAuditOperationId)
        @MetadataRow(ChatBotUiTextKey.ApprovalAuditStatusLabel, Item.ApprovalAuditStatus)
        @MetadataRow(ChatBotUiTextKey.ApprovalCommandOutcomeStatusLabel, Item.ApprovalCommandOutcomeStatus)
        @TimestampRow(ChatBotUiTextKey.ApprovalOutcomeAtLabel, Item.ApprovalOutcomeAtUtc)
        @MetadataRow(ChatBotUiTextKey.ApprovalProjectedOutcomeLabel, Item.ApprovalProjectedOutcomeItemId)
        @MetadataRow(ChatBotUiTextKey.ApprovalFailureCodeLabel, Item.ApprovalFailureCode)
        @MetadataRow(ChatBotUiTextKey.ApprovalRetryabilityLabel, Item.ApprovalRetryability)
        @MetadataRow(ChatBotUiTextKey.ApprovalSupersedesLabel, Item.SupersedesApprovalId)
        @MetadataRow(ChatBotUiTextKey.ApprovalSupersededByLabel, Item.SupersededByApprovalId)
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.SafeNextActionsLabel]</dt>
        <dd><code class="chatbot-code">@ResolvedSafeNextAction</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.RedactionStateLabel]</dt>
        <dd><code class="chatbot-code">@Item.RedactionState</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.RetentionClassLabel]</dt>
        <dd><code class="chatbot-code">@Item.RetentionClass</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.SchemaVersionLabel]</dt>
        <dd><code class="chatbot-code">@Item.SchemaVersion</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.SourceVersionLabel]</dt>
        <dd><code class="chatbot-code">@Item.SourceVersion</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.CorrelationIdLabel]</dt>
        <dd><code class="chatbot-code">@Item.CorrelationId</code></dd>
    </dl>
    @if (ShouldExplainPolicy)
    {
        <p class="chatbot-approval-conversation-item__reason" tabindex="0">
            <strong>@UiText[ChatBotUiTextKey.WhyUnavailable]</strong> @UiText[ChatBotUiTextKey.ApprovalPolicyUnavailableReason]
        </p>
    }
    @if (ShouldExplainAudit)
    {
        <p class="chatbot-approval-conversation-item__reason" tabindex="0">
            <strong>@UiText[ChatBotUiTextKey.WhyUnavailable]</strong> @UiText[ChatBotUiTextKey.ApprovalAuditUnavailableReason]
        </p>
    }
    @if (IsPendingApproval)
    {
        <div class="chatbot-approval-conversation-item__actions" aria-label="@UiText[ChatBotUiTextKey.ApprovalDecisionKindLabel]">
            <FluentButton Type="ButtonType.Button"
                          Appearance="ButtonAppearance.Primary"
                          aria-disabled="@ApproveAriaDisabled"
                          aria-describedby="@ApproveReasonId"
                          OnClick="ApproveAsync">
                @UiText.ApprovalDecisionKindLabel("approve")
            </FluentButton>
            <FluentButton Type="ButtonType.Button"
                          Appearance="ButtonAppearance.Outline"
                          OnClick="RejectAsync">
                @UiText.ApprovalDecisionKindLabel("reject")
            </FluentButton>
            <FluentButton Type="ButtonType.Button"
                          Appearance="ButtonAppearance.Outline"
                          OnClick="RequestRevisionAsync">
                @UiText.ApprovalDecisionKindLabel("request-revision")
            </FluentButton>
            <FluentButton Type="ButtonType.Button"
                          Appearance="ButtonAppearance.Outline"
                          OnClick="CancelAsync">
                @UiText.ApprovalDecisionKindLabel("cancel")
            </FluentButton>
        </div>
        @if (!CanApprove)
        {
            <p id="@ApproveReasonId" class="chatbot-approval-conversation-item__reason" tabindex="0">
                <strong>@UiText[ChatBotUiTextKey.WhyUnavailable]</strong> @UiText.ApprovalDisabledReasonLabel(ResolvedApproveDisabledReason)
            </p>
        }
    }
    @if (!string.IsNullOrWhiteSpace(DecisionStatus))
    {
        <p class="chatbot-approval-conversation-item__reason"
           tabindex="-1"
           aria-live="@DecisionLiveRegion">
            @DecisionStatus
        </p>
    }
    <ChatBotConversationItemReviewHistory ItemId="@Item.ItemId"
                                          Entries="@Item.ReviewHistory" />
        </FluentStack>
    </FluentCard>
</article>

@code {
    [Parameter]
    public ProjectConversationItemModel Item { get; set; } = default!;

    private string ResolvedSafeNextAction
        => string.IsNullOrWhiteSpace(Item.SafeNextAction) ? "none" : Item.SafeNextAction;

    private string? DecisionStatus { get; set; }

    private string DecisionLiveRegion { get; set; } = "polite";

    private bool IsPendingApproval
        => string.Equals(Item.ApprovalStatus, "pending", StringComparison.OrdinalIgnoreCase);

    private bool CanApprove
        => IsPendingApproval &&
            !string.Equals(ResolvedApproveDisabledReason, "evidence-expired", StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(ResolvedApproveDisabledReason, "insufficient-authority", StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(ResolvedApproveDisabledReason, "corrected-context-invalidated", StringComparison.OrdinalIgnoreCase) &&
            !IsUnavailableReferenceStatus(Item.ApprovalAuditStatus);

    private string ApproveAriaDisabled => CanApprove ? "false" : "true";

    private string ApproveReasonId => $"chatbot-approval-{Item.ItemId}-approve-reason";

    private string ResolvedApproveDisabledReason
        => Item.ApprovalEvidenceFreshnessStates.Any(static state => string.Equals(state, "expired", StringComparison.OrdinalIgnoreCase))
            ? "evidence-expired"
            : string.IsNullOrWhiteSpace(Item.ApprovalDisabledReason) ? "state-not-permitted" : Item.ApprovalDisabledReason;

    private string? DisplayPolicySnapshotId
        => string.Equals(Item.ApprovalPolicySnapshotVisibility, "authorized", StringComparison.OrdinalIgnoreCase)
            ? Item.ApprovalPolicySnapshotId
            : null;

    private string? DisplayAuditOperationId
        => IsUnavailableReferenceStatus(Item.ApprovalAuditStatus) ? null : Item.ApprovalAuditOperationId;

    private string EvidenceSummary
        => Item.ApprovalEvidenceReferences.Count == 0
            ? UiText[ChatBotUiTextKey.DecisionUnavailableValue]
            : string.Join(", ", Item.ApprovalEvidenceReferences);

    private string RiskSummary
        => string.IsNullOrWhiteSpace(DisplayRiskClass)
            ? UiText[ChatBotUiTextKey.RiskPolicyReasonDefault]
            : DisplayRiskClass;

    private string? DisplayRiskClass
        => string.IsNullOrWhiteSpace(Item.ApprovalAiRiskClass) ? Item.ApprovalRiskClass : Item.ApprovalAiRiskClass;

    private IReadOnlyList<string> DisplayRiskActionClasses
        => Item.ApprovalAiRiskActionClasses.Count > 0 ? Item.ApprovalAiRiskActionClasses : Item.ApprovalRiskActionClasses;

    private ChatBotEvidenceState EvidenceState
        => Item.ApprovalEvidenceFreshnessStates.Any(static state => string.Equals(state, "expired", StringComparison.OrdinalIgnoreCase))
            ? ChatBotEvidenceState.Unavailable
            : ChatBotEvidenceState.Available;

    private IReadOnlyList<ApprovalEvidenceChip> ApprovalEvidenceChips
        => Item.ApprovalEvidenceReferences
            .Select((reference, index) =>
            {
                string freshness = index < Item.ApprovalEvidenceFreshnessStates.Count
                    ? Item.ApprovalEvidenceFreshnessStates[index]
                    : "expired";
                string ariaDisabled = string.Equals(freshness, "expired", StringComparison.OrdinalIgnoreCase) ? "true" : "false";
                return new ApprovalEvidenceChip(
                    reference,
                    freshness,
                    ariaDisabled,
                    $"{reference}, {UiText.ApprovalEvidenceFreshnessLabel(freshness)}");
            })
            .ToArray();

    private ChatBotRiskActionClass RiskActionClass
        => DisplayRiskActionClasses.FirstOrDefault(static value => string.Equals(value, "exposes-files", StringComparison.OrdinalIgnoreCase) || string.Equals(value, "file-exposing", StringComparison.OrdinalIgnoreCase)) is not null
            ? ChatBotRiskActionClass.FileExposing
            : DisplayRiskActionClasses.FirstOrDefault(static value => string.Equals(value, "acts-on-behalf", StringComparison.OrdinalIgnoreCase) || string.Equals(value, "participant-representing", StringComparison.OrdinalIgnoreCase)) is not null
                ? ChatBotRiskActionClass.ParticipantRepresenting
                : DisplayRiskActionClasses.FirstOrDefault(static value => string.Equals(value, "invokes-tools", StringComparison.OrdinalIgnoreCase) || string.Equals(value, "tool-invoking", StringComparison.OrdinalIgnoreCase)) is not null
                    ? ChatBotRiskActionClass.ToolInvoking
                    : DisplayRiskActionClasses.FirstOrDefault(static value => string.Equals(value, "creates-tasks", StringComparison.OrdinalIgnoreCase) || string.Equals(value, "task-creating", StringComparison.OrdinalIgnoreCase)) is not null
                        ? ChatBotRiskActionClass.TaskCreating
                        : DisplayRiskActionClasses.FirstOrDefault(static value => string.Equals(value, "sends-external", StringComparison.OrdinalIgnoreCase) || string.Equals(value, "externally-visible", StringComparison.OrdinalIgnoreCase)) is not null
                            ? ChatBotRiskActionClass.ExternallyVisible
                            : ChatBotRiskActionClass.ProjectMutating;

    private string AccessibleLabel
        => UiText.Get(
            ChatBotUiTextKey.ApprovalEventAccessible,
            UiText.ApprovalEventKindLabel(Item.ApprovalEventKind),
            UiText.ApprovalStatusLabel(Item.ApprovalStatus),
            FormatDisplayUtc(Item.OccurredAt));

    private bool ShouldExplainPolicy
        => string.Equals(Item.ApprovalPolicySnapshotVisibility, "redacted", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(Item.ApprovalPolicySnapshotVisibility, "unavailable", StringComparison.OrdinalIgnoreCase);

    private bool ShouldExplainAudit
        => IsUnavailableReferenceStatus(Item.ApprovalAuditStatus);

    private Task ApproveAsync()
        => CanApprove
            ? SubmitDecisionAsync(Hexalith.ChatBot.Contracts.Enums.ApprovalDecisionKind.Approve)
            : BlockApproveAsync();

    private Task RejectAsync()
        => SubmitDecisionAsync(Hexalith.ChatBot.Contracts.Enums.ApprovalDecisionKind.Reject);

    private Task RequestRevisionAsync()
        => SubmitDecisionAsync(Hexalith.ChatBot.Contracts.Enums.ApprovalDecisionKind.RequestRevision);

    private Task CancelAsync()
        => SubmitDecisionAsync(Hexalith.ChatBot.Contracts.Enums.ApprovalDecisionKind.Cancel);

    private Task BlockApproveAsync()
    {
        DecisionLiveRegion = "assertive";
        DecisionStatus = UiText.ApprovalDisabledReasonLabel(ResolvedApproveDisabledReason);
        return Task.CompletedTask;
    }

    private async Task SubmitDecisionAsync(Hexalith.ChatBot.Contracts.Enums.ApprovalDecisionKind decision)
    {
        try
        {
            _ = await ConversationService
                .SubmitApprovalDecisionAsync(Item, decision)
                .ConfigureAwait(false);
            DecisionLiveRegion = "polite";
            DecisionStatus = UiText.ApprovalDecisionKindLabel(decision switch
            {
                Hexalith.ChatBot.Contracts.Enums.ApprovalDecisionKind.Approve => "approve",
                Hexalith.ChatBot.Contracts.Enums.ApprovalDecisionKind.Reject => "reject",
                Hexalith.ChatBot.Contracts.Enums.ApprovalDecisionKind.RequestRevision => "request-revision",
                _ => "cancel",
            });
        }
        catch (InvalidOperationException)
        {
            DecisionLiveRegion = "assertive";
            DecisionStatus = UiText.ApprovalDisabledReasonLabel("projection-pending");
        }
    }

    private static bool IsUnavailableReferenceStatus(string? status)
        => string.Equals(status, "redacted", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(status, "unavailable", StringComparison.OrdinalIgnoreCase);

    private RenderFragment MetadataRow(string labelKey, string? value)
        => builder =>
        {
            if (string.IsNullOrWhiteSpace(value))
            {
                return;
            }

            int sequence = 0;
            builder.OpenElement(sequence++, "dt");
            builder.AddAttribute(sequence++, "class", "chatbot-labelled-row");
            builder.AddContent(sequence++, UiText[labelKey]);
            builder.CloseElement();
            builder.OpenElement(sequence++, "dd");
            builder.OpenElement(sequence++, "code");
            builder.AddAttribute(sequence++, "class", "chatbot-code");
            builder.AddContent(sequence++, value);
            builder.CloseElement();
            builder.CloseElement();
        };

    private RenderFragment MetadataLabelValueRow(string labelKey, string label, string? value)
        => builder =>
        {
            if (string.IsNullOrWhiteSpace(value))
            {
                return;
            }

            int sequence = 0;
            builder.OpenElement(sequence++, "dt");
            builder.AddAttribute(sequence++, "class", "chatbot-labelled-row");
            builder.AddContent(sequence++, UiText[labelKey]);
            builder.CloseElement();
            builder.OpenElement(sequence++, "dd");
            builder.OpenElement(sequence++, "span");
            builder.AddContent(sequence++, label);
            builder.CloseElement();
            builder.AddContent(sequence++, " ");
            builder.OpenElement(sequence++, "code");
            builder.AddAttribute(sequence++, "class", "chatbot-code");
            builder.AddContent(sequence++, value);
            builder.CloseElement();
            builder.CloseElement();
        };

    private RenderFragment MetadataListRow(string labelKey, IReadOnlyList<string> values)
        => builder =>
        {
            if (values.Count == 0)
            {
                return;
            }

            int sequence = 0;
            builder.OpenElement(sequence++, "dt");
            builder.AddAttribute(sequence++, "class", "chatbot-labelled-row");
            builder.AddContent(sequence++, UiText[labelKey]);
            builder.CloseElement();
            builder.OpenElement(sequence++, "dd");
            builder.OpenElement(sequence++, "code");
            builder.AddAttribute(sequence++, "class", "chatbot-code");
            builder.AddContent(sequence++, string.Join(", ", values));
            builder.CloseElement();
            builder.CloseElement();
        };

    private RenderFragment MetadataListLabelValueRow(string labelKey, IReadOnlyList<string> labels, IReadOnlyList<string> values)
        => builder =>
        {
            if (values.Count == 0)
            {
                return;
            }

            int sequence = 0;
            builder.OpenElement(sequence++, "dt");
            builder.AddAttribute(sequence++, "class", "chatbot-labelled-row");
            builder.AddContent(sequence++, UiText[labelKey]);
            builder.CloseElement();
            builder.OpenElement(sequence++, "dd");
            builder.OpenElement(sequence++, "span");
            builder.AddContent(sequence++, string.Join(", ", labels));
            builder.CloseElement();
            builder.AddContent(sequence++, " ");
            builder.OpenElement(sequence++, "code");
            builder.AddAttribute(sequence++, "class", "chatbot-code");
            builder.AddContent(sequence++, string.Join(", ", values));
            builder.CloseElement();
            builder.CloseElement();
        };

    private RenderFragment TimestampRow(string labelKey, DateTimeOffset? value)
        => builder =>
        {
            if (value is null)
            {
                return;
            }

            int sequence = 0;
            builder.OpenElement(sequence++, "dt");
            builder.AddAttribute(sequence++, "class", "chatbot-labelled-row");
            builder.AddContent(sequence++, UiText[labelKey]);
            builder.CloseElement();
            builder.OpenElement(sequence++, "dd");
            builder.OpenElement(sequence++, "time");
            builder.AddAttribute(sequence++, "class", "chatbot-code");
            builder.AddAttribute(sequence++, "datetime", FormatUtc(value.Value));
            builder.AddContent(sequence++, FormatDisplayUtc(value.Value));
            builder.CloseElement();
            builder.CloseElement();
        };

    private static string FormatUtc(DateTimeOffset timestamp)
        => timestamp.ToUniversalTime().ToString("O", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatDisplayUtc(DateTimeOffset timestamp)
        => timestamp.ToUniversalTime().ToString("u", System.Globalization.CultureInfo.InvariantCulture);

    private sealed record ApprovalEvidenceChip(
        string Reference,
        string Freshness,
        string AriaDisabled,
        string AccessibleLabel);
}
