@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotCultureFormatter Formatter
@inject ChatBotUiTextLocalizer UiText

<article class="chatbot-attachment-conversation-item"
         data-chatbot-conversation-item-kind="@Item.Kind"
         data-chatbot-conversation-item-id="@Item.ItemId"
         tabindex="0"
         aria-label="@AccessibleLabel">
    <FluentCard Class="chatbot-attachment-conversation-item__surface">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.75rem">
            <FluentStack Orientation="Orientation.Horizontal"
                         VerticalAlignment="VerticalAlignment.Center"
                         HorizontalGap="0.75rem"
                         Class="chatbot-attachment-conversation-item__header">
                <ChatBotEvidenceChip State="@EvidenceState"
                                     Text="@EvidenceText"
                                     UnavailableReason="@UnavailableReason"
                                     StableId="@($"{Item.ItemId}{ScopeSuffix}-attachment-evidence")" />
                <FluentText As="TextTag.Span" Class="chatbot-attachment-conversation-item__status">@LocalizedStatus</FluentText>
                <ChatBotActorBadge Category="ChatBotActorCategory.MailboxEvent"
                                   DisplayLabel="@UiText[ChatBotUiTextKey.AttachmentActorLabel]" />
                <time datetime="@FormatUtc(Item.OccurredAt)"
                      class="chatbot-metadata">
                    @FormatDisplayUtc(Item.OccurredAt)
                </time>
            </FluentStack>
    <ChatBotConversationItemStatusSummary ItemId="@Item.ItemId"
                                          Summary="@Item.StatusSummary" />
    <ChatBotConversationItemClassificationBadge ItemId="@Item.ItemId"
                                                Classification="@Item.Classification"
                                                DetectedIntent="@Item.DetectedIntent" />
    @if (ShowUnavailableReason)
    {
        <p id="@UnavailableReasonId"
           class="chatbot-attachment-conversation-item__reason"
           tabindex="0">
            <strong>@UiText[ChatBotUiTextKey.WhyUnavailable]</strong> @UnavailableReason
        </p>
    }
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem" Class="chatbot-attachment-conversation-item__metadata">
        @TextRow(UiText[ChatBotUiTextKey.AttachmentDisplayNameLabel], DisplayName)
        @CodeRow(UiText[ChatBotUiTextKey.SourceProviderAttachmentLabel], Item.SourceProviderAttachmentId)
        @CodeRow(UiText[ChatBotUiTextKey.AttachmentContentTypeLabel], MetadataOrUnavailable(Item.AttachmentContentType))
        @TextRow(UiText[ChatBotUiTextKey.AttachmentSizeLabel], SizeLabel)
        @TextRow(UiText[ChatBotUiTextKey.AttachmentCaptureStatusLabel], UiText.AttachmentStatusLabel(Item.AttachmentCaptureStatus))
        @TextRow(UiText[ChatBotUiTextKey.AttachmentStorageStatusLabel], UiText.AttachmentStatusLabel(Item.AttachmentStorageStatus))
        @TextRow(UiText[ChatBotUiTextKey.AttachmentScanStatusLabel], UiText.AttachmentStatusLabel(Item.AttachmentScanStatus))
        @CodeRow(UiText[ChatBotUiTextKey.AttachmentDuplicateStateLabel], MetadataOrUnavailable(Item.AttachmentDuplicateState))
        @CodeRow(UiText[ChatBotUiTextKey.AttachmentRetryStateLabel], MetadataOrUnavailable(Item.AttachmentRetryState))
        @CodeRow(UiText[ChatBotUiTextKey.AttachmentAiEligibilityLabel], MetadataOrUnavailable(Item.AttachmentAiContextEligibility))
        @CodeRowIf(UiText[ChatBotUiTextKey.AttachmentFileReferenceLabel], Item.AttachmentFileId)
        @CodeRowIf(UiText[ChatBotUiTextKey.AttachmentFolderReferenceLabel], Item.AttachmentFolderId)
        @CodeRow(UiText[ChatBotUiTextKey.SourceMailboxLabel], Item.SourceMailboxId)
        @CodeRow(UiText[ChatBotUiTextKey.ConversationContext], Item.SourceConversationId)
        @CodeRowIf(UiText[ChatBotUiTextKey.SourceThreadLabel], Item.SourceThreadId)
        @CodeRow(UiText[ChatBotUiTextKey.OperationLabel], Item.AssociationId)
        @CodeRow(UiText[ChatBotUiTextKey.LifecycleStateLabel], Item.LifecycleState)
        @TextRow(UiText[ChatBotUiTextKey.AttachmentRedactionStateLabel], RedactionLabel)
        @CodeRow(UiText[ChatBotUiTextKey.SafeNextActionsLabel], ResolvedSafeNextAction)
        @CodeRow(UiText[ChatBotUiTextKey.CorrelationIdLabel], Item.CorrelationId)
    </FluentStack>
    <p class="chatbot-attachment-conversation-item__reason" tabindex="0">
        <strong>@ActionReasonLabel</strong> @ActionReasonText
    </p>
    <div class="chatbot-attachment-conversation-item__chips" aria-label="@UiText[ChatBotUiTextKey.ProjectConversationMetadata]">
        <ChatBotEvidenceChip State="@EvidenceState"
                             Text="@EvidenceText"
                             UnavailableReason="@UnavailableReason"
                             StableId="@($"{Item.ItemId}{ScopeSuffix}-attachment-evidence-chip")" />
        <ChatBotEvidenceChip State="ChatBotEvidenceState.Redacted"
                             Text="@RedactionLabel" />
        <ChatBotEvidenceChip State="@StatusEvidenceState"
                             Text="@LocalizedStatus" />
    </div>
    <ChatBotConversationItemReviewHistory ItemId="@Item.ItemId"
                                          Entries="@Item.ReviewHistory" />
        </FluentStack>
    </FluentCard>
</article>

@code {
    [Parameter]
    public ProjectConversationItemModel Item { get; set; } = default!;

    private bool IsRedacted => !string.Equals(Item.AttachmentRedactionState, "Metadata_only", StringComparison.Ordinal) &&
        !string.Equals(Item.AttachmentRedactionState, "metadata_only", StringComparison.Ordinal);

    private bool IsUnavailable => Item.AttachmentScanStatus is "Unavailable" or "Unsafe" or "Failed" or "Rejected" or "Retryable" ||
        Item.AttachmentStorageStatus is "Unavailable" or "Failed" or "Rejected" or "Retryable";

    private bool ShowUnavailableReason => IsRedacted || IsUnavailable;

    private string DisplayName
        => IsRedacted
            ? UiText[ChatBotUiTextKey.AttachmentRedactedDisplayName]
            : string.IsNullOrWhiteSpace(Item.AttachmentDisplayName)
                ? UiText[ChatBotUiTextKey.AttachmentUnavailableDisplayName]
                : Item.AttachmentDisplayName;

    private string EvidenceText => DisplayName;

    private string LocalizedStatus => UiText.AttachmentStatusLabel(Item.AttachmentScanStatus ?? Item.AttachmentStorageStatus ?? Item.AttachmentCaptureStatus);

    private string RedactionLabel
        => IsRedacted ? UiText[ChatBotUiTextKey.AttachmentRedactedState] : UiText[ChatBotUiTextKey.AttachmentMetadataOnlyState];

    private string SizeLabel
        => IsRedacted
            ? RedactedMetadataValue
            : Item.AttachmentSizeInBytes is long size
            ? Formatter.FormatNumber(size)
            : UiText[ChatBotUiTextKey.AttachmentUnavailableValue];

    private string ResolvedSafeNextAction
        => string.IsNullOrWhiteSpace(Item.SafeNextAction) ? "none" : Item.SafeNextAction;

    private bool HasAllowedActions => Item.AttachmentAllowedActions.Count > 0;

    // When actions are available, label them as such; only fall back to the
    // "Why unavailable?" affordance when there are no actions to offer.
    private string ActionReasonLabel
        => HasAllowedActions
            ? UiText[ChatBotUiTextKey.AttachmentAllowedActionsLabel]
            : UiText[ChatBotUiTextKey.WhyUnavailable];

    private string ActionReasonText
        => HasAllowedActions
            ? string.Join(", ", Item.AttachmentAllowedActions)
            : UiText[ChatBotUiTextKey.AttachmentActionsUnavailableReason];

    private string UnavailableReason
        => IsRedacted
            ? UiText[ChatBotUiTextKey.AttachmentRedactedReason]
            : UiText[ChatBotUiTextKey.AttachmentUnavailableReason];

    private ChatBotEvidenceState EvidenceState
        => IsRedacted ? ChatBotEvidenceState.Redacted : IsUnavailable ? ChatBotEvidenceState.Unavailable : ChatBotEvidenceState.Available;

    private ChatBotEvidenceState StatusEvidenceState
        => IsUnavailable ? ChatBotEvidenceState.Unavailable : ChatBotEvidenceState.Available;

    private string AccessibleLabel
        => UiText.Get(ChatBotUiTextKey.ProjectConversationAttachmentItemAccessible, UiText[ChatBotUiTextKey.AttachmentActorLabel], DisplayName, LocalizedStatus, Item.LifecycleState);

    /// <summary>
    /// Optional scope discriminator for element ids and stable ids. The same attachment is rendered both inline in the
    /// conversation stream and in the complementary Files panel; without a scope both renders emit the same DOM ids,
    /// which is invalid HTML and cross-wires every aria reference between the two copies.
    /// </summary>
    [Parameter]
    public string? IdScope { get; set; }

    private string ScopeSuffix => string.IsNullOrWhiteSpace(IdScope) ? string.Empty : $"-{IdScope}";

    private string UnavailableReasonId => $"attachment-{Item.ItemId}{ScopeSuffix}-unavailable-reason";

    private string MetadataOrUnavailable(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? IsRedacted ? RedactedMetadataValue : UiText[ChatBotUiTextKey.AttachmentUnavailableValue]
            : value;

    private string RedactedMetadataValue => UiText[ChatBotUiTextKey.AttachmentRedactedState];

    private static string FormatUtc(DateTimeOffset timestamp)
        => timestamp.ToUniversalTime().ToString("O", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatDisplayUtc(DateTimeOffset timestamp)
        => timestamp.ToUniversalTime().ToString("u", System.Globalization.CultureInfo.InvariantCulture);

    // Story 13.4: the former <dl> attachment metadata dump renders as a
    // structured Fluent key-value block. Opaque tokens (ids, content-type, duplicate/retry/eligibility state
    // tokens, lifecycle/safe-next-action tokens) keep <code class="chatbot-code">; the display name, the
    // formatted size, the localized capture/storage/scan statuses and the redaction label render as plain
    // FluentText (AC3). Blank-guarded rows render nothing.
    private static RenderFragment CodeRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <code class="chatbot-code">@value</code>
    </FluentStack>;

    private static RenderFragment TextRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <FluentText>@value</FluentText>
    </FluentStack>;

    private static RenderFragment? CodeRowIf(string label, string? value)
        => string.IsNullOrWhiteSpace(value) ? null : CodeRow(label, value);
}
