@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotCultureFormatter Formatter
@inject ChatBotUiTextLocalizer UiText

<article class="chatbot-attachment-conversation-item"
         data-chatbot-conversation-item-kind="@Item.Kind"
         data-chatbot-conversation-item-id="@Item.ItemId"
         tabindex="0"
         aria-label="@AccessibleLabel">
    <header class="chatbot-attachment-conversation-item__header">
        <ChatBotEvidenceChip State="@EvidenceState"
                             Text="@EvidenceText"
                             UnavailableReason="@UnavailableReason"
                             StableId="@($"{Item.ItemId}-attachment-evidence")" />
        <span class="chatbot-attachment-conversation-item__status">@LocalizedStatus</span>
        <ChatBotActorBadge Category="ChatBotActorCategory.MailboxEvent"
                           DisplayLabel="@UiText[ChatBotUiTextKey.AttachmentActorLabel]" />
        <time datetime="@FormatUtc(Item.OccurredAt)"
              class="chatbot-metadata">
            @FormatDisplayUtc(Item.OccurredAt)
        </time>
    </header>
    <ChatBotConversationItemStatusSummary ItemId="@Item.ItemId"
                                          Summary="@Item.StatusSummary" />
    <ChatBotConversationItemClassificationBadge ItemId="@Item.ItemId"
                                                Classification="@Item.Classification"
                                                DetectedIntent="@Item.DetectedIntent" />
    @if (ShowUnavailableReason)
    {
        <p id="@UnavailableReasonId"
           class="chatbot-attachment-conversation-item__reason"
           tabindex="0">
            <strong>@UiText[ChatBotUiTextKey.WhyUnavailable]</strong> @UnavailableReason
        </p>
    }
    <dl class="chatbot-definition-list chatbot-attachment-conversation-item__metadata">
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.AttachmentDisplayNameLabel]</dt>
        <dd>@DisplayName</dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.SourceProviderAttachmentLabel]</dt>
        <dd><code class="chatbot-code">@Item.SourceProviderAttachmentId</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.AttachmentContentTypeLabel]</dt>
        <dd><code class="chatbot-code">@MetadataOrUnavailable(Item.AttachmentContentType)</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.AttachmentSizeLabel]</dt>
        <dd><code class="chatbot-code">@SizeLabel</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.AttachmentCaptureStatusLabel]</dt>
        <dd>@UiText.AttachmentStatusLabel(Item.AttachmentCaptureStatus)</dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.AttachmentStorageStatusLabel]</dt>
        <dd>@UiText.AttachmentStatusLabel(Item.AttachmentStorageStatus)</dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.AttachmentScanStatusLabel]</dt>
        <dd>@UiText.AttachmentStatusLabel(Item.AttachmentScanStatus)</dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.AttachmentDuplicateStateLabel]</dt>
        <dd><code class="chatbot-code">@MetadataOrUnavailable(Item.AttachmentDuplicateState)</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.AttachmentRetryStateLabel]</dt>
        <dd><code class="chatbot-code">@MetadataOrUnavailable(Item.AttachmentRetryState)</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.AttachmentAiEligibilityLabel]</dt>
        <dd><code class="chatbot-code">@MetadataOrUnavailable(Item.AttachmentAiContextEligibility)</code></dd>
        @if (!string.IsNullOrWhiteSpace(Item.AttachmentFileId))
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.AttachmentFileReferenceLabel]</dt>
            <dd><code class="chatbot-code">@Item.AttachmentFileId</code></dd>
        }
        @if (!string.IsNullOrWhiteSpace(Item.AttachmentFolderId))
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.AttachmentFolderReferenceLabel]</dt>
            <dd><code class="chatbot-code">@Item.AttachmentFolderId</code></dd>
        }
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.SourceMailboxLabel]</dt>
        <dd><code class="chatbot-code">@Item.SourceMailboxId</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.ConversationContext]</dt>
        <dd><code class="chatbot-code">@Item.SourceConversationId</code></dd>
        @if (!string.IsNullOrWhiteSpace(Item.SourceThreadId))
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.SourceThreadLabel]</dt>
            <dd><code class="chatbot-code">@Item.SourceThreadId</code></dd>
        }
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.OperationLabel]</dt>
        <dd><code class="chatbot-code">@Item.AssociationId</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.LifecycleStateLabel]</dt>
        <dd><code class="chatbot-code">@Item.LifecycleState</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.AttachmentRedactionStateLabel]</dt>
        <dd>@RedactionLabel</dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.SafeNextActionsLabel]</dt>
        <dd><code class="chatbot-code">@ResolvedSafeNextAction</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.CorrelationIdLabel]</dt>
        <dd><code class="chatbot-code">@Item.CorrelationId</code></dd>
    </dl>
    <p class="chatbot-attachment-conversation-item__reason" tabindex="0">
        <strong>@UiText[ChatBotUiTextKey.WhyUnavailable]</strong> @ActionUnavailableReason
    </p>
    <div class="chatbot-attachment-conversation-item__chips" aria-label="@UiText[ChatBotUiTextKey.ProjectConversationMetadata]">
        <ChatBotEvidenceChip State="@EvidenceState"
                             Text="@EvidenceText"
                             UnavailableReason="@UnavailableReason"
                             StableId="@($"{Item.ItemId}-attachment-evidence-chip")" />
        <ChatBotEvidenceChip State="ChatBotEvidenceState.Redacted"
                             Text="@RedactionLabel" />
        <ChatBotEvidenceChip State="@StatusEvidenceState"
                             Text="@LocalizedStatus" />
    </div>
    <ChatBotConversationItemReviewHistory ItemId="@Item.ItemId"
                                          Entries="@Item.ReviewHistory" />
</article>

@code {
    [Parameter]
    public ProjectConversationItemModel Item { get; set; } = default!;

    private bool IsRedacted => !string.Equals(Item.AttachmentRedactionState, "Metadata_only", StringComparison.Ordinal) &&
        !string.Equals(Item.AttachmentRedactionState, "metadata_only", StringComparison.Ordinal);

    private bool IsUnavailable => Item.AttachmentScanStatus is "Unavailable" or "Unsafe" or "Failed" or "Rejected" or "Retryable" ||
        Item.AttachmentStorageStatus is "Unavailable" or "Failed" or "Rejected" or "Retryable";

    private bool ShowUnavailableReason => IsRedacted || IsUnavailable;

    private string DisplayName
        => IsRedacted
            ? UiText[ChatBotUiTextKey.AttachmentRedactedDisplayName]
            : string.IsNullOrWhiteSpace(Item.AttachmentDisplayName)
                ? UiText[ChatBotUiTextKey.AttachmentUnavailableDisplayName]
                : Item.AttachmentDisplayName;

    private string EvidenceText => DisplayName;

    private string LocalizedStatus => UiText.AttachmentStatusLabel(Item.AttachmentScanStatus ?? Item.AttachmentStorageStatus ?? Item.AttachmentCaptureStatus);

    private string RedactionLabel
        => IsRedacted ? UiText[ChatBotUiTextKey.AttachmentRedactedState] : UiText[ChatBotUiTextKey.AttachmentMetadataOnlyState];

    private string SizeLabel
        => IsRedacted
            ? RedactedMetadataValue
            : Item.AttachmentSizeInBytes is long size
            ? Formatter.FormatNumber(size)
            : UiText[ChatBotUiTextKey.AttachmentUnavailableValue];

    private string ResolvedSafeNextAction
        => string.IsNullOrWhiteSpace(Item.SafeNextAction) ? "none" : Item.SafeNextAction;

    private string ActionUnavailableReason
        => Item.AttachmentAllowedActions.Count == 0
            ? UiText[ChatBotUiTextKey.AttachmentActionsUnavailableReason]
            : string.Join(", ", Item.AttachmentAllowedActions);

    private string UnavailableReason
        => IsRedacted
            ? UiText[ChatBotUiTextKey.AttachmentRedactedReason]
            : UiText[ChatBotUiTextKey.AttachmentUnavailableReason];

    private ChatBotEvidenceState EvidenceState
        => IsRedacted ? ChatBotEvidenceState.Redacted : IsUnavailable ? ChatBotEvidenceState.Unavailable : ChatBotEvidenceState.Available;

    private ChatBotEvidenceState StatusEvidenceState
        => IsUnavailable ? ChatBotEvidenceState.Unavailable : ChatBotEvidenceState.Available;

    private string AccessibleLabel
        => UiText.Get(ChatBotUiTextKey.ProjectConversationAttachmentItemAccessible, UiText[ChatBotUiTextKey.AttachmentActorLabel], DisplayName, LocalizedStatus, Item.LifecycleState);

    private string UnavailableReasonId => $"attachment-{Item.ItemId}-unavailable-reason";

    private string MetadataOrUnavailable(string? value)
        => string.IsNullOrWhiteSpace(value)
            ? IsRedacted ? RedactedMetadataValue : UiText[ChatBotUiTextKey.AttachmentUnavailableValue]
            : value;

    private string RedactedMetadataValue => UiText[ChatBotUiTextKey.AttachmentRedactedState];

    private static string FormatUtc(DateTimeOffset timestamp)
        => timestamp.ToUniversalTime().ToString("O", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatDisplayUtc(DateTimeOffset timestamp)
        => timestamp.ToUniversalTime().ToString("u", System.Globalization.CultureInfo.InvariantCulture);
}
