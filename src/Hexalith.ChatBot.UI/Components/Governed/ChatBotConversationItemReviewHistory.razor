@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotUiTextLocalizer UiText

@if (Entries is { Count: > 0 })
{
    <section class="chatbot-conversation-review-history"
             aria-label="@UiText.Get(ChatBotUiTextKey.ReviewHistoryAccessible, ItemId)"
             aria-live="off">
        <FluentCard Class="chatbot-conversation-review-history__surface">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.5rem">
                <FluentText As="TextTag.H3" Class="chatbot-conversation-review-history__title">@UiText[ChatBotUiTextKey.ReviewHistoryTitle]</FluentText>
                <ol class="chatbot-conversation-review-history__list">
                    @foreach (ProjectConversationReviewHistoryEntryModel entry in Entries.OrderBy(static value => value.ReviewedAtUtc))
                    {
                        <li class="chatbot-conversation-review-history__entry">
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.5rem">
                                <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem" Class="chatbot-conversation-review-history__metadata">
                                    @LabelCodeCodeRow(UiText[ChatBotUiTextKey.ReviewHistoryResourceLabel], entry.ReviewedResourceKind, entry.ReviewedResourceId)
                                    @LabelTextCodeRow(UiText[ChatBotUiTextKey.ReviewHistoryActionLabel], UiText.ReviewHistoryActionLabel(entry.ActionCode), entry.ActionCode)
                                    @DecisionRow(entry)
                                    @CodeRowIf(UiText[ChatBotUiTextKey.ReviewHistoryActorKindLabel], entry.ActorKind)
                                    @TextRowIf(UiText[ChatBotUiTextKey.ReviewHistoryActorLabel], entry.ActorLabel)
                                    @TimeRow(UiText[ChatBotUiTextKey.ReviewHistoryTimestampLabel], entry.ReviewedAtUtc)
                                    @CodeRowIf(UiText[ChatBotUiTextKey.SurfaceOriginLabel], entry.SurfaceOrigin)
                                    @CodeRowIf(UiText[ChatBotUiTextKey.CorrelationIdLabel], entry.CorrelationId)
                                    @CodeRowIf(UiText[ChatBotUiTextKey.OperationIdLabel], entry.OperationId)
                                    @LabelTextCodeRow(UiText[ChatBotUiTextKey.RedactionStateLabel], UiText.RedactionStateLabel(entry.RedactionState), entry.RedactionState)
                                    @CodeRow(UiText[ChatBotUiTextKey.ReviewHistoryReasonCodeLabel], entry.ReasonCode)
                                </FluentStack>
                            </FluentStack>
                        </li>
                    }
                </ol>
            </FluentStack>
        </FluentCard>
    </section>
}

@code {
    [Parameter]
    public string ItemId { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<ProjectConversationReviewHistoryEntryModel>? Entries { get; set; }

    // Story 13.4: the former <dl> review-history dump renders as a structured
    // Fluent key-value block per entry. Opaque tokens (resource kind/id, action/decision/reason codes,
    // correlation/operation ids, surface origin, raw redaction-state token) keep <code class="chatbot-code">;
    // the localized action/decision/redaction labels render as plain FluentText and the timestamp drops the
    // monospace while keeping its machine datetime (AC3). Blank-guarded rows return null (render nothing).
    private static RenderFragment CodeRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <code class="chatbot-code">@value</code>
    </FluentStack>;

    private static RenderFragment TextRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <FluentText>@value</FluentText>
    </FluentStack>;

    private static RenderFragment? CodeRowIf(string label, string? value)
        => string.IsNullOrWhiteSpace(value) ? null : CodeRow(label, value);

    private static RenderFragment? TextRowIf(string label, string? value)
        => string.IsNullOrWhiteSpace(value) ? null : TextRow(label, value);

    private static RenderFragment LabelTextCodeRow(string label, string? text, string? token) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <FluentText>@text</FluentText>
        <code class="chatbot-code">@token</code>
    </FluentStack>;

    private static RenderFragment LabelCodeCodeRow(string label, string? first, string? second) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <code class="chatbot-code">@first</code>
        <FluentText>:</FluentText>
        <code class="chatbot-code">@second</code>
    </FluentStack>;

    private static RenderFragment TimeRow(string label, DateTimeOffset value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <time datetime="@FormatUtc(value)">@FormatDisplayUtc(value)</time>
    </FluentStack>;

    private RenderFragment? DecisionRow(ProjectConversationReviewHistoryEntryModel entry)
        => string.IsNullOrWhiteSpace(entry.DecisionCode)
            ? null
            : LabelTextCodeRow(
                UiText[ChatBotUiTextKey.ReviewHistoryDecisionLabel],
                UiText.ReviewHistoryDecisionLabel(entry.ReviewedResourceKind, entry.DecisionCode),
                entry.DecisionCode);

    private static string FormatUtc(DateTimeOffset value)
        => value.UtcDateTime.ToString("O", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatDisplayUtc(DateTimeOffset value)
        => value.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss'Z'", System.Globalization.CultureInfo.InvariantCulture);
}
