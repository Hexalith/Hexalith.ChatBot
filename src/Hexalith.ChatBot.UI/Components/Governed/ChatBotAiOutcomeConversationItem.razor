@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotUiTextLocalizer UiText

<article class="chatbot-ai-outcome-conversation-item"
         data-chatbot-conversation-item-kind="@Item.Kind"
         data-chatbot-conversation-item-id="@Item.ItemId"
         tabindex="0"
         aria-label="@AccessibleLabel">
    <FluentCard Class="chatbot-ai-outcome-conversation-item__surface">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.75rem">
            <FluentStack Orientation="Orientation.Horizontal"
                         VerticalAlignment="VerticalAlignment.Center"
                         HorizontalGap="0.75rem"
                         Class="chatbot-ai-outcome-conversation-item__header">
                <ChatBotEvidenceChip State="ChatBotEvidenceState.Available"
                                     Text="@UiText[ChatBotUiTextKey.AiOutcomeGeneratedLabel]"
                                     StableId="@Item.ItemId" />
                <ChatBotRiskChip RiskClass="@RiskActionClass"
                                 PolicyReason="@RiskSummary" />
                <FluentText As="TextTag.Span" Class="chatbot-ai-outcome-conversation-item__status">@UiText.AiOutcomeStatusLabel(Item.AiOutcomeStatus)</FluentText>
                <ChatBotActorBadge Category="ChatBotActorCategory.AiActor"
                                   DisplayLabel="@ActorLabel" />
                <time datetime="@FormatUtc(Item.OccurredAt)"
                      class="chatbot-metadata">
                    @FormatDisplayUtc(Item.OccurredAt)
                </time>
            </FluentStack>
    <ChatBotConversationItemStatusSummary ItemId="@Item.ItemId"
                                          Summary="@Item.StatusSummary" />
    <ChatBotConversationItemClassificationBadge ItemId="@Item.ItemId"
                                                Classification="@Item.Classification"
                                                DetectedIntent="@Item.DetectedIntent" />
    <ChatBotAiActionPreviewSections Item="@Item" />
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem" Class="chatbot-ai-outcome-conversation-item__metadata">
        @MetadataLabelValueRow(ChatBotUiTextKey.AiOutcomeKindLabel, UiText.AiOutcomeKindLabel(Item.AiOutcomeKind), Item.AiOutcomeKind)
        @MetadataLabelValueRow(ChatBotUiTextKey.AiOutcomeStatusLabel, UiText.AiOutcomeStatusLabel(Item.AiOutcomeStatus), Item.AiOutcomeStatus)
        @MetadataLabelValueRow(ChatBotUiTextKey.AiOutcomeActorTypeLabel, UiText.AiOutcomeActorTypeLabel(Item.AiActorType), Item.AiActorType)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeActorIdLabel, Item.AiActorId)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeProposalIdLabel, Item.AiProposalId)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeRequestIdLabel, Item.AiRequestId)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeRequesterIdLabel, Item.AiRequesterId)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeSourceConversationItemLabel, Item.AiSourceConversationItemId)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeSourceMessageLabel, Item.AiSourceMessageId)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeOperationIdLabel, Item.AiOperationId)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeRiskClassLabel, Item.AiRiskClass)
        @ListRow(ChatBotUiTextKey.AiOutcomeRiskActionsLabel, Item.AiRiskActionClasses)
        @MetadataRow(ChatBotUiTextKey.AiOutcomePolicyReasonLabel, Item.AiPolicyReasonCode)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeClassifierVersionLabel, Item.AiClassifierVersion)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeRiskInputTupleLabel, Item.AiRiskInputTuple)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeRequesterAuthorityLabel, Item.AiRequesterAuthorityClass)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeIndeterminateReasonLabel, Item.AiIndeterminateReason)
        @MetadataRow(ChatBotUiTextKey.AiOutcomePolicySnapshotLabel, Item.AiPolicySnapshotId)
        @MetadataRow(ChatBotUiTextKey.AiOutcomePolicyVisibilityLabel, Item.AiPolicySnapshotVisibility)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeContextPackageLabel, Item.AiContextPackageId)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeContextPackageVersionLabel, Item.AiContextPackageVersion)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeContextRedactionLabel, Item.AiContextRedactionState)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeCommandNameLabel, Item.AiCommandName)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeCommandAllowlistVersionLabel, Item.AiCommandAllowlistVersion)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeApprovalIdLabel, Item.AiApprovalId)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeApprovalStatusLabel, Item.AiApprovalStatus)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeExecutionStatusLabel, Item.AiExecutionStatus)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeExecutionOutcomeCodeLabel, Item.AiExecutionOutcomeCode)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeAuditOperationLabel, DisplayAuditOperationId)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeAuditStatusLabel, Item.AiAuditStatus)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeFailureCodeLabel, Item.AiFailureCode)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeRetryabilityLabel, Item.AiRetryability)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeSupersedesLabel, Item.SupersedesAiOutcomeId)
        @MetadataRow(ChatBotUiTextKey.AiOutcomeSupersededByLabel, Item.SupersededByAiOutcomeId)
        @CodeRow(UiText[ChatBotUiTextKey.AiOutcomeSafeNextActionLabel], ResolvedSafeNextAction)
        @CodeRow(UiText[ChatBotUiTextKey.CorrelationIdLabel], Item.CorrelationId)
    </FluentStack>
    <section class="chatbot-ai-outcome-conversation-item__source-evidence"
             aria-label="@UiText[ChatBotUiTextKey.AiOutcomeSourceEvidenceLabel]"
             data-chatbot-ai-content="source-evidence">
        <p class="chatbot-ai-outcome-conversation-item__reason" tabindex="0">
            <strong>@UiText[ChatBotUiTextKey.AiOutcomeSourceEvidenceLabel]</strong> @UiText[ChatBotUiTextKey.AiOutcomeSourceEvidenceReason]
        </p>
        @if (Item.AiAuthorizedContextReferences is { Count: > 0 })
        {
            <ul class="chatbot-ai-outcome-conversation-item__evidence-list">
                @foreach (string reference in Item.AiAuthorizedContextReferences)
                {
                    <li><ChatBotEvidenceChip State="ChatBotEvidenceState.Available"
                                             Text="@reference"
                                             StableId="@($"{Item.ItemId}-evidence-{reference}")" /></li>
                }
            </ul>
        }
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem">
            @ListRow(ChatBotUiTextKey.AiOutcomeAuthorizedContextLabel, Item.AiAuthorizedContextReferences)
            @ListRow(ChatBotUiTextKey.AiOutcomeExcludedContextLabel, Item.AiExcludedContextReasons)
        </FluentStack>
    </section>
    <details class="chatbot-ai-outcome-conversation-item__generated"
             aria-label="@UiText.Get(ChatBotUiTextKey.AiSummaryAccessible, Item.ItemId)"
             data-chatbot-ai-content="ai-summary">
        <summary>@UiText[ChatBotUiTextKey.AiSummaryLabel]</summary>
        <p class="chatbot-ai-outcome-conversation-item__reason" tabindex="0">
            <strong>@UiText[ChatBotUiTextKey.AiSummaryLabel]</strong> @UiText[ChatBotUiTextKey.AiOutcomeGeneratedDistinctReason]
        </p>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem">
            @MetadataRow(ChatBotUiTextKey.AiOutcomeGeneratedContentVisibilityLabel, Item.AiGeneratedContentVisibility)
            @MetadataRow(ChatBotUiTextKey.AiOutcomeGeneratedSummaryStateLabel, Item.AiGeneratedSummaryRedactionState)
            @TextRowIf(UiText[ChatBotUiTextKey.AiSummaryProvenanceLabel], ProvenanceText)
        </FluentStack>
    </details>
    <p class="chatbot-ai-outcome-conversation-item__reason" tabindex="0">
        <strong>@UiText[ChatBotUiTextKey.AiOutcomeMetadataOnlyReason]</strong>
    </p>
    @if (ShouldExplainAudit)
    {
        <p class="chatbot-ai-outcome-conversation-item__reason" tabindex="0">
            <strong>@UiText[ChatBotUiTextKey.WhyUnavailable]</strong> @UiText[ChatBotUiTextKey.AiOutcomeAuditUnavailableReason]
        </p>
    }
    <ChatBotConversationItemReviewHistory ItemId="@Item.ItemId"
                                          Entries="@Item.ReviewHistory" />
        </FluentStack>
    </FluentCard>
</article>

@code {
    [Parameter]
    public ProjectConversationItemModel Item { get; set; } = default!;

    private string ActorLabel
        => string.IsNullOrWhiteSpace(Item.ActorLabel)
            ? UiText.AiOutcomeActorTypeLabel(Item.AiActorType)
            : Item.ActorLabel;

    private string ResolvedSafeNextAction
        => string.IsNullOrWhiteSpace(Item.AiSafeNextAction)
            ? (string.IsNullOrWhiteSpace(Item.SafeNextAction) ? "none" : Item.SafeNextAction)
            : Item.AiSafeNextAction;

    private string RiskSummary
        => string.IsNullOrWhiteSpace(Item.AiRiskClass)
            ? UiText[ChatBotUiTextKey.AiOutcomeMetadataOnlyReason]
            : Item.AiRiskClass;

    private ChatBotRiskActionClass RiskActionClass
        => Item.AiRiskActionClasses?.FirstOrDefault(static value => string.Equals(value, "exposes-files", StringComparison.OrdinalIgnoreCase) || string.Equals(value, "file-exposing", StringComparison.OrdinalIgnoreCase)) is not null
            ? ChatBotRiskActionClass.FileExposing
            : Item.AiRiskActionClasses?.FirstOrDefault(static value => string.Equals(value, "acts-on-behalf", StringComparison.OrdinalIgnoreCase) || string.Equals(value, "participant-representing", StringComparison.OrdinalIgnoreCase)) is not null
                ? ChatBotRiskActionClass.ParticipantRepresenting
                : Item.AiRiskActionClasses?.FirstOrDefault(static value => string.Equals(value, "invokes-tools", StringComparison.OrdinalIgnoreCase) || string.Equals(value, "tool-invoking", StringComparison.OrdinalIgnoreCase)) is not null
                    ? ChatBotRiskActionClass.ToolInvoking
                    : Item.AiRiskActionClasses?.FirstOrDefault(static value => string.Equals(value, "creates-tasks", StringComparison.OrdinalIgnoreCase) || string.Equals(value, "task-creating", StringComparison.OrdinalIgnoreCase)) is not null
                        ? ChatBotRiskActionClass.TaskCreating
                        : Item.AiRiskActionClasses?.FirstOrDefault(static value => string.Equals(value, "sends-external", StringComparison.OrdinalIgnoreCase) || string.Equals(value, "externally-visible", StringComparison.OrdinalIgnoreCase)) is not null
                            ? ChatBotRiskActionClass.ExternallyVisible
                            : ChatBotRiskActionClass.ProjectMutating;

    private string? DisplayAuditOperationId
        => IsUnavailableReferenceStatus(Item.AiAuditStatus) ? null : Item.AiAuditOperationId;

    private bool ShouldExplainAudit
        => IsUnavailableReferenceStatus(Item.AiAuditStatus);

    private string? ProvenanceText
        => Item.AiSummaryProvenance is null
            ? null
            : UiText.Get(
                ChatBotUiTextKey.AiSummaryProvenanceTemplate,
                Item.AiSummaryProvenance.GeneratedBy,
                Item.AiSummaryProvenance.GeneratedAtUtc?.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss'Z'", System.Globalization.CultureInfo.InvariantCulture)
                    ?? UiText[ChatBotUiTextKey.DecisionUnavailableValue],
                Item.AiSummaryProvenance.SourceEvidenceIds.Count == 0
                    ? UiText[ChatBotUiTextKey.DecisionUnavailableValue]
                    : string.Join(", ", Item.AiSummaryProvenance.SourceEvidenceIds));

    private string AccessibleLabel
        => UiText.Get(
            ChatBotUiTextKey.AiOutcomeAccessible,
            UiText.AiOutcomeActorTypeLabel(Item.AiActorType),
            UiText.AiOutcomeKindLabel(Item.AiOutcomeKind),
            UiText.AiOutcomeStatusLabel(Item.AiOutcomeStatus),
            FormatDisplayUtc(Item.OccurredAt));

    private static bool IsUnavailableReferenceStatus(string? status)
        => string.Equals(status, "redacted", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(status, "unavailable", StringComparison.OrdinalIgnoreCase);

    // Story 13.4: the former <dl> AI-outcome metadata dumps render as
    // structured Fluent key-value blocks. The three label-value rows split a localized label (FluentText)
    // from the opaque token (<code>); every other metadata value is an opaque id / version / status / reason
    // code / raw enum token and keeps <code class="chatbot-code">; the localized AI-summary provenance
    // sentence renders as plain FluentText (AC3). Blank-guarded rows render nothing.
    private RenderFragment? MetadataRow(string labelKey, string? value)
        => string.IsNullOrWhiteSpace(value) ? null : CodeRow(UiText[labelKey], value);

    private RenderFragment? MetadataLabelValueRow(string labelKey, string label, string? value)
        => string.IsNullOrWhiteSpace(value) ? null : LabelTextCodeRow(UiText[labelKey], label, value);

    private RenderFragment? ListRow(string labelKey, IReadOnlyList<string>? values)
        => values is not { Count: > 0 } ? null : CodeRow(UiText[labelKey], string.Join(", ", values));

    private static RenderFragment CodeRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <code class="chatbot-code">@value</code>
    </FluentStack>;

    private static RenderFragment TextRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <FluentText>@value</FluentText>
    </FluentStack>;

    private static RenderFragment? TextRowIf(string label, string? value)
        => string.IsNullOrWhiteSpace(value) ? null : TextRow(label, value);

    private static RenderFragment LabelTextCodeRow(string label, string? text, string? token) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <FluentText>@text</FluentText>
        <code class="chatbot-code">@token</code>
    </FluentStack>;

    private static string FormatUtc(DateTimeOffset value)
        => value.UtcDateTime.ToString("O", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatDisplayUtc(DateTimeOffset value)
        => value.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss'Z'", System.Globalization.CultureInfo.InvariantCulture);
}
