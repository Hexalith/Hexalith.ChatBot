@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotUiTextLocalizer UiText

<section class="chatbot-conversation-shell"
         aria-label="@ResolvedShellLabel"
         data-chatbot-focus-sequence="project-context-primary-complementary">
    @if (ProjectContext is not null)
    {
        <div class="chatbot-conversation-shell__context">
            @ProjectContext
        </div>
    }
    <div class="chatbot-conversation-shell__body">
        <section class="chatbot-conversation-shell__main" role="region" aria-label="@ResolvedMainLabel">
            @MainContent
        </section>
        @if (ComplementaryPanel is not null)
        {
            <aside class="chatbot-conversation-shell__panel" role="complementary" aria-label="@ResolvedComplementaryLabel">
                @ComplementaryPanel
            </aside>
        }
    </div>
</section>

@code {
    [Parameter]
    public string ShellLabel { get; set; } = string.Empty;

    [Parameter]
    public string MainLabel { get; set; } = string.Empty;

    [Parameter]
    public string ComplementaryLabel { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? ProjectContext { get; set; }

    [Parameter]
    public RenderFragment? MainContent { get; set; }

    [Parameter]
    public RenderFragment? ComplementaryPanel { get; set; }

    private string ResolvedShellLabel => ResolveLabel(ShellLabel, ChatBotUiTextKey.ConversationShellLabel);

    private string ResolvedMainLabel => ResolveLabel(MainLabel, ChatBotUiTextKey.ConversationShellMainLabel);

    private string ResolvedComplementaryLabel
    {
        get
        {
            string label = ResolveLabel(ComplementaryLabel, ChatBotUiTextKey.ConversationShellComplementaryLabel);
            return string.Equals(label, ResolvedMainLabel, StringComparison.OrdinalIgnoreCase)
                ? UiText.Get(ChatBotUiTextKey.ConversationShellComplementaryRegionTemplate, label)
                : label;
        }
    }

    private string ResolveLabel(string value, string resourceKey)
        => string.IsNullOrWhiteSpace(value)
            ? UiText[resourceKey]
            : value;
}
