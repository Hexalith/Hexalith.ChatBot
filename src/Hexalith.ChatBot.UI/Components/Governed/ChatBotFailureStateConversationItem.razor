@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotUiTextLocalizer UiText

<article class="chatbot-failure-conversation-item"
         data-chatbot-conversation-item-kind="@Item.Kind"
         data-chatbot-conversation-item-id="@Item.ItemId"
         tabindex="0"
         aria-label="@AccessibleLabel">
    <FluentCard Class="chatbot-failure-conversation-item__surface">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.75rem">
            <FluentStack Orientation="Orientation.Horizontal"
                         VerticalAlignment="VerticalAlignment.Center"
                         HorizontalGap="0.75rem"
                         Class="chatbot-failure-conversation-item__header">
                <ChatBotEvidenceChip State="@EvidenceState"
                                     Text="@UiText.FailureCatalogHeadline(Item.MessageCatalogCode)"
                                     StableId="@Item.ItemId" />
                <ChatBotRiskChip RiskClass="ChatBotRiskActionClass.ProjectMutating"
                                 PolicyReason="@UiText.FailureBlockedReasonLabel(Item.BlockedReason)" />
                <FluentText As="TextTag.Span" Class="chatbot-failure-conversation-item__status">@UiText.FailureStatusLabel(Item.FailureStatus)</FluentText>
                <ChatBotActorBadge Category="ChatBotActorCategory.BackgroundWorker"
                                   DisplayLabel="@Item.ActorLabel" />
                <time datetime="@FormatUtc(Item.OccurredAt)"
                      class="chatbot-metadata">
                    @FormatDisplayUtc(Item.OccurredAt)
                </time>
            </FluentStack>
    <ChatBotConversationItemStatusSummary ItemId="@Item.ItemId"
                                          Summary="@Item.StatusSummary" />
    <ChatBotConversationItemClassificationBadge ItemId="@Item.ItemId"
                                                Classification="@Item.Classification"
                                                DetectedIntent="@Item.DetectedIntent" />
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem" Class="chatbot-failure-conversation-item__metadata">
        @MetadataLabelValueRow(ChatBotUiTextKey.FailureStateKindLabel, UiText.FailureStateKindLabel(Item.FailureStateKind), Item.FailureStateKind)
        @MetadataLabelValueRow(ChatBotUiTextKey.FailureStatusLabel, UiText.FailureStatusLabel(Item.FailureStatus), Item.FailureStatus)
        @MetadataLabelValueRow(ChatBotUiTextKey.FailureCatalogCodeLabel, UiText.FailureCatalogHeadline(Item.MessageCatalogCode), Item.MessageCatalogCode)
        @MetadataRow(ChatBotUiTextKey.FailureCatalogVersionLabel, Item.MessageCatalogVersion)
        @MetadataLabelValueRow(ChatBotUiTextKey.FailureDetailVisibilityLabel, UiText.RedactionStateLabel(Item.MessageDetailVisibility), Item.MessageDetailVisibility)
        @MetadataLabelValueRow(ChatBotUiTextKey.FailureBlockedReasonLabel, UiText.FailureBlockedReasonLabel(Item.BlockedReason), Item.BlockedReason)
        @MetadataRow(ChatBotUiTextKey.FailureCategoryLabel, Item.FailureCategory)
        @MetadataRow(ChatBotUiTextKey.FailureScopeLabel, Item.FailureScope)
        @MetadataRow(ChatBotUiTextKey.FailureReasonCodeLabel, Item.FailureReasonCode)
        @MetadataRow(ChatBotUiTextKey.OperationIdLabel, Item.OperationId)
        @MetadataRow(ChatBotUiTextKey.TaskIdLabel, Item.TaskId)
        @MetadataRow(ChatBotUiTextKey.WorkflowInstanceIdLabel, Item.WorkflowInstanceId)
        @MetadataRow(ChatBotUiTextKey.FailureSupersedesWorkflowLabel, Item.SupersedesWorkflowInstanceId)
        @MetadataRow(ChatBotUiTextKey.FailureSupersededByWorkflowLabel, Item.SupersededByWorkflowInstanceId)
        @MetadataRow(ChatBotUiTextKey.FailureRetryOperationLabel, Item.RetryOperationId)
        @MetadataRow(ChatBotUiTextKey.FailureRetryableLabel, RetryableText)
        @MetadataRow(ChatBotUiTextKey.FailureRetryCountLabel, RetryCountText)
        @TimestampRow(ChatBotUiTextKey.FailureNextRetryAtLabel, Item.NextRetryAtUtc)
        @TimestampRow(ChatBotUiTextKey.FailureLastRetryAtLabel, Item.LastRetryAtUtc)
        @MetadataRow(ChatBotUiTextKey.FailureDuplicateSafetyLabel, Item.DuplicateSafetyState)
        @MetadataRow(ChatBotUiTextKey.FailureDuplicateSuppressionLabel, Item.DuplicateSuppressionId)
        @MetadataRow(ChatBotUiTextKey.FailureDependencyNameLabel, Item.DependencyName)
        @TimestampRow(ChatBotUiTextKey.FailureDegradedUntilLabel, Item.DegradedUntilUtc)
        @MetadataRow(ChatBotUiTextKey.FailureEscalationTargetLabel, Item.EscalationTargetRole)
        @MetadataRow(ChatBotUiTextKey.FailureReprocessWorkflowLabel, Item.ReprocessCreatedWorkflowInstanceId)
        @MetadataRow(ChatBotUiTextKey.FailureAuditOperationLabel, DisplayAuditOperationId)
        @MetadataRow(ChatBotUiTextKey.FailureAuditStatusLabel, Item.AuditStatus)
        @CodeRow(UiText[ChatBotUiTextKey.SafeNextActionsLabel], ResolvedSafeNextAction)
        @CodeRow(UiText[ChatBotUiTextKey.ClientActionLabel], ResolvedClientAction)
        @CodeRow(UiText[ChatBotUiTextKey.CorrelationIdLabel], Item.CorrelationId)
    </FluentStack>
    <p class="chatbot-failure-conversation-item__reason" tabindex="0">
        <strong>@UiText[ChatBotUiTextKey.FailureReasonLabel]</strong> @UiText.FailureCatalogReason(Item.MessageCatalogCode)
    </p>
    <p class="chatbot-failure-conversation-item__reason" tabindex="0">
        <strong>@UiText[ChatBotUiTextKey.FailureNextActionLabel]</strong> @UiText.FailureNextActionLabel(ResolvedSafeNextAction)
    </p>
    <p class="chatbot-failure-conversation-item__reason" tabindex="0">
        <strong>@UiText[ChatBotUiTextKey.FailureDuplicateSafetyLabel]</strong> @UiText[ChatBotUiTextKey.FailureDuplicateSafetyReason]
    </p>
    @if (ShouldExplainAudit)
    {
        <p class="chatbot-failure-conversation-item__reason" tabindex="0">
            <strong>@UiText[ChatBotUiTextKey.WhyUnavailable]</strong> @UiText[ChatBotUiTextKey.FailureAuditUnavailableReason]
        </p>
    }
    @if (IsTerminal)
    {
        <p class="chatbot-failure-conversation-item__reason" tabindex="0">
            <strong>@UiText[ChatBotUiTextKey.FailureTerminalRuleLabel]</strong> @UiText[ChatBotUiTextKey.FailureTerminalRuleReason]
        </p>
    }
    <ChatBotConversationItemReviewHistory ItemId="@Item.ItemId"
                                          Entries="@Item.ReviewHistory" />
        </FluentStack>
    </FluentCard>
</article>

@code {
    [Parameter]
    public ProjectConversationItemModel Item { get; set; } = default!;

    private string ResolvedSafeNextAction
        => string.IsNullOrWhiteSpace(Item.SafeNextAction) ? "none" : Item.SafeNextAction;

    private string ResolvedClientAction
        => string.IsNullOrWhiteSpace(Item.ClientAction) ? ResolvedSafeNextAction : Item.ClientAction;

    private string? DisplayAuditOperationId
        => IsUnavailableReferenceStatus(Item.AuditStatus) ? null : Item.AuditOperationId;

    private string? RetryableText
        => Item.Retryable is null ? null : (Item.Retryable.Value ? UiText[ChatBotUiTextKey.YesLabel] : UiText[ChatBotUiTextKey.NoLabel]);

    private string? RetryCountText
        => Item.RetryCount is null && Item.MaxRetryCount is null
            ? null
            : UiText.Get(ChatBotUiTextKey.FailureRetryCountTemplate, Item.RetryCount ?? 0, Item.MaxRetryCount ?? 0);

    private ChatBotEvidenceState EvidenceState
        => string.Equals(Item.MessageDetailVisibility, "metadata_only", StringComparison.OrdinalIgnoreCase)
            ? ChatBotEvidenceState.Available
            : ChatBotEvidenceState.Unavailable;

    private bool ShouldExplainAudit
        => IsUnavailableReferenceStatus(Item.AuditStatus);

    private bool IsTerminal
        => string.Equals(Item.FailureStatus, "terminal", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(Item.FailureStateKind, "terminal-failure", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(Item.FailureStateKind, "reprocess-created", StringComparison.OrdinalIgnoreCase);

    private string AccessibleLabel
        => UiText.Get(
            ChatBotUiTextKey.FailureStateAccessible,
            UiText.FailureCatalogHeadline(Item.MessageCatalogCode),
            UiText.FailureStatusLabel(Item.FailureStatus),
            FormatDisplayUtc(Item.OccurredAt));

    private static bool IsUnavailableReferenceStatus(string? status)
        => string.Equals(status, "redacted", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(status, "unavailable", StringComparison.OrdinalIgnoreCase);

    // Story 13.4: the former monospace <dl> data dump renders as a structured Fluent key-value block (one
    // row = label FluentText + value). Opaque tokens (ids, codes, versions, raw enum tokens) keep
    // <code class="chatbot-code">; localized/prose values render as plain FluentText and timestamps drop the
    // monospace while keeping the machine datetime (AC3). The blank/null guards return null (render nothing).
    private RenderFragment? MetadataRow(string labelKey, string? value)
        => string.IsNullOrWhiteSpace(value) ? null : CodeRow(UiText[labelKey], value);

    private RenderFragment? MetadataLabelValueRow(string labelKey, string label, string? value)
        => string.IsNullOrWhiteSpace(value) ? null : LabelTextCodeRow(UiText[labelKey], label, value);

    private RenderFragment? TimestampRow(string labelKey, DateTimeOffset? value)
        => value is null ? null : TimeRow(UiText[labelKey], value.Value);

    private static RenderFragment CodeRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <code class="chatbot-code">@value</code>
    </FluentStack>;

    private static RenderFragment LabelTextCodeRow(string label, string? text, string? token) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <FluentText>@text</FluentText>
        <code class="chatbot-code">@token</code>
    </FluentStack>;

    private static RenderFragment TimeRow(string label, DateTimeOffset value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <time datetime="@FormatUtc(value)">@FormatDisplayUtc(value)</time>
    </FluentStack>;

    private static string FormatUtc(DateTimeOffset value)
        => value.UtcDateTime.ToString("O", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatDisplayUtc(DateTimeOffset value)
        => value.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss'Z'", System.Globalization.CultureInfo.InvariantCulture);
}
