@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotCultureFormatter Formatter
@inject ChatBotUiTextLocalizer UiText

<article class="chatbot-decision-conversation-item"
         data-chatbot-conversation-item-kind="@Item.Kind"
         data-chatbot-conversation-item-id="@Item.ItemId"
         tabindex="0"
         aria-label="@AccessibleLabel">
    <header class="chatbot-decision-conversation-item__header">
        <ChatBotEvidenceChip State="ChatBotEvidenceState.Available"
                             Text="@EvidenceSummary" />
        <ChatBotEvidenceChip State="ChatBotEvidenceState.Available"
                             Text="@ConfidenceLabel" />
        <span class="chatbot-decision-conversation-item__status">@Item.LifecycleState</span>
        <ChatBotActorBadge Category="ChatBotActorCategory.BackgroundWorker"
                           DisplayLabel="@Item.ActorLabel" />
        <time datetime="@FormatUtc(Item.OccurredAt)"
              class="chatbot-metadata">
            @FormatDisplayUtc(Item.OccurredAt)
        </time>
    </header>
    <dl class="chatbot-definition-list chatbot-decision-conversation-item__metadata">
        @if (!string.IsNullOrWhiteSpace(Item.DecisionKind))
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.DecisionKindLabel]</dt>
            <dd><span>@UiText.DecisionKindLabel(Item.DecisionKind)</span> <code class="chatbot-code">@Item.DecisionKind</code></dd>
        }
        @if (!string.IsNullOrWhiteSpace(Item.CorrectionKind))
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.CorrectionKindLabel]</dt>
            <dd><span>@UiText.CorrectionKindLabel(Item.CorrectionKind)</span> <code class="chatbot-code">@Item.CorrectionKind</code></dd>
        }
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.LifecycleStateLabel]</dt>
        <dd><code class="chatbot-code">@Item.LifecycleState</code></dd>
        @if (!string.IsNullOrWhiteSpace(Item.DecisionActorId))
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.DecisionActorLabel]</dt>
            <dd><code class="chatbot-code">@Item.DecisionActorId</code></dd>
        }
        @if (!string.IsNullOrWhiteSpace(Item.DecisionActorType))
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.DecisionActorTypeLabel]</dt>
            <dd><code class="chatbot-code">@Item.DecisionActorType</code></dd>
        }
        @if (Item.DecidedAtUtc is not null)
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.DecidedAtLabel]</dt>
            <dd><time class="chatbot-code" datetime="@FormatUtc(Item.DecidedAtUtc.Value)">@FormatDisplayUtc(Item.DecidedAtUtc.Value)</time></dd>
        }
        @if (!string.IsNullOrWhiteSpace(Item.CorrectionActorId))
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.CorrectionActorLabel]</dt>
            <dd><code class="chatbot-code">@Item.CorrectionActorId</code></dd>
        }
        @if (!string.IsNullOrWhiteSpace(Item.CorrectionActorType))
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.CorrectionActorTypeLabel]</dt>
            <dd><code class="chatbot-code">@Item.CorrectionActorType</code></dd>
        }
        @if (Item.CorrectedAtUtc is not null)
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.CorrectedAtLabel]</dt>
            <dd><time class="chatbot-code" datetime="@FormatUtc(Item.CorrectedAtUtc.Value)">@FormatDisplayUtc(Item.CorrectedAtUtc.Value)</time></dd>
        }
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.ConfidenceLabel]</dt>
        <dd><code class="chatbot-code">@ConfidenceLabel</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.ThresholdBandLabel]</dt>
        <dd><code class="chatbot-code">@Item.ThresholdBand</code></dd>
        @MetadataRow(ChatBotUiTextKey.SurfaceOriginLabel, Item.SurfaceOrigin)
        @MetadataRow(ChatBotUiTextKey.PolicySnapshotVersionLabel, Item.PolicySnapshotVersion)
        @MetadataListRow(ChatBotUiTextKey.EvidenceReferenceSummaryLabel, Item.EvidenceReferenceSummary)
        @MetadataRow(ChatBotUiTextKey.PriorProjectIdLabel, Item.PriorProjectId)
        @MetadataRow(ChatBotUiTextKey.CorrectedProjectIdLabel, Item.CorrectedProjectId)
        @MetadataRow(ChatBotUiTextKey.PredecessorAssociationIdLabel, Item.PredecessorAssociationId)
        @MetadataRow(ChatBotUiTextKey.SupersedesAssociationIdLabel, Item.SupersedesAssociationId)
        @MetadataRow(ChatBotUiTextKey.SupersededByAssociationIdLabel, Item.SupersededByAssociationId)
        @MetadataRow(ChatBotUiTextKey.DownstreamImpactStatusLabel, Item.DownstreamImpactStatus)
        @MetadataRow(ChatBotUiTextKey.CorrectionIdLabel, Item.CorrectionId)
        @MetadataRow(ChatBotUiTextKey.WorkflowInstanceIdLabel, Item.WorkflowInstanceId)
        @MetadataListRow(ChatBotUiTextKey.RequiredStoreKeysLabel, Item.RequiredStoreKeys)
        @MetadataListRow(ChatBotUiTextKey.CompletedStoreKeysLabel, Item.CompletedStoreKeys)
        @MetadataListRow(ChatBotUiTextKey.FailedStoreKeysLabel, Item.FailedStoreKeys)
        @if (Item.PropagationProgressNumerator is not null || Item.PropagationProgressDenominator is not null)
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.PropagationProgressLabel]</dt>
            <dd><code class="chatbot-code">@PropagationProgress</code></dd>
        }
        @TimestampRow(ChatBotUiTextKey.PropagationStartedAtLabel, Item.PropagationStartedAtUtc)
        @TimestampRow(ChatBotUiTextKey.PropagationCompletedAtLabel, Item.PropagationCompletedAtUtc)
        @TimestampRow(ChatBotUiTextKey.PropagationEstimatedCompletionLabel, Item.PropagationEstimatedCompletionAtUtc)
        @MetadataRow(ChatBotUiTextKey.PropagationStatusLabel, Item.PropagationStatus)
        @if (Item.IsCorrectedContextStale is not null)
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.CorrectedContextStaleLabel]</dt>
            <dd><code class="chatbot-code">@Item.IsCorrectedContextStale.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)</code></dd>
        }
        @MetadataRow(ChatBotUiTextKey.ResponsibleOwnerRoleLabel, Item.ResponsibleOwnerRole)
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.SafeNextActionsLabel]</dt>
        <dd><code class="chatbot-code">@ResolvedSafeNextAction</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.RedactionStateLabel]</dt>
        <dd><code class="chatbot-code">@Item.RedactionState</code></dd>
        @if (!string.IsNullOrWhiteSpace(Item.DecisionNoteRedactionState))
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.DecisionNoteStateLabel]</dt>
            <dd><span>@UiText.RedactionStateLabel(Item.DecisionNoteRedactionState)</span> <code class="chatbot-code">@Item.DecisionNoteRedactionState</code></dd>
        }
        @if (!string.IsNullOrWhiteSpace(Item.CorrectionRationaleRedactionState))
        {
            <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.CorrectionRationaleStateLabel]</dt>
            <dd><span>@UiText.RedactionStateLabel(Item.CorrectionRationaleRedactionState)</span> <code class="chatbot-code">@Item.CorrectionRationaleRedactionState</code></dd>
        }
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.RetentionClassLabel]</dt>
        <dd><code class="chatbot-code">@Item.RetentionClass</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.SchemaVersionLabel]</dt>
        <dd><code class="chatbot-code">@Item.SchemaVersion</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.SourceVersionLabel]</dt>
        <dd><code class="chatbot-code">@Item.SourceVersion</code></dd>
        <dt class="chatbot-labelled-row">@UiText[ChatBotUiTextKey.CorrelationIdLabel]</dt>
        <dd><code class="chatbot-code">@Item.CorrelationId</code></dd>
    </dl>
    @if (ShouldExplainUnavailable)
    {
        <p class="chatbot-decision-conversation-item__reason" tabindex="0">
            <strong>@UiText[ChatBotUiTextKey.WhyUnavailable]</strong> @UiText[ChatBotUiTextKey.DecisionUnavailableReason]
        </p>
    }
</article>

@code {
    [Parameter]
    public ProjectConversationItemModel Item { get; set; } = default!;

    private string ConfidenceLabel
        => Formatter.FormatConfidence(Item.ConfidenceScore);

    private string ResolvedSafeNextAction
        => string.IsNullOrWhiteSpace(Item.SafeNextAction) ? "none" : Item.SafeNextAction;

    private string EvidenceSummary
        => Item.EvidenceReferenceSummary.Count == 0
            ? UiText[ChatBotUiTextKey.DecisionUnavailableValue]
            : string.Join(", ", Item.EvidenceReferenceSummary);

    private string PropagationProgress
        => UiText.Get(
            ChatBotUiTextKey.PropagationProgressTemplate,
            Item.PropagationProgressNumerator?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0",
            Item.PropagationProgressDenominator?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0");

    private string AccessibleLabel
        => UiText.Get(
            ChatBotUiTextKey.ProjectConversationDecisionItemAccessible,
            DecisionSummary,
            Item.LifecycleState,
            FormatDisplayUtc(Item.OccurredAt));

    private string DecisionSummary
        => !string.IsNullOrWhiteSpace(Item.DecisionKind)
            ? UiText.DecisionKindLabel(Item.DecisionKind)
            : UiText.CorrectionKindLabel(Item.CorrectionKind);

    private bool ShouldExplainUnavailable
        => string.Equals(Item.DecisionNoteRedactionState, "Unavailable", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(Item.CorrectionRationaleRedactionState, "Unavailable", StringComparison.OrdinalIgnoreCase);

    private RenderFragment MetadataRow(string labelKey, string? value)
        => builder =>
        {
            if (string.IsNullOrWhiteSpace(value))
            {
                return;
            }

            int sequence = 0;
            builder.OpenElement(sequence++, "dt");
            builder.AddAttribute(sequence++, "class", "chatbot-labelled-row");
            builder.AddContent(sequence++, UiText[labelKey]);
            builder.CloseElement();
            builder.OpenElement(sequence++, "dd");
            builder.OpenElement(sequence++, "code");
            builder.AddAttribute(sequence++, "class", "chatbot-code");
            builder.AddContent(sequence++, value);
            builder.CloseElement();
            builder.CloseElement();
        };

    private RenderFragment MetadataListRow(string labelKey, IReadOnlyList<string> values)
        => builder =>
        {
            if (values.Count == 0)
            {
                return;
            }

            int sequence = 0;
            builder.OpenElement(sequence++, "dt");
            builder.AddAttribute(sequence++, "class", "chatbot-labelled-row");
            builder.AddContent(sequence++, UiText[labelKey]);
            builder.CloseElement();
            builder.OpenElement(sequence++, "dd");
            builder.OpenElement(sequence++, "code");
            builder.AddAttribute(sequence++, "class", "chatbot-code");
            builder.AddContent(sequence++, string.Join(", ", values));
            builder.CloseElement();
            builder.CloseElement();
        };

    private RenderFragment TimestampRow(string labelKey, DateTimeOffset? value)
        => builder =>
        {
            if (value is null)
            {
                return;
            }

            int sequence = 0;
            builder.OpenElement(sequence++, "dt");
            builder.AddAttribute(sequence++, "class", "chatbot-labelled-row");
            builder.AddContent(sequence++, UiText[labelKey]);
            builder.CloseElement();
            builder.OpenElement(sequence++, "dd");
            builder.OpenElement(sequence++, "time");
            builder.AddAttribute(sequence++, "class", "chatbot-code");
            builder.AddAttribute(sequence++, "datetime", FormatUtc(value.Value));
            builder.AddContent(sequence++, FormatDisplayUtc(value.Value));
            builder.CloseElement();
            builder.CloseElement();
        };

    private static string FormatUtc(DateTimeOffset timestamp)
        => timestamp.ToUniversalTime().ToString("O", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatDisplayUtc(DateTimeOffset timestamp)
        => timestamp.ToUniversalTime().ToString("u", System.Globalization.CultureInfo.InvariantCulture);
}
