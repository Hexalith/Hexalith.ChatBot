@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotCultureFormatter Formatter
@inject ChatBotUiTextLocalizer UiText

<article class="chatbot-decision-conversation-item"
         data-chatbot-conversation-item-kind="@Item.Kind"
         data-chatbot-conversation-item-id="@Item.ItemId"
         tabindex="0"
         aria-label="@AccessibleLabel">
    <FluentCard Class="chatbot-decision-conversation-item__surface">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.75rem">
            <FluentStack Orientation="Orientation.Horizontal"
                         VerticalAlignment="VerticalAlignment.Center"
                         HorizontalGap="0.75rem"
                         Class="chatbot-decision-conversation-item__header">
                <ChatBotEvidenceChip State="ChatBotEvidenceState.Available"
                                     Text="@EvidenceSummary" />
                <ChatBotEvidenceChip State="ChatBotEvidenceState.Available"
                                     Text="@ConfidenceLabel" />
                <ChatBotEvidenceChip State="ChatBotEvidenceState.Available"
                                     Text="@UiText[ChatBotUiTextKey.WhyProjectOpenAction]"
                                     StableId="@($"why-{Item.AssociationId}")"
                                     CanOpenEvidence="true"
                                     OnActivate="@OpenWhyThisProjectAsync" />
                <FluentText As="TextTag.Span" Class="chatbot-decision-conversation-item__status">@Item.LifecycleState</FluentText>
                <ChatBotActorBadge Category="ChatBotActorCategory.BackgroundWorker"
                                   DisplayLabel="@Item.ActorLabel" />
                <time datetime="@FormatUtc(Item.OccurredAt)"
                      class="chatbot-metadata">
                    @FormatDisplayUtc(Item.OccurredAt)
                </time>
            </FluentStack>
    <ChatBotConversationItemStatusSummary ItemId="@Item.ItemId"
                                          Summary="@Item.StatusSummary" />
    <ChatBotConversationItemClassificationBadge ItemId="@Item.ItemId"
                                                Classification="@Item.Classification"
                                                DetectedIntent="@Item.DetectedIntent" />
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem" Class="chatbot-decision-conversation-item__metadata">
        @if (!string.IsNullOrWhiteSpace(Item.DecisionKind))
        {
            @LabelTextCodeRow(UiText[ChatBotUiTextKey.DecisionKindLabel], UiText.DecisionKindLabel(Item.DecisionKind), Item.DecisionKind)
        }
        @if (!string.IsNullOrWhiteSpace(Item.CorrectionKind))
        {
            @LabelTextCodeRow(UiText[ChatBotUiTextKey.CorrectionKindLabel], UiText.CorrectionKindLabel(Item.CorrectionKind), Item.CorrectionKind)
        }
        @CodeRow(UiText[ChatBotUiTextKey.LifecycleStateLabel], Item.LifecycleState)
        @MetadataRow(ChatBotUiTextKey.DecisionActorLabel, Item.DecisionActorId)
        @MetadataRow(ChatBotUiTextKey.DecisionActorTypeLabel, Item.DecisionActorType)
        @TimestampRow(ChatBotUiTextKey.DecidedAtLabel, Item.DecidedAtUtc)
        @MetadataRow(ChatBotUiTextKey.CorrectionActorLabel, Item.CorrectionActorId)
        @MetadataRow(ChatBotUiTextKey.CorrectionActorTypeLabel, Item.CorrectionActorType)
        @TimestampRow(ChatBotUiTextKey.CorrectedAtLabel, Item.CorrectedAtUtc)
        @TextRow(UiText[ChatBotUiTextKey.ConfidenceLabel], ConfidenceLabel)
        @CodeRow(UiText[ChatBotUiTextKey.ThresholdBandLabel], Item.ThresholdBand)
        @MetadataRow(ChatBotUiTextKey.SurfaceOriginLabel, Item.SurfaceOrigin)
        @MetadataRow(ChatBotUiTextKey.PolicySnapshotVersionLabel, Item.PolicySnapshotVersion)
        @MetadataListRow(ChatBotUiTextKey.EvidenceReferenceSummaryLabel, Item.EvidenceReferenceSummary)
        @MetadataRow(ChatBotUiTextKey.PriorProjectIdLabel, Item.PriorProjectId)
        @MetadataRow(ChatBotUiTextKey.CorrectedProjectIdLabel, Item.CorrectedProjectId)
        @MetadataRow(ChatBotUiTextKey.PredecessorAssociationIdLabel, Item.PredecessorAssociationId)
        @MetadataRow(ChatBotUiTextKey.SupersedesAssociationIdLabel, Item.SupersedesAssociationId)
        @MetadataRow(ChatBotUiTextKey.SupersededByAssociationIdLabel, Item.SupersededByAssociationId)
        @MetadataRow(ChatBotUiTextKey.DownstreamImpactStatusLabel, Item.DownstreamImpactStatus)
        @MetadataRow(ChatBotUiTextKey.CorrectionIdLabel, Item.CorrectionId)
        @MetadataRow(ChatBotUiTextKey.WorkflowInstanceIdLabel, Item.WorkflowInstanceId)
        @MetadataListRow(ChatBotUiTextKey.RequiredStoreKeysLabel, Item.RequiredStoreKeys)
        @MetadataListRow(ChatBotUiTextKey.CompletedStoreKeysLabel, Item.CompletedStoreKeys)
        @MetadataListRow(ChatBotUiTextKey.FailedStoreKeysLabel, Item.FailedStoreKeys)
        @if (Item.PropagationProgressNumerator is not null || Item.PropagationProgressDenominator is not null)
        {
            @TextRow(UiText[ChatBotUiTextKey.PropagationProgressLabel], PropagationProgress)
        }
        @TimestampRow(ChatBotUiTextKey.PropagationStartedAtLabel, Item.PropagationStartedAtUtc)
        @TimestampRow(ChatBotUiTextKey.PropagationCompletedAtLabel, Item.PropagationCompletedAtUtc)
        @TimestampRow(ChatBotUiTextKey.PropagationEstimatedCompletionLabel, Item.PropagationEstimatedCompletionAtUtc)
        @MetadataRow(ChatBotUiTextKey.PropagationStatusLabel, Item.PropagationStatus)
        @if (Item.IsCorrectedContextStale is not null)
        {
            @TextRow(UiText[ChatBotUiTextKey.CorrectedContextStaleLabel], Item.IsCorrectedContextStale.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))
        }
        @MetadataRow(ChatBotUiTextKey.ResponsibleOwnerRoleLabel, Item.ResponsibleOwnerRole)
        @CodeRow(UiText[ChatBotUiTextKey.SafeNextActionsLabel], ResolvedSafeNextAction)
        @CodeRow(UiText[ChatBotUiTextKey.RedactionStateLabel], Item.RedactionState)
        @if (!string.IsNullOrWhiteSpace(Item.DecisionNoteRedactionState))
        {
            @LabelTextCodeRow(UiText[ChatBotUiTextKey.DecisionNoteStateLabel], UiText.RedactionStateLabel(Item.DecisionNoteRedactionState), Item.DecisionNoteRedactionState)
        }
        @if (!string.IsNullOrWhiteSpace(Item.CorrectionRationaleRedactionState))
        {
            @LabelTextCodeRow(UiText[ChatBotUiTextKey.CorrectionRationaleStateLabel], UiText.RedactionStateLabel(Item.CorrectionRationaleRedactionState), Item.CorrectionRationaleRedactionState)
        }
        @CodeRow(UiText[ChatBotUiTextKey.RetentionClassLabel], Item.RetentionClass)
        @CodeRow(UiText[ChatBotUiTextKey.SchemaVersionLabel], Item.SchemaVersion)
        @CodeRow(UiText[ChatBotUiTextKey.SourceVersionLabel], Item.SourceVersion.ToString(System.Globalization.CultureInfo.InvariantCulture))
        @CodeRow(UiText[ChatBotUiTextKey.CorrelationIdLabel], Item.CorrelationId)
    </FluentStack>
    @if (ShouldExplainUnavailable)
    {
        <p class="chatbot-decision-conversation-item__reason" tabindex="0">
            <strong>@UiText[ChatBotUiTextKey.WhyUnavailable]</strong> @UiText[ChatBotUiTextKey.DecisionUnavailableReason]
        </p>
    }
    <ChatBotConversationItemReviewHistory ItemId="@Item.ItemId"
                                          Entries="@Item.ReviewHistory" />
        </FluentStack>
    </FluentCard>
</article>

@code {
    [Parameter]
    public ProjectConversationItemModel Item { get; set; } = default!;

    [Parameter]
    public EventCallback<ProjectConversationItemModel> OnWhyThisProjectRequested { get; set; }

    private string ConfidenceLabel
        => Formatter.FormatConfidence(Item.ConfidenceScore);

    private string ResolvedSafeNextAction
        => string.IsNullOrWhiteSpace(Item.SafeNextAction) ? "none" : Item.SafeNextAction;

    private string EvidenceSummary
        => Item.EvidenceReferenceSummary.Count == 0
            ? UiText[ChatBotUiTextKey.DecisionUnavailableValue]
            : string.Join(", ", Item.EvidenceReferenceSummary);

    private string PropagationProgress
        => UiText.Get(
            ChatBotUiTextKey.PropagationProgressTemplate,
            Item.PropagationProgressNumerator?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0",
            Item.PropagationProgressDenominator?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0");

    private string AccessibleLabel
        => UiText.Get(
            ChatBotUiTextKey.ProjectConversationDecisionItemAccessible,
            DecisionSummary,
            Item.LifecycleState,
            FormatDisplayUtc(Item.OccurredAt));

    private string DecisionSummary
        => !string.IsNullOrWhiteSpace(Item.DecisionKind)
            ? UiText.DecisionKindLabel(Item.DecisionKind)
            : UiText.CorrectionKindLabel(Item.CorrectionKind);

    private bool ShouldExplainUnavailable
        => string.Equals(Item.DecisionNoteRedactionState, "Unavailable", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(Item.CorrectionRationaleRedactionState, "Unavailable", StringComparison.OrdinalIgnoreCase);

    // Story 13.4: the former <dl> decision metadata dump renders as a
    // structured Fluent key-value block. Opaque tokens (ids, actor/version/threshold/policy/retention/schema
    // tokens, reason/store keys, status tokens, raw redaction-state token) keep <code class="chatbot-code">;
    // the localized decision/correction-kind and note/rationale-state labels pair a plain FluentText label
    // with the raw <code> token; the formatted confidence, the propagation-progress sentence and the
    // corrected-context-stale boolean render as plain FluentText, and timestamps drop the monospace while
    // keeping their machine datetime (AC3). Blank-guarded rows render nothing.
    private RenderFragment? MetadataRow(string labelKey, string? value)
        => string.IsNullOrWhiteSpace(value) ? null : CodeRow(UiText[labelKey], value);

    private RenderFragment? MetadataListRow(string labelKey, IReadOnlyList<string> values)
        => values.Count == 0 ? null : CodeRow(UiText[labelKey], string.Join(", ", values));

    private RenderFragment? TimestampRow(string labelKey, DateTimeOffset? value)
        => value is null ? null : TimeRow(UiText[labelKey], value.Value);

    private static RenderFragment CodeRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <code class="chatbot-code">@value</code>
    </FluentStack>;

    private static RenderFragment TextRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <FluentText>@value</FluentText>
    </FluentStack>;

    private static RenderFragment LabelTextCodeRow(string label, string? text, string? token) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <FluentText>@text</FluentText>
        <code class="chatbot-code">@token</code>
    </FluentStack>;

    private static RenderFragment TimeRow(string label, DateTimeOffset value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <time datetime="@FormatUtc(value)">@FormatDisplayUtc(value)</time>
    </FluentStack>;

    private static string FormatUtc(DateTimeOffset timestamp)
        => timestamp.ToUniversalTime().ToString("O", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatDisplayUtc(DateTimeOffset timestamp)
        => timestamp.ToUniversalTime().ToString("u", System.Globalization.CultureInfo.InvariantCulture);

    private async Task OpenWhyThisProjectAsync()
        => await OnWhyThisProjectRequested.InvokeAsync(Item).ConfigureAwait(true);
}
