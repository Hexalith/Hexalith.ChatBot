@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotAnnouncementDeduplicationState AnnouncementDeduplication
@inject ChatBotUiTextLocalizer UiText

<section class="chatbot-conversation-status-summary"
         aria-label="@UiText.Get(ChatBotUiTextKey.StatusSummaryAccessible, ItemId)"
         aria-live="off">
    <FluentCard Class="chatbot-conversation-status-summary__surface">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.5rem">
            <FluentText As="TextTag.H3" Class="chatbot-conversation-status-summary__title">@UiText[ChatBotUiTextKey.StatusSummaryTitle]</FluentText>
            <ul class="chatbot-conversation-status-summary__list">
                @foreach (ProjectConversationItemStatusFacetModel facet in _visibleFacets)
                {
                    <li class="chatbot-conversation-status-summary__facet"
                        data-chatbot-status-domain="@facet.Domain"
                        data-chatbot-health="@facet.Health">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.5rem">
                            <FluentStack Orientation="Orientation.Horizontal"
                                         VerticalAlignment="VerticalAlignment.Center"
                                         HorizontalGap="0.5rem"
                                         Class="chatbot-conversation-status-summary__facet-header">
                                <FluentText As="TextTag.Span" Class="chatbot-conversation-status-summary__domain">@UiText.StatusSummaryFacetLabel(facet.Domain)</FluentText>
                                <FluentText As="TextTag.Span" Class="chatbot-conversation-status-summary__health">@UiText.StatusSummaryHealthLabel(facet.Health)</FluentText>
                            </FluentStack>
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem" Class="chatbot-conversation-status-summary__metadata">
                                @CodeRowIf(UiText[ChatBotUiTextKey.StatusSummarySourceStateLabel], facet.SourceState)
                                @LabelTextCodeRow(UiText[ChatBotUiTextKey.SafeNextActionsLabel], UiText.StatusSummaryNextActionLabel(facet.SafeNextAction), facet.SafeNextAction)
                                @CodeRowIf(UiText[ChatBotUiTextKey.StatusSummaryOperationIdLabel], facet.OperationId)
                                @CodeRowIf(UiText[ChatBotUiTextKey.StatusSummaryCompletionStatusLabel], facet.CompletionStatus)
                                @CodeRowIf(UiText[ChatBotUiTextKey.StatusSummaryProjectionStatusLabel], facet.ProjectionStatus)
                                @CodeRowIf(UiText[ChatBotUiTextKey.StatusSummaryAuditStatusLabel], facet.AuditStatus)
                                @CodeRowIf(UiText[ChatBotUiTextKey.StatusSummaryCorrelationIdLabel], facet.CorrelationId)
                                @if (facet.RetryCount is not null)
                                {
                                    @TextRow(UiText[ChatBotUiTextKey.StatusSummaryRetryCountLabel], facet.RetryCount.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))
                                }
                                @CodeRowIf(UiText[ChatBotUiTextKey.StatusSummaryDuplicateSafetyLabel], facet.DuplicateSafetyState)
                                @if (facet.SafeMetadataIds.Count > 0)
                                {
                                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
                                        <FluentText Weight="TextWeight.Semibold">@UiText[ChatBotUiTextKey.StatusSummaryMetadataLabel]</FluentText>
                                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem" Class="chatbot-conversation-status-summary__safe-ids">
                                            @foreach (KeyValuePair<string, string> metadata in facet.SafeMetadataIds)
                                            {
                                                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.25rem" VerticalAlignment="VerticalAlignment.Center">
                                                    <code class="chatbot-code">@metadata.Key</code>
                                                    <FluentText>:</FluentText>
                                                    <code class="chatbot-code">@metadata.Value</code>
                                                </FluentStack>
                                            }
                                        </FluentStack>
                                    </FluentStack>
                                }
                            </FluentStack>
                            @if (IsProjectionPending(facet))
                            {
                                <p class="chatbot-conversation-status-summary__reason"
                                   tabindex="0"
                                   role="@LiveRegionRole(facet)"
                                   aria-live="@LiveRegionMode(facet)"
                                   aria-atomic="true"
                                   data-chatbot-announcement-key="@AnnouncementKeyFor(facet)"
                                   data-chatbot-live-announced="@LiveAnnouncedValue(facet)">
                                    @UiText[ChatBotUiTextKey.StatusSummaryPartialSuccess]
                                </p>
                            }
                        </FluentStack>
                    </li>
                }
            </ul>
        </FluentStack>
    </FluentCard>
</section>

@code {
    [Parameter]
    public string ItemId { get; set; } = string.Empty;

    [Parameter]
    public ProjectConversationItemStatusSummaryModel? Summary { get; set; }

    private IReadOnlyList<ProjectConversationItemStatusFacetModel> _visibleFacets = [];

    private HashSet<string> _announcedProjectionPendingKeys = [];

    protected override void OnParametersSet()
    {
        ProjectConversationItemStatusFacetModel[] facets = (Summary?.Facets ?? [])
            .Where(static facet => !facet.NotApplicable)
            .OrderBy(static facet => OrderFor(facet.Domain))
            .ToArray();

        _visibleFacets = facets.Length == 0 ? [UnknownFacet] : facets;
        _announcedProjectionPendingKeys = _visibleFacets
            .Where(IsProjectionPending)
            .Select(AnnouncementKeyFor)
            .Where(key => AnnouncementDeduplication.ShouldAnnounce(key, ChatBotAnnouncementDedupRule.OncePerStableOperationKey))
            .ToHashSet(StringComparer.Ordinal);
    }

    private ProjectConversationItemStatusFacetModel UnknownFacet
        => new(
            "next-action",
            "unknown",
            "unknown",
            "status_unknown",
            "none",
            new Dictionary<string, string>(StringComparer.Ordinal),
            false,
            null,
            null,
            null,
            null,
            null,
            null,
            null,
            null,
            null);

    private static bool IsProjectionPending(ProjectConversationItemStatusFacetModel facet)
        => string.Equals(facet.SourceState, "accepted-projection-pending", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(facet.ProjectionStatus, "accepted-projection-pending", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(facet.CompletionStatus, "accepted-projection-pending", StringComparison.OrdinalIgnoreCase);

    private string LiveRegionMode(ProjectConversationItemStatusFacetModel facet)
        => _announcedProjectionPendingKeys.Contains(AnnouncementKeyFor(facet)) ? "polite" : "off";

    private string? LiveRegionRole(ProjectConversationItemStatusFacetModel facet)
        => _announcedProjectionPendingKeys.Contains(AnnouncementKeyFor(facet)) ? "status" : null;

    private string LiveAnnouncedValue(ProjectConversationItemStatusFacetModel facet)
        => _announcedProjectionPendingKeys.Contains(AnnouncementKeyFor(facet)) ? "true" : "false";

    private string AnnouncementKeyFor(ProjectConversationItemStatusFacetModel facet)
        => FirstNonBlank(facet.OperationId, facet.CorrelationId, $"{ItemId}-{facet.Domain}-{facet.SourceState}");

    private static int OrderFor(string domain)
        => domain switch
        {
            "association" => 0,
            "attachment" => 1,
            "task" => 2,
            "approval" => 3,
            "command" => 4,
            "failure" => 5,
            "retry" => 6,
            "next-action" => 7,
            _ => 8,
        };

    private static string FirstNonBlank(params string?[] values)
        => values.First(static value => !string.IsNullOrWhiteSpace(value))!;

    // Story 13.4: the former <dl> facet metadata dump renders as a structured
    // Fluent key-value block. Opaque tokens (source/completion/projection/audit/duplicate states, ids, the
    // safe-next-action token, safe metadata id pairs) keep <code class="chatbot-code">; the localized
    // next-action label renders as plain FluentText and the retry count renders as a plain number (AC3).
    private static RenderFragment CodeRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <code class="chatbot-code">@value</code>
    </FluentStack>;

    private static RenderFragment TextRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <FluentText>@value</FluentText>
    </FluentStack>;

    private static RenderFragment LabelTextCodeRow(string label, string? text, string? token) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <FluentText>@text</FluentText>
        <code class="chatbot-code">@token</code>
    </FluentStack>;

    private static RenderFragment? CodeRowIf(string label, string? value)
        => string.IsNullOrWhiteSpace(value) ? null : CodeRow(label, value);
}
