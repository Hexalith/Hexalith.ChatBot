@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotCultureFormatter Formatter
@inject ChatBotUiTextLocalizer UiText

<aside class="chatbot-why-project-panel"
       role="complementary"
       aria-labelledby="@TitleId"
       aria-label="@UiText[ChatBotUiTextKey.WhyProjectPanelAccessible]"
       data-chatbot-why-project-panel="metadata-only">
    <FluentCard Class="chatbot-why-project-panel__surface">
    <header class="chatbot-why-project-panel__header">
        <h2 id="@TitleId" class="chatbot-section-title">@UiText[ChatBotUiTextKey.WhyProjectPanelTitle]</h2>
        <FluentButton Type="ButtonType.Button"
                      Appearance="ButtonAppearance.Subtle"
                      aria-label="@UiText[ChatBotUiTextKey.WhyProjectCloseAction]"
                      OnClick="CloseAsync">
            @* A multiplication sign, hidden from assistive tech: the accessible name comes from aria-label.
               The previous literal lowercase "x" was read out as the letter. No icon package is referenced by
               this project, so a glyph is the dependency-free equivalent. *@
            <span aria-hidden="true">&#215;</span>
        </FluentButton>
    </header>

    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem" Class="chatbot-why-project-panel__metadata">
        @CodeRowIf(UiText[ChatBotUiTextKey.OperationLabel], Panel.AssociationId)
        @TextRowIf(UiText[ChatBotUiTextKey.WhyProjectSignalClassLabel], PrimarySignalClassLabel)
        @CodeRowIf(UiText[ChatBotUiTextKey.WhyProjectMatchedValueLabel], PrimaryDisplayToken)
        @TextRowIf(UiText[ChatBotUiTextKey.ConfidenceLabel], Formatter.FormatConfidence(Panel.ConfidenceScore))
        @CodeRowIf(UiText[ChatBotUiTextKey.ThresholdBandLabel], Panel.ThresholdBand)
        @CodeRowIf(UiText[ChatBotUiTextKey.PolicySnapshotVersionLabel], Panel.ThresholdPolicyVersion)
        @CodeRowIf(UiText[ChatBotUiTextKey.WhyProjectKernelVersionLabel], Panel.KernelVersion)
        @CodeRowIf(UiText[ChatBotUiTextKey.DecisionActorLabel], Panel.DecisionActorId)
        @CodeRowIf(UiText[ChatBotUiTextKey.DecisionActorTypeLabel], Panel.DecisionActorType)
        @TimeRowIf(UiText[ChatBotUiTextKey.DecidedAtLabel], Panel.DecisionTimestamp)
        @CodeRowIf(UiText[ChatBotUiTextKey.SourceProvenanceLabel], Panel.SourceProvenance)
        @CodeRowIf(UiText[ChatBotUiTextKey.SourceVersionLabel], Panel.SourceVersion.ToString(System.Globalization.CultureInfo.InvariantCulture))
        @CodeRowIf(UiText[ChatBotUiTextKey.CorrelationIdLabel], Panel.CorrelationId)
        @CodeRowIf(UiText[ChatBotUiTextKey.RedactionStateLabel], Panel.RedactionState)
        @CodeRowIf(UiText[ChatBotUiTextKey.SchemaVersionLabel], Panel.SchemaVersion)
        @CodeRowIf(UiText[ChatBotUiTextKey.SafeNextActionsLabel], Panel.SafeNextAction)
    </FluentStack>

    @if (Panel.IsCorrectedContextStale || !string.IsNullOrWhiteSpace(Panel.PropagationStatus))
    {
        <p class="chatbot-why-project-panel__state">
            <strong>@UiText[ChatBotUiTextKey.WhyProjectCorrectedContextLabel]</strong>
            @CorrectedContextText
        </p>
    }

    @if (!string.IsNullOrWhiteSpace(Panel.SupersededByAssociationId))
    {
        <FluentButton Type="ButtonType.Button"
                      Appearance="ButtonAppearance.Outline"
                      data-chatbot-correction-link="@(Panel.SupersedingCorrectionLink ?? $"association:{Panel.SupersededByAssociationId}")"
                      OnClick="OpenSupersedingCorrectionAsync">
            @UiText.Get(ChatBotUiTextKey.WhyProjectSupersedingCorrectionTemplate, Panel.SupersedingCorrectionId ?? Panel.SupersededByAssociationId)
        </FluentButton>
    }

    <section class="chatbot-why-project-panel__evidence"
             aria-labelledby="@EvidenceTitleId">
        <h3 id="@EvidenceTitleId" class="chatbot-section-title">@UiText[ChatBotUiTextKey.WhyProjectEvidenceTitle]</h3>
        @if (Panel.Evidence.Count == 0)
        {
            <p class="chatbot-why-project-panel__state">@UiText[ChatBotUiTextKey.WhyProjectEvidenceUnavailable]</p>
        }
        else
        {
            <ol class="chatbot-why-project-panel__evidence-list">
                @foreach (ProjectAssociationWhyEvidenceModel evidence in Panel.Evidence)
                {
                    <li class="chatbot-why-project-panel__evidence-row"
                        data-chatbot-evidence-visibility="@evidence.VisibilityState">
                        <div class="chatbot-why-project-panel__evidence-header">
                            <ChatBotEvidenceChip State="@EvidenceState(evidence)"
                                                 Text="@EvidenceLabel(evidence)" />
                            <span class="chatbot-metadata">@evidence.FreshnessState</span>
                        </div>
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem" Class="chatbot-why-project-panel__evidence-metadata">
                            @TextRowIf(UiText[ChatBotUiTextKey.WhyProjectSignalClassLabel], SignalClassText(evidence.SignalClass))
                            @CodeRowIf(UiText[ChatBotUiTextKey.WhyProjectMatchedValueLabel], evidence.DisplayToken)
                            @CodeRowIf(UiText[ChatBotUiTextKey.WhyProjectEvidenceReferenceLabel], evidence.Reference)
                            @CodeRowIf(UiText[ChatBotUiTextKey.WhyProjectEvidenceFingerprintLabel], evidence.Fingerprint)
                            @CodeRowIf(UiText[ChatBotUiTextKey.WhyProjectEvidenceFreshnessLabel], evidence.FreshnessState)
                            @CodeRowIf(UiText[ChatBotUiTextKey.RedactionStateLabel], evidence.RedactionState)
                            @TextRowIf(UiText[ChatBotUiTextKey.WhyProjectConfidenceContributionLabel], ContributionText(evidence))
                        </FluentStack>
                        @if (EvidenceState(evidence) is not ChatBotEvidenceState.Available)
                        {
                            <p class="chatbot-why-project-panel__state">@UiText[ChatBotUiTextKey.WhyProjectEvidenceRedactedExplanation]</p>
                        }
                    </li>
                }
            </ol>
        }
    </section>
    </FluentCard>
</aside>

@code {
    [Parameter]
    public ProjectAssociationWhyPanelModel Panel { get; set; } = default!;

    private string TitleId => $"chatbot-why-project-panel-{Panel.AssociationId}-title";

    private string EvidenceTitleId => $"chatbot-why-project-panel-{Panel.AssociationId}-evidence-title";

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback<string> OnOpenAssociation { get; set; }

    // The summary rows describe the first *visible* evidence entry. Taking Evidence.First() regardless of
    // visibility surfaced a redacted matched value in the panel header metadata.
    private ProjectAssociationWhyEvidenceModel? PrimaryVisibleEvidence
        => Panel.Evidence.FirstOrDefault(static evidence => EvidenceState(evidence) is ChatBotEvidenceState.Available);

    private string PrimarySignalClassLabel
        => SignalClassText(PrimaryVisibleEvidence?.SignalClass);

    private string PrimaryDisplayToken
        => PrimaryVisibleEvidence?.DisplayToken ?? UiText[ChatBotUiTextKey.DecisionUnavailableValue];

    private string CorrectedContextText
        => UiText.Get(
            ChatBotUiTextKey.WhyProjectCorrectedContextTemplate,
            Panel.PropagationStatus ?? UiText[ChatBotUiTextKey.DecisionUnavailableValue],
            Panel.DownstreamImpactStatus ?? UiText[ChatBotUiTextKey.DecisionUnavailableValue],
            Panel.SafeNextAction);

    private static ChatBotEvidenceState EvidenceState(ProjectAssociationWhyEvidenceModel evidence)
        // Case-insensitive: the ordinal-exact arms let a "Redacted" visibility render as Available with no
        // redaction explanation.
        => evidence.VisibilityState switch
        {
            _ when string.Equals(evidence.VisibilityState, "redacted", StringComparison.OrdinalIgnoreCase) => ChatBotEvidenceState.Redacted,
            _ when string.Equals(evidence.VisibilityState, "unavailable", StringComparison.OrdinalIgnoreCase) => ChatBotEvidenceState.Unavailable,
            _ when string.Equals(evidence.RedactionState, "redacted", StringComparison.OrdinalIgnoreCase) => ChatBotEvidenceState.Redacted,
            _ when string.Equals(evidence.RedactionState, "unavailable", StringComparison.OrdinalIgnoreCase) => ChatBotEvidenceState.Unavailable,
            _ => ChatBotEvidenceState.Available,
        };

    private static string ContributionText(ProjectAssociationWhyEvidenceModel evidence)
        => evidence.ConfidenceContribution?.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) ?? string.Empty;

    private string EvidenceLabel(ProjectAssociationWhyEvidenceModel evidence)
        => string.IsNullOrWhiteSpace(evidence.SignalClass)
            ? evidence.Kind
            : $"{UiText.AssociationSignalClassLabel(evidence.SignalClass)}: {evidence.DisplayToken}";

    private string SignalClassText(string? signalClass)
        => string.IsNullOrWhiteSpace(signalClass)
            ? UiText[ChatBotUiTextKey.DecisionUnavailableValue]
            : $"{UiText.AssociationSignalClassLabel(signalClass)} ({signalClass})";

    // Story 13.4: the former <dl> why-project metadata dumps render as
    // structured Fluent key-value blocks. Opaque tokens (association/actor/correlation ids, threshold band,
    // policy/kernel/schema/source versions, fingerprints, evidence references/freshness, raw enum tokens, the
    // safe-next-action token) keep <code class="chatbot-code">; the localized signal-class label and the
    // formatted confidence / confidence-contribution metrics render as plain FluentText, and the decided-at
    // timestamp drops the monospace while keeping its machine datetime (AC3). Blank rows render nothing.
    private static RenderFragment CodeRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <code class="chatbot-code">@value</code>
    </FluentStack>;

    private static RenderFragment TextRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <FluentText>@value</FluentText>
    </FluentStack>;

    private static RenderFragment? CodeRowIf(string label, string? value)
        => string.IsNullOrWhiteSpace(value) ? null : CodeRow(label, value);

    private static RenderFragment? TextRowIf(string label, string? value)
        => string.IsNullOrWhiteSpace(value) ? null : TextRow(label, value);

    private RenderFragment TimeRow(string label, DateTimeOffset value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <time datetime="@value.ToUniversalTime().ToString("O", System.Globalization.CultureInfo.InvariantCulture)">@Formatter.FormatDateTime(value)</time>
    </FluentStack>;

    private RenderFragment? TimeRowIf(string label, DateTimeOffset value)
        => value == default ? null : TimeRow(label, value);

    private async Task CloseAsync()
        => await OnClose.InvokeAsync().ConfigureAwait(true);

    private async Task OpenSupersedingCorrectionAsync()
    {
        string? associationId = Panel.SupersededByAssociationId;
        if (!string.IsNullOrWhiteSpace(associationId))
        {
            await OnOpenAssociation.InvokeAsync(associationId).ConfigureAwait(true);
        }
    }
}
