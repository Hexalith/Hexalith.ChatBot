@namespace Hexalith.ChatBot.UI.Components.Governed
@inherits FluxorComponent
@implements IAsyncDisposable
@inject IState<ProjectConversationState> State
@inject IDispatcher Dispatcher
@inject ChatBotUiTextLocalizer UiText
@inject ChatBotHubEndpoint ChatBotHubEndpoint

<ChatBotConversationShell ShellLabel="@HeadingText"
                          MainLabel="@UiText[ChatBotUiTextKey.ProjectConversationStream]"
                          ComplementaryLabel="@ResolvedComplementaryLabel">
    <ProjectContext>
        <ChatBotProjectContextHeader ProjectName="@ProjectName"
                                     ProjectId="@ProjectId"
                                     TenantContext="@Conversation?.TenantContext"
                                     ConversationLabel="@UiText[ChatBotUiTextKey.ProjectConversationStream]"
                                     ConversationState="@ConversationState"
                                     StatusKind="@StatusKind"
                                     StatusText="@StatusText"
                                     StatusStableId="project-conversation-context" />
    </ProjectContext>
    <MainContent>
        <FcPageLayout Mode="FcPageLayoutMode.FullWidth">
        <section class="chatbot-page chatbot-project-conversation"
                 aria-labelledby="@HeadingId"
                 data-chatbot-responsive-fixture="@ResponsiveFixture">
            <FcPageHeader Eyebrow="S1"
                          Heading="@HeadingText"
                          HeadingId="@HeadingId"
                          PageTitle="@PageTitle" />

            @if (ShowProjectSwitchSuccess && Conversation is not null && !State.Value.IsLoading && State.Value.ErrorCode is null)
            {
                <ChatBotStatusBanner Kind="ChatBotFeedbackKind.Success"
                                     Message="@UiText[ChatBotUiTextKey.ProjectWorkspaceStateProjectSwitchSuccess]"
                                     AccessibleLabel="@UiText[ChatBotUiTextKey.ProjectWorkspaceStateProjectSwitchSuccess]"
                                     StableId="project-workspace-switch-success"
                                     StateFamily="ChatBotFeedbackStateFamily.CurrentUserCommandAcceptedProjectionPending"
                                     AnnouncementKey="@($"project-workspace-switch-{ProjectId}")" />
            }

            @if (State.Value.IsLoading)
            {
                <ChatBotStatusBanner Kind="ChatBotFeedbackKind.Info"
                                     Message="@UiText[ChatBotUiTextKey.ProjectWorkspaceStateColdLoad]"
                                     AccessibleLabel="@UiText[ChatBotUiTextKey.ProjectWorkspaceStateColdLoad]"
                                     StableId="project-conversation-loading"
                                     StateFamily="ChatBotFeedbackStateFamily.LoadingColdLoad">
                    @UiText[ChatBotUiTextKey.ProjectConversationLoading]
                </ChatBotStatusBanner>
            }

            @if (State.Value.ErrorCode is not null)
            {
                <ChatBotStatusBanner Kind="ChatBotFeedbackKind.Danger"
                                     Message="@UiText[ChatBotUiTextKey.ProjectWorkspaceStateUnauthorizedRedacted]"
                                     AccessibleLabel="@UiText[ChatBotUiTextKey.ProjectWorkspaceStateUnauthorizedRedacted]"
                                     StableId="project-conversation-failed"
                                     StateFamily="ChatBotFeedbackStateFamily.BlockedAction"
                                     AnnouncementKey="project-conversation-failed-redacted">
                    @UiText[ChatBotUiTextKey.ProjectWorkspaceUnauthorizedSafeMessage]
                </ChatBotStatusBanner>
                <ChatBotBlockedState Reason="ChatBotBlockedReason.Denial"
                                     ReasonText="@UiText[ChatBotUiTextKey.ProjectWorkspaceStateUnauthorizedRedacted]"
                                     SafeNextAction="@UiText[ChatBotUiTextKey.ProjectWorkspaceUnauthorizedNextAction]"
                                     StableId="project-workspace-unauthorized" />
            }

            @if (Conversation is { } conversation)
            {
                <ChatBotStatusBanner Kind="@StatusKind"
                                     Message="@WorkspaceStateText"
                                     AccessibleLabel="@WorkspaceStateText"
                                     StableId="project-conversation-status"
                                     StateFamily="@FeedbackState"
                                     LiveRegionPoliteness="ChatBotLiveRegionPoliteness.None">
                    <code class="chatbot-code">@StatusText</code>
                </ChatBotStatusBanner>

                @if (conversation.IsBlockedOrStale)
                {
                    <ChatBotBlockedState Reason="@BlockedReason"
                                         ReasonText="@UiText[ChatBotUiTextKey.ProjectConversationBlocked]"
                                         SafeNextAction="@conversation.SafeNextAction"
                                         StableId="project-conversation-blocked" />
                }

                <ChatBotConversationStream Items="@conversation.Items"
                                           Title="@UiText[ChatBotUiTextKey.ProjectConversationStream]"
                                           EmptyText="@UiText[ChatBotUiTextKey.ProjectConversationEmpty]"
                                           SafeNextAction="@conversation.SafeNextAction"
                                           OnWhyThisProjectRequested="@OpenWhyThisProject" />

                @if (LatestAiResponseProgress is { } progress)
                {
                    <p class="chatbot-streaming-status"
                       role="status"
                       aria-live="polite"
                       data-chatbot-streaming-state="@progress.State"
                       data-chatbot-streaming-terminal="@(progress.IsTerminal ? "true" : "false")">
                        @AiResponseStatusText(progress)
                    </p>
                }
                else if (StreamingStatusText is { } streamingStatus)
                {
                    <p class="chatbot-streaming-status"
                       role="status"
                       aria-live="polite"
                       data-chatbot-streaming-state="notice">
                        @streamingStatus
                    </p>
                }

                @* AC4: the Stop/Cancel control is always mounted in a stable focusable slot; it is enabled only
                   while a non-terminal generation is in flight and announces "Response stopped" after the server
                   verifies the terminal state. *@
                <ChatBotStreamingStopControl IsStreaming="@(ActiveStreamingProgress is not null)"
                                             Disabled="@State.Value.IsCancellingAiResponse"
                                             DisabledReason="@StopDisabledReason"
                                             StopVerified="@LatestStopVerified"
                                             StableId="project-conversation-ai-response-stop"
                                             FocusReturnTargetId="project-conversation-composer-input"
                                             OnStop="@StopActiveAiResponse" />

                <ChatBotGovernedComposer Mode="@State.Value.ComposerMode"
                                         Disabled="@ComposerDisabled"
                                         DisabledReasonCode="@ComposerDisabledReasonCode"
                                         IsSubmitting="@State.Value.IsSubmitting"
                                         ValidationErrorCode="@State.Value.ComposerValidationErrorCode"
                                         PendingSubmission="@State.Value.PendingSubmission"
                                         OnModeChanged="@SetComposerMode"
                                         OnSubmit="@SubmitComposer" />
            }
        </section>
        </FcPageLayout>
    </MainContent>
    <ComplementaryPanel>
        @if (State.Value.IsWhyPanelLoading)
        {
            <ChatBotStatusBanner Kind="ChatBotFeedbackKind.Info"
                                 Message="@UiText[ChatBotUiTextKey.WhyProjectLoading]"
                                 AccessibleLabel="@UiText[ChatBotUiTextKey.WhyProjectLoading]"
                                 StableId="why-project-loading"
                                 StateFamily="ChatBotFeedbackStateFamily.LoadingColdLoad" />
        }

        @if (State.Value.WhyPanelErrorCode is not null)
        {
            <ChatBotStatusBanner Kind="ChatBotFeedbackKind.Warning"
                                 Message="@UiText[ChatBotUiTextKey.WhyProjectUnavailable]"
                                 AccessibleLabel="@UiText[ChatBotUiTextKey.WhyProjectUnavailable]"
                                 StableId="why-project-unavailable"
                                 StateFamily="ChatBotFeedbackStateFamily.RetryableFailure"
                                 AnnouncementKey="why-project-failed-redacted">
                @UiText[ChatBotUiTextKey.ProjectWorkspaceUnauthorizedSafeMessage]
            </ChatBotStatusBanner>
        }

        @if (State.Value.WhyPanel is { } whyPanel)
        {
            <ChatBotWhyProjectPanel Panel="@whyPanel"
                                    OnClose="@CloseWhyThisProject"
                                    OnOpenAssociation="@OpenWhyThisProjectByAssociation" />
        }

        @if (Conversation is { } conversation)
        {
            <section class="chatbot-section" aria-labelledby="project-workspace-context-panel-title">
                <h2 id="project-workspace-context-panel-title" class="chatbot-section-title">@UiText[ChatBotUiTextKey.ProjectWorkspaceContextPanelTitle]</h2>
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="0.25rem">
                    @CodeRow(UiText[ChatBotUiTextKey.ProjectLabel], conversation.ProjectId)
                    @CodeRow(UiText[ChatBotUiTextKey.LifecycleStateLabel], conversation.ConversationState)
                    @CodeRow(UiText[ChatBotUiTextKey.SafeNextActionsLabel], conversation.SafeNextAction)
                    @CodeRow(UiText[ChatBotUiTextKey.AssociationReviewMetadata], $"{conversation.SourceProvenance} · {conversation.SchemaVersion}")
                </FluentStack>
            </section>

            <section class="chatbot-section" aria-labelledby="project-workspace-files-panel-title">
                <h2 id="project-workspace-files-panel-title" class="chatbot-section-title">@UiText[ChatBotUiTextKey.ProjectWorkspaceFilesPanelTitle]</h2>
                @if (AttachmentItems.Any())
                {
                    <div class="chatbot-project-file-list" aria-label="@UiText[ChatBotUiTextKey.ProjectWorkspaceFilesPanelTitle]">
                        @foreach (ProjectConversationItemModel attachment in AttachmentItems)
                        {
                            <ChatBotAttachmentConversationItem Item="@attachment" />
                        }
                    </div>
                }
                else
                {
                    <ChatBotStatusBanner Kind="ChatBotFeedbackKind.Info"
                                         Message="@UiText[ChatBotUiTextKey.ProjectWorkspaceFilesPanelEmpty]"
                                         AccessibleLabel="@UiText[ChatBotUiTextKey.ProjectWorkspaceFilesPanelEmpty]"
                                         StableId="project-workspace-files-empty"
                                         StateFamily="ChatBotFeedbackStateFamily.ObservedForOthersRejectionOrQueueUpdate" />
                }
            </section>
        }
    </ComplementaryPanel>
</ChatBotConversationShell>

@code {
    [Parameter]
    public string ProjectId { get; set; } = string.Empty;

    [Parameter]
    public string HeadingText { get; set; } = string.Empty;

    // The browser document title for the delegating route. FcPageHeader renders the single <PageTitle> for this
    // composed workspace, so each @page delegator passes its own tab-title key down (the route heading and the tab
    // title differ); when null, FcPageHeader falls back to HeadingText.
    [Parameter]
    public string? PageTitle { get; set; }

    [Parameter]
    public string HeadingId { get; set; } = "project-conversation-title";

    [Parameter]
    public string ResponsiveFixture { get; set; } = "project-conversation";

    [Parameter]
    public string? ComplementaryLabel { get; set; }

    [Parameter]
    public bool ShowProjectSwitchSuccess { get; set; }

    private ProjectConversationModel? Conversation => State.Value.Conversation;

    private string ResolvedComplementaryLabel
        => string.IsNullOrWhiteSpace(ComplementaryLabel)
            ? UiText[ChatBotUiTextKey.ProjectConversationMetadata]
            : ComplementaryLabel;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (!string.IsNullOrWhiteSpace(ProjectId) && Conversation?.ProjectId != ProjectId)
        {
            Dispatcher.Dispatch(new LoadProjectConversationAction(ProjectId));
        }
    }

    // Story 10.6b reuse transport: the subscriber (constructed per component instance) owns the tenant-scoped
    // project-conversation projection-changed SignalR subscription and fail-open teardown.
    private ProjectConversationStreamingSubscriber? _streamingSubscriber;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _streamingSubscriber = new ProjectConversationStreamingSubscriber(ChatBotHubEndpoint);
    }

    // Once the conversation (and its tenant) is loaded, join the project-conversation projection-changed group so AI
    // response progress changes nudge a typed re-query. The signal is advisory and carries no response/version/sequence,
    // so the callback dispatches a signal action that the effect fails closed and turns into an authoritative re-query.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (_streamingSubscriber is { } subscriber && !string.IsNullOrWhiteSpace(ProjectId))
        {
            string project = ProjectId;
            string? tenant = Conversation?.TenantContext;
            await subscriber.EnsureSubscribedAsync(
                tenant,
                () =>
                {
                    _ = InvokeAsync(() => Dispatcher.Dispatch(new ProjectConversationProjectionSignalReceivedAction(project, tenant!)));
                },
                () =>
                {
                    // AC5: after a transparent reconnect, re-query authoritative server state (the effect dispatches
                    // LoadProjectConversationAction) so a terminal/progress change missed during the disconnect window
                    // does not leave the surface on stale in-flight state with an enabled Stop control.
                    _ = InvokeAsync(() => Dispatcher.Dispatch(new ProjectConversationAiResponseReconnectAction(project)));
                });
        }
    }

    // FluxorComponent already owns IAsyncDisposable with a non-virtual DisposeAsync, so re-implement the interface
    // explicitly (re-maps the interface for this type) to tear down the projection subscription, then chain to the base
    // for its own state-subscription cleanup.
    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_streamingSubscriber is { } subscriber)
        {
            await subscriber.DisposeAsync();
        }

        await base.DisposeAsync();
    }

    private string ProjectName => Conversation?.ProjectDisplayName ?? UiText[ChatBotUiTextKey.ProjectConversationAuthorizedProject];

    private string ConversationState => Conversation?.ConversationState ?? UiText[ChatBotUiTextKey.ProjectConversationLoading];

    private string StatusText => Conversation?.Status ?? UiText[ChatBotUiTextKey.ProjectConversationLoading];

    private IReadOnlyList<ProjectConversationItemModel> AttachmentItems
        => Conversation?.Items.Where(static item => item.IsAttachment).ToArray() ?? [];

    // AC4 / review finding #4: surface the latest AI response progress for ANY state, including the terminal
    // completed/failed/unavailable states an earlier revision filtered out (so they previously rendered nothing).
    private ProjectConversationAiResponseProgressModel? LatestAiResponseProgress
        => Conversation?.Items
            .Select(static item => item.AiResponseProgress)
            .OfType<ProjectConversationAiResponseProgressModel>()
            .OrderByDescending(static progress => progress.SourceVersion)
            .ThenByDescending(static progress => progress.Sequence)
            .FirstOrDefault();

    // The non-terminal, in-flight generation that the Stop/Cancel control can act on.
    private ProjectConversationAiResponseProgressModel? ActiveStreamingProgress
        => LatestAiResponseProgress is { IsTerminal: false } active &&
            ProjectConversationAiResponseProgressStates.IsActive(active.State)
            ? active
            : null;

    private bool LatestStopVerified
        => LatestAiResponseProgress is { } progress && IsStopVerified(progress);

    private string? StopDisabledReason
        => State.Value.IsCancellingAiResponse
            ? UiText[ChatBotUiTextKey.ProjectConversationStreamingDisabledReason]
            : null;

    private string WorkspaceStateText
        => Conversation switch
        {
            { Status: "Blocked" or "Stale" or "Degraded" } => UiText[ChatBotUiTextKey.ProjectWorkspaceStateDependencyDegraded],
            { IsEmpty: true } => UiText[ChatBotUiTextKey.ProjectWorkspaceStateEmptyProject],
            not null => UiText[ChatBotUiTextKey.ProjectWorkspaceStateActiveConversation],
            _ => UiText[ChatBotUiTextKey.ProjectWorkspaceStateColdLoad],
        };

    private ChatBotFeedbackKind StatusKind
        => Conversation switch
        {
            null => ChatBotFeedbackKind.Info,
            { Status: "Blocked" or "Stale" or "Degraded" } => ChatBotFeedbackKind.Warning,
            { IsEmpty: true } => ChatBotFeedbackKind.Warning,
            _ => ChatBotFeedbackKind.Info,
        };

    private ChatBotFeedbackStateFamily FeedbackState
        => Conversation switch
        {
            { Status: "Blocked" } => ChatBotFeedbackStateFamily.BlockedAction,
            { Status: "Stale" or "Degraded" } => ChatBotFeedbackStateFamily.DependencyDegraded,
            { IsEmpty: true } => ChatBotFeedbackStateFamily.BlockedAction,
            _ => ChatBotFeedbackStateFamily.CurrentUserAiProposalReady,
        };

    private ChatBotBlockedReason BlockedReason
        => Conversation?.Status == "Degraded"
            ? ChatBotBlockedReason.FailedDependency
            : ChatBotBlockedReason.UnsafeContext;

    private bool ComposerDisabled
        => State.Value.IsLoading ||
            State.Value.ErrorCode is not null ||
            State.Value.IsSubmitting ||
            Conversation is null ||
            Conversation.IsBlockedOrStale;

    private string? ComposerDisabledReasonCode
        => State.Value.ErrorCode is not null
            ? "unauthorized"
            : Conversation?.Status is "Blocked" or "Stale" or "Degraded"
                ? "degraded"
                : State.Value.IsLoading || Conversation is null
                    ? "loading"
                    : null;

    private void OpenWhyThisProject(ProjectConversationItemModel item)
    {
        if (!string.IsNullOrWhiteSpace(item.ProjectId) && !string.IsNullOrWhiteSpace(item.AssociationId))
        {
            Dispatcher.Dispatch(new OpenProjectAssociationWhyPanelAction(item.ProjectId, item.AssociationId));
        }
    }

    private void OpenWhyThisProjectByAssociation(string associationId)
    {
        if (!string.IsNullOrWhiteSpace(ProjectId) && !string.IsNullOrWhiteSpace(associationId))
        {
            Dispatcher.Dispatch(new OpenProjectAssociationWhyPanelAction(ProjectId, associationId));
        }
    }

    private void CloseWhyThisProject()
        => Dispatcher.Dispatch(new CloseProjectAssociationWhyPanelAction());

    private void SetComposerMode(ProjectConversationComposerMode mode)
        => Dispatcher.Dispatch(new SetProjectConversationComposerModeAction(mode));

    private void SubmitComposer(string text)
        => Dispatcher.Dispatch(new SubmitProjectConversationComposerAction(
            ProjectId,
            State.Value.ComposerMode,
            text,
            System.Globalization.CultureInfo.CurrentUICulture.Name,
            Conversation?.Items.Max(static item => item.SourceVersion) ?? 0));

    private void StopActiveAiResponse()
    {
        if (ActiveStreamingProgress is { } progress)
        {
            Dispatcher.Dispatch(new StopProjectConversationAiResponseAction(progress));
        }
    }

    private static bool IsStopVerified(ProjectConversationAiResponseProgressModel progress)
        => progress is { IsTerminal: true, State: "stopped" or "cancelled" };

    // AC4 (UX-DR32): progress/state must be conveyed by visible text, never motion-only. Maps every metadata-only
    // progress state (including terminal completed/failed/unavailable) plus any degraded/stale/reconnect streaming
    // condition to the localized streaming-status vocabulary.
    private string AiResponseStatusText(ProjectConversationAiResponseProgressModel progress)
        => StreamingStatusText
            ?? progress.State switch
            {
                "cancelling" => UiText[ChatBotUiTextKey.ProjectConversationStreamingCancelling],
                "stopped" or "cancelled" => UiText[ChatBotUiTextKey.ProjectConversationStreamingStopped],
                "completed" => UiText[ChatBotUiTextKey.ProjectConversationStreamingCompleted],
                "failed" or "unavailable" => UiText[ChatBotUiTextKey.ProjectConversationStreamingUnavailable],
                _ => UiText[ChatBotUiTextKey.ProjectConversationStreamingProgress],
            };

    // A streaming error or reconnect notice that must surface even when no progress row is present yet.
    private string? StreamingStatusText
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(State.Value.StreamingErrorCode))
            {
                return StreamingErrorText(State.Value.StreamingErrorCode);
            }

            return string.IsNullOrWhiteSpace(State.Value.StreamingNotice)
                ? null
                : StreamingNoticeText(State.Value.StreamingNotice);
        }
    }

    private string StreamingErrorText(string code)
        => code switch
        {
            "ai-response-nudge-unsafe" => UiText[ChatBotUiTextKey.ProjectConversationStreamingStale],
            ProjectConversationEffects.GenericFailureCode => UiText[ChatBotUiTextKey.ProjectConversationStreamingRetry],
            _ => UiText[ChatBotUiTextKey.ProjectConversationStreamingUnavailable],
        };

    private string StreamingNoticeText(string notice)
        => notice switch
        {
            "reconnected" => UiText[ChatBotUiTextKey.ProjectConversationStreamingReconnected],
            "stale" => UiText[ChatBotUiTextKey.ProjectConversationStreamingStale],
            _ => UiText[ChatBotUiTextKey.ProjectConversationStreamingProgress],
        };

    // Story 13.4: the former context-panel <dl> renders as a structured Fluent
    // key-value block. Project id, lifecycle-state token, safe-next-action token and provenance · schema-version
    // are all opaque tokens and keep <code class="chatbot-code"> (AC3).
    private static RenderFragment CodeRow(string label, string? value) =>@<FluentStack Orientation="Orientation.Horizontal" HorizontalGap="0.5rem" VerticalAlignment="VerticalAlignment.Center">
        <FluentText Weight="TextWeight.Semibold">@label</FluentText>
        <code class="chatbot-code">@value</code>
    </FluentStack>;
}
