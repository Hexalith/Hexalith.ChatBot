@namespace Hexalith.ChatBot.UI.Components.Governed

<section class="chatbot-task-intent-review-panel"
         aria-label="Task intent review"
         data-chatbot-task-intent-id="@Review.TaskIntentId">
    <header class="chatbot-task-intent-review-panel__header">
        <ChatBotEvidenceChip State="@EvidenceState"
                             Text="@Review.TaskIntentId"
                             StableId="@Review.TaskIntentId" />
        <span class="chatbot-task-intent-review-panel__state">@Review.CurrentState</span>
        <span class="chatbot-task-intent-review-panel__reason">@Review.ReasonCode</span>
    </header>

    <dl class="chatbot-definition-list">
        <dt>Project</dt>
        <dd><code class="chatbot-code">@Review.ProjectId</code></dd>
        <dt>Source version</dt>
        <dd><code class="chatbot-code">@Review.SourceVersion</code></dd>
        <dt>Correlation</dt>
        <dd><code class="chatbot-code">@Review.CorrelationId</code></dd>
    </dl>

    @if (!string.IsNullOrWhiteSpace(Review.SourceMessageContent))
    {
        <section class="chatbot-task-intent-review-panel__source"
                 aria-label="Source message">
            <pre tabindex="0">@Review.SourceMessageContent</pre>
        </section>
    }

    <div class="chatbot-task-intent-review-panel__actions"
         role="toolbar"
         aria-label="Task intent actions">
        @foreach (TaskIntentAvailableTransitionModel transition in Review.AvailableTransitions)
        {
            <FluentButton Type="ButtonType.Button"
                          Appearance="ButtonAppearance.Outline"
                          Class="chatbot-governed-action"
                          aria-disabled="@AriaDisabled(transition)"
                          aria-describedby="@DisabledReasonReferenceId(transition)"
                          OnClick="@(() => SelectTransitionAsync(transition))">
                @transition.Label
            </FluentButton>
            @if (!transition.Enabled && !string.IsNullOrWhiteSpace(transition.DisabledReasonCode))
            {
                <span id="@DisabledReasonId(transition)" class="chatbot-task-intent-review-panel__disabled-reason">
                    @transition.DisabledReasonCode
                </span>
            }
        }
    </div>

    <div class="chatbot-task-intent-review-panel__duplicate">
        <FluentLabel for="@PredecessorInputId">Predecessor task intent</FluentLabel>
        <FluentTextInput Id="@PredecessorInputId"
                         Value="@PredecessorTaskIntentId"
                         ValueChanged="OnPredecessorChanged"
                         aria-invalid="@DuplicateInvalidText" />
        @if (DuplicateInvalid)
        {
            <p role="alert">predecessor_task_intent_required</p>
        }
    </div>

    <div class="chatbot-task-intent-review-panel__status" role="status" aria-live="polite">
        @LiveRegionText
    </div>
</section>

@code {
    [Parameter]
    public TaskIntentReviewModel Review { get; set; } = default!;

    [Parameter]
    public EventCallback<TaskIntentTransitionSelectionModel> OnTransitionSelected { get; set; }

    private string? PredecessorTaskIntentId { get; set; }

    private string? LiveRegionText { get; set; }

    private string PredecessorInputId => $"task-intent-{Review.TaskIntentId}-predecessor";

    private bool DuplicateInvalid { get; set; }

    private ChatBotEvidenceState EvidenceState => Review.Available ? ChatBotEvidenceState.Available : ChatBotEvidenceState.Unavailable;

    private string DisabledReasonId(TaskIntentAvailableTransitionModel transition)
        => $"task-intent-{Review.TaskIntentId}-{transition.Transition}-reason";

    private static string AriaDisabled(TaskIntentAvailableTransitionModel transition)
        => transition.Enabled ? "false" : "true";

    private string? DisabledReasonReferenceId(TaskIntentAvailableTransitionModel transition)
        => !transition.Enabled && !string.IsNullOrWhiteSpace(transition.DisabledReasonCode)
            ? DisabledReasonId(transition)
            : null;

    private string DuplicateInvalidText => DuplicateInvalid ? "true" : "false";

    private async Task SelectTransitionAsync(TaskIntentAvailableTransitionModel transition)
    {
        DuplicateInvalid = transition.RequiresPredecessorTaskIntentId && string.IsNullOrWhiteSpace(PredecessorTaskIntentId);
        if (!transition.Enabled || DuplicateInvalid)
        {
            LiveRegionText = transition.DisabledReasonCode ?? "transition_unavailable";
            return;
        }

        LiveRegionText = transition.Transition;
        await OnTransitionSelected.InvokeAsync(new TaskIntentTransitionSelectionModel(
            transition.Transition,
            transition.RequiresPredecessorTaskIntentId ? PredecessorTaskIntentId : null)).ConfigureAwait(false);
    }

    private void OnPredecessorChanged(string? value)
    {
        PredecessorTaskIntentId = value;
        DuplicateInvalid = false;
    }
}
