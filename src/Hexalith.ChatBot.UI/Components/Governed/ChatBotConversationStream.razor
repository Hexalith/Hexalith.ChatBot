@namespace Hexalith.ChatBot.UI.Components.Governed
@inject ChatBotUiTextLocalizer UiText

<section class="chatbot-conversation-stream"
         aria-labelledby="@TitleId"
         data-chatbot-conversation-stream="metadata-only">
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="1rem">
        <FluentText As="TextTag.H2" Id="@TitleId" Class="chatbot-section-title">@Title</FluentText>
        @if (Items.Count == 0)
        {
            <ChatBotBlockedState Reason="ChatBotBlockedReason.UnresolvedAssociation"
                                 ReasonText="@EmptyText"
                                 SafeNextAction="@SafeNextAction"
                                 StableId="project-conversation-empty" />
        }
        else
        {
            <FluentCard Class="chatbot-conversation-stream__surface">
                <ol class="chatbot-conversation-stream__list" aria-label="@Title">
                    @foreach (ProjectConversationItemModel item in Items)
                    {
                        <li class="chatbot-conversation-stream__entry">
                            @if (item.IsParticipant)
                            {
                                <ChatBotParticipantConversationItem Item="@item" />
                            }
                            else if (item.IsAttachment)
                            {
                                <ChatBotAttachmentConversationItem Item="@item" />
                            }
                            else if (item.IsSystemDecision)
                            {
                                <ChatBotDecisionConversationItem Item="@item"
                                                                 OnWhyThisProjectRequested="@OnWhyThisProjectRequested" />
                            }
                            else if (item.IsApprovalEvent)
                            {
                                <ChatBotApprovalConversationItem Item="@item"
                                                                 OnWhyThisProjectRequested="@OnWhyThisProjectRequested" />
                            }
                            else if (item.IsFailureState)
                            {
                                <ChatBotFailureStateConversationItem Item="@item" />
                            }
                            else if (item.IsAiOutcome)
                            {
                                <ChatBotAiOutcomeConversationItem Item="@item" />
                            }
                            else
                            {
                                <ChatBotEmailConversationItem Item="@item"
                                                              OnWhyThisProjectRequested="@OnWhyThisProjectRequested" />
                            }
                        </li>
                    }
                </ol>
            </FluentCard>
        }
    </FluentStack>
</section>

@code {
    [Parameter]
    public IReadOnlyList<ProjectConversationItemModel> Items { get; set; } = [];

    [Parameter]
    public string Title { get; set; } = "Project conversation";

    [Parameter]
    public string EmptyText { get; set; } = "No email-derived context is available.";

    [Parameter]
    public string SafeNextAction { get; set; } = "Review project setup or wait for associated email.";

    [Parameter]
    public EventCallback<ProjectConversationItemModel> OnWhyThisProjectRequested { get; set; }

    private string TitleId => "project-conversation-stream-title";
}
