<?xml version="1.0" encoding="utf-8"?>
<!--
  Run settings for the required live-recovery validation and evidence-gate lanes.

  TreatNoTestsAsError is the point of this file. `dotnet test --filter "FullyQualifiedName=..."` prints
  "No test matches the given testcase filter" and exits 0, so renaming or moving either lane's test turned a
  REQUIRED job into a silent no-op: the gate job still checked out, still downloaded the evidence artifact,
  ran zero tests, reported success, and semantic-release published with nothing evaluated. The architecture
  guard asserts the fully-qualified name appears in the workflow YAML, not that a test with that name exists,
  so it stays green through the rename.

  Every `dotnet test` invocation in the live-recovery lanes must pass `--settings live-recovery.runsettings`.
-->
<RunSettings>
  <RunConfiguration>
    <TreatNoTestsAsError>true</TreatNoTestsAsError>
  </RunConfiguration>
</RunSettings>
