    "valueSha256": "SHA256(frame(ASCII Redis TYPE) || frame(raw Redis DUMP) || frame(ASCII PEXPIRETIME))",
    "frame": "Unsigned 64-bit big-endian byte length followed by exact bytes",
    "expiry": "Absolute Unix milliseconds, including Redis -1 sentinel; no relative TTL normalization",
    "collection": "One EVAL_RO over KEYS * and DBSIZE on the complete run-owned DB 0. No prefix filtering/sampling, producer observation, API simulation or omission."
  },
