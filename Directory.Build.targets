<Project>
  <Import Project="$(MSBuildThisFileDirectory)eng/ChatBot.Composition.Restore.targets" />
  <!-- NuGet adds transitive project edges without the AppHost edge metadata. Bind both
       explicit and generated edges so every composition build uses Release and the same
       manifest-pinned published Tooling assembly, including integration/recovery consumers. -->
  <PropertyGroup Condition="'$(UseHexalithProjectReferences)' != 'true'">
    <_ChatBotCatalogPackageProps Condition="'$(_ChatBotCatalogPackageProps)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)references/Hexalith.Builds/Props/Directory.Packages.props'))</_ChatBotCatalogPackageProps>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseHexalithProjectReferences)' != 'true'">
    <ProjectReference Update="@(ProjectReference)"
                      AdditionalProperties="%(ProjectReference.AdditionalProperties);HexalithBuildsPublishedToolRoot=$(_ChatBotPublishedToolRoot);Hexalith1BuildPackageProps=$(_ChatBotCatalogPackageProps);Hexalith2BuildPackageProps=$(_ChatBotCatalogPackageProps);ShouldUnsetParentConfigurationAndPlatform=false" />
  </ItemGroup>
  <Target Name="PreserveChatBotCompositionInputs"
          AfterTargets="IncludeTransitiveProjectReferences"
          Condition="'$(UseHexalithProjectReferences)' != 'true'">
    <ItemGroup>
      <ProjectReference Update="@(ProjectReference)"
                        AdditionalProperties="%(ProjectReference.AdditionalProperties);HexalithBuildsPublishedToolRoot=$(_ChatBotPublishedToolRoot);Hexalith1BuildPackageProps=$(_ChatBotCatalogPackageProps);Hexalith2BuildPackageProps=$(_ChatBotCatalogPackageProps);ShouldUnsetParentConfigurationAndPlatform=false" />
    </ItemGroup>
  </Target>

  <PropertyGroup Condition="'$(EnableContainer)' == 'true'">
    <IsPackable>false</IsPackable>
    <IsPublishable>true</IsPublishable>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:11.0-alpine</ContainerBaseImage>
    <ContainerFamily>alpine</ContainerFamily>
    <ContainerImageTag Condition="'$(ContainerImageTags)' == '' and '$(ContainerImageTag)' == ''">local</ContainerImageTag>
    <ContainerUser>app</ContainerUser>
    <HexalithContainerProjectName Condition="'$(HexalithContainerProjectName)' == ''">Hexalith.ChatBot</HexalithContainerProjectName>
    <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">local</SourceRevisionId>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableContainer)' == 'true'">
    <ContainerPort Include="8080" Type="tcp" />
    <ContainerLabel Include="org.opencontainers.image.source" Value="$(RepositoryUrl)" />
    <ContainerLabel Include="org.opencontainers.image.revision" Value="$(SourceRevisionId)" />
    <ContainerLabel Include="org.opencontainers.image.version" Value="$(Version)" />
    <ContainerLabel Include="org.opencontainers.image.title" Value="$(ContainerRepository)" />
    <ContainerLabel Include="org.opencontainers.image.vendor" Value="$(Company)" />
    <ContainerLabel Include="org.opencontainers.image.licenses" Value="$(PackageLicenseExpression)" />
    <ContainerLabel Include="io.hexalith.project" Value="$(HexalithContainerProjectName)" />
    <ContainerLabel Include="io.hexalith.service" Value="$(HexalithContainerServiceName)" />
  </ItemGroup>

  <Target Name="ValidateHexalithContainerMetadata"
          BeforeTargets="PublishContainer"
          Condition="'$(EnableContainer)' == 'true'">
    <Error Condition="'$(ContainerRepository)' == ''"
           Text="ContainerRepository is required for Hexalith service container publishing." />
    <Error Condition="'$(HexalithContainerServiceName)' == ''"
           Text="HexalithContainerServiceName is required for Hexalith service container publishing." />
  </Target>
</Project>
