<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Hexalith.ChatBot.Contracts\Hexalith.ChatBot.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.ChatBot.Server\Hexalith.ChatBot.Server.csproj" />
    <ProjectReference Include="..\Hexalith.ChatBot.RecoverySandbox\Hexalith.ChatBot.RecoverySandbox.csproj"
                      IsAspireProjectResource="false"
                      AdditionalProperties="HexalithCommonsRoot=$(HexalithCommonsRoot);UseHexalithProjectReferences=$(UseHexalithProjectReferences)" />
    <!-- Tier-3 Aspire E2E: reference the AppHost as a non-resource so Projects.Hexalith_ChatBot_AppHost
         is generated for DistributedApplicationTestingBuilder. -->
    <ProjectReference Include="..\..\src\Hexalith.ChatBot.AppHost\Hexalith.ChatBot.AppHost.csproj">
      <IsAspireProjectResource>false</IsAspireProjectResource>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Include="Recovery\Datasets\recovery-baseline-v1.json"
          CopyToOutputDirectory="PreserveNewest"
          Link="Recovery\Datasets\recovery-baseline-v1.json" />
  </ItemGroup>
</Project>
