<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <DefineConstants Condition="'$(UseHexalithProjectReferences)' == 'true'">$(DefineConstants);CHATBOT_NATIVE_FOLDERS_OWNER_ALIAS</DefineConstants>
  </PropertyGroup>
  <!-- The real owner HTTP/processor fixture is a Debug source proof; package runtime qualification is separate. -->
  <ItemGroup Condition="'$(UseHexalithProjectReferences)' != 'true'">
    <Compile Remove="Adapters/Folders/FoldersNativeAttachmentTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Hexalith.ChatBot.Server\Hexalith.ChatBot.Server.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseHexalithProjectReferences)' == 'true'">
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.Contracts\Hexalith.EventStore.Contracts.csproj" />
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.DomainService\Hexalith.EventStore.DomainService.csproj" />
    <ProjectReference Include="$(HexalithCommonsRoot)\src\libraries\Hexalith.Commons.UniqueIds\Hexalith.Commons.UniqueIds.csproj" />
    <ProjectReference Include="$(HexalithFoldersRoot)\src\Hexalith.Folders.Server\Hexalith.Folders.Server.csproj" Aliases="FoldersOwner" />
    <Compile Include="$(HexalithFoldersRoot)/tests/shared/NativeContent/*.cs" Link="NativeContent/%(Filename)%(Extension)" />
    <Compile Include="$(HexalithEventStoreRoot)/tests/Hexalith.EventStore.Client.Tests/Projections/RecordingDaprClient.cs" Link="NativeContent/RecordingDaprClient.cs" />
    <ProjectReference Include="$(HexalithFoldersRoot)\src\Hexalith.Folders.Client\Hexalith.Folders.Client.csproj" />
    <ProjectReference Include="$(HexalithPartiesRoot)\src\Hexalith.Parties.Client\Hexalith.Parties.Client.csproj" />
    <ProjectReference Include="$(HexalithPartiesRoot)\src\Hexalith.Parties.Contracts\Hexalith.Parties.Contracts.csproj" />
    <ProjectReference Include="$(HexalithProjectsRoot)\src\Hexalith.Projects.Client\Hexalith.Projects.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup Condition="'$(UseHexalithProjectReferences)' != 'true'">
    <PackageReference Include="Hexalith.Commons.UniqueIds" />
    <PackageReference Include="Hexalith.EventStore.Contracts" />
    <PackageReference Include="Hexalith.EventStore.DomainService" />
    <PackageReference Include="Hexalith.Folders.Client" />
    <PackageReference Include="Hexalith.Parties.Client" />
    <PackageReference Include="Hexalith.Parties.Contracts" />
    <PackageReference Include="Hexalith.Projects.Client" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\TrustedAuthority\*.cs" Link="TrustedAuthority\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
