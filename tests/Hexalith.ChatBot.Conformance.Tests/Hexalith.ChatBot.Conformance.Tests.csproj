<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Story 1.12: shared cross-tenant leakage corpus. Embedded (not copy-to-output) so the gate cannot
         silently pass on a missing file: a build-included manifest resource is always present at runtime. -->
    <EmbeddedResource Include="..\fixtures\story-1-12-cross-tenant-leakage-corpus.json">
      <LogicalName>story-1-12-cross-tenant-leakage-corpus.json</LogicalName>
    </EmbeddedResource>
    <!-- Story 1.13: tenant-scoped evaluation scaffold. Embedded (not copy-to-output) so manifest loading
         fails closed if the resource is missing and cannot produce a vacuous green test run. -->
    <EmbeddedResource Include="..\fixtures\story-1-13-tenant-scoped-evaluation-dataset.json">
      <LogicalName>story-1-13-tenant-scoped-evaluation-dataset.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hexalith.ChatBot.Contracts\Hexalith.ChatBot.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.ChatBot.Client\Hexalith.ChatBot.Client.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.ChatBot.Cli\Hexalith.ChatBot.Cli.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.ChatBot.Mcp\Hexalith.ChatBot.Mcp.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.ChatBot.Server\Hexalith.ChatBot.Server.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.ChatBot.Testing\Hexalith.ChatBot.Testing.csproj" />
    <ProjectReference Include="..\..\src\Hexalith.ChatBot.Workers\Hexalith.ChatBot.Workers.csproj" />
    <ProjectReference Include="$(HexalithEventStoreRoot)\src\Hexalith.EventStore.Contracts\Hexalith.EventStore.Contracts.csproj" />
  </ItemGroup>
</Project>
